<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 开发工具：可以引用 Infrastructure（复用 PluginPackageValidator）与宿主项目；
         主应用不得引用宿主，这条约束只约束 App，不约束 tools/。 -->
    <ProjectReference Include="..\..\src\Tokenmetry.Plugin.Abstractions\Tokenmetry.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Tokenmetry.PluginHost\Tokenmetry.PluginHost.csproj" />
    <ProjectReference Include="..\..\src\Tokenmetry.Infrastructure\Tokenmetry.Infrastructure.csproj" />
  </ItemGroup>

  <!-- 校验器 scan 要起真实宿主子进程。ProjectReference 不保证把 runtimeconfig/deps.json
       复制到输出目录，这里与测试项目同款显式复制到输出下的 plugin-host/。 -->
  <Target Name="CopyPluginHostForValidator" AfterTargets="Build">
    <PropertyGroup>
      <_PluginHostOutputDir>$(MSBuildThisFileDirectory)..\..\src\Tokenmetry.PluginHost\bin\$(Configuration)\$(TargetFramework)</_PluginHostOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <_PluginHostArtifact Include="$(_PluginHostOutputDir)\Tokenmetry.PluginHost.dll" />
      <_PluginHostArtifact Include="$(_PluginHostOutputDir)\Tokenmetry.PluginHost.deps.json" />
      <_PluginHostArtifact Include="$(_PluginHostOutputDir)\Tokenmetry.PluginHost.runtimeconfig.json" />
      <_PluginHostArtifact Include="$(_PluginHostOutputDir)\Tokenmetry.Plugin.Abstractions.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginHostArtifact)" DestinationFolder="$(OutDir)plugin-host" SkipUnchangedFiles="true" />
  </Target>

</Project>
