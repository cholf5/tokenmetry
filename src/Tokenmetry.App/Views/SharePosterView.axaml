<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:c="using:Tokenmetry.App.Controls"
             xmlns:loc="using:Tokenmetry.App.Localization"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Views.SharePosterView"
             x:DataType="vm:SharePosterViewModel">

    <!--
        分享海报版面（总览页基底）。与总览页同源：同一批令牌、同一批图表控件、同一套信息结构，
        只有尺度不同。尺度差异集中在 .poster-* 样式里，不散落到元素上；横版在 .poster-root.land
        下整组覆盖（标题 48 / 面板 17 / 图表 250 / 环形 168）。

        两套版面的差别不只是缩放：竖版三行两列（趋势 1.45 / Agent .95；模型 / 类型 1:1；项目 / 成本 1:1），
        横版两行三列（趋势 2.1 / Agent 1 / 类型 1；模型 1 / 项目 1 / 成本 1.2）——类型环形与成本趋势
        换行，所以栅格定义与面板落位由 code-behind 按 Layout 重排（面板本体只声明一次，不复制两遍）。

        两处图表的关键差异：TrendChart.ShowPeakAnnotation（静态图没有 hover）+
        DonutChart.AnimateSweep=false（离屏渲染没有 DispatcherTimer，扫入动画会让环形是空的）。
    -->
    <UserControl.Styles>
        <!-- ── 竖版基线 ── -->
        <Style Selector="Border.poster-root">
            <Setter Property="Padding" Value="52,54,52,44"/>
        </Style>
        <Style Selector="TextBlock.poster-subtitle">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <!-- 页头品牌：托盘头部（tray-logo / tray-brand）的印刷尺度版本，同比例放大到海报的页头高度 -->
        <Style Selector="Border.poster-logo">
            <Setter Property="Width" Value="68"/>
            <Setter Property="Height" Value="68"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}"/>
        </Style>
        <Style Selector="Border.poster-logo Image">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
        </Style>
        <Style Selector="TextBlock.poster-brand">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="Border.poster-kpi">
            <Setter Property="MinHeight" Value="196"/>
            <Setter Property="Padding" Value="24,22,22,20"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="TextBlock.poster-kpi-value">
            <Setter Property="FontSize" Value="46"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-1.4"/>
        </Style>
        <Style Selector="TextBlock.poster-kpi-cap">
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="Border.poster-panel">
            <Setter Property="Padding" Value="22"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="TextBlock.poster-panel-title">
            <Setter Property="FontSize" Value="19"/>
        </Style>
        <Style Selector="Border.poster-row">
            <Setter Property="Padding" Value="0,11"/>
        </Style>
        <!-- 模型行的品牌芯片：几何沿用 SharedStyles 的 model-chip 机制（伪类 + DynamicResource），
             只把槽位从 16 放大到 20 与海报 16px 的表名同级；两层类选择器压过单层的 model-chip。 -->
        <Style Selector="Border.model-chip.poster-model-chip">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Border.model-chip.poster-model-chip Image.model-logo">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
        </Style>
        <Style Selector="Border.model-chip.poster-model-chip PathIcon.model-fallback">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
        </Style>
        <Style Selector="Border.model-chip.poster-model-chip TextBlock">
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="c|TrendChart">
            <Setter Property="Height" Value="240"/>
        </Style>
        <Style Selector="c|DonutChart">
            <Setter Property="DonutSize" Value="190"/>
            <Setter Property="RingThickness" Value="17"/>
            <Setter Property="LegendFontSize" Value="14"/>
            <Setter Property="CenterTitleFontSize" Value="28"/>
            <Setter Property="CenterSubtitleFontSize" Value="13"/>
        </Style>
        <!-- 排行表与脚注：应用内 11px 是近距离阅读的尺度，1080 宽的印刷品上会变成蚂蚁字（设计 §3.4） -->
        <Style Selector="Border.poster-panel TextBlock.table-td">
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Border.poster-panel TextBlock.table-num">
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style Selector="Border.poster-panel TextBlock.table-th">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.kpi-foot">
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Border.poster-panel TextBlock.table-empty">
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- ── 横版：同一批面板的印刷尺寸（设计 §3.3 / §3.4）── -->
        <Style Selector="Border.poster-root.land">
            <Setter Property="Padding" Value="52,46,52,42"/>
        </Style>
        <Style Selector="Border.poster-root.land Border.poster-logo">
            <Setter Property="Width" Value="58"/>
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="15"/>
        </Style>
        <Style Selector="Border.poster-root.land Border.poster-logo Image">
            <Setter Property="Width" Value="41"/>
            <Setter Property="Height" Value="41"/>
        </Style>
        <Style Selector="Border.poster-root.land TextBlock.poster-brand">
            <Setter Property="FontSize" Value="34"/>
        </Style>
        <Style Selector="Border.poster-root.land Border.poster-panel">
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="Border.poster-root.land TextBlock.poster-panel-title">
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style Selector="Border.poster-root.land c|TrendChart">
            <Setter Property="Height" Value="250"/>
        </Style>
        <Style Selector="Border.poster-root.land c|DonutChart">
            <Setter Property="DonutSize" Value="168"/>
            <Setter Property="RingThickness" Value="15"/>
            <Setter Property="LegendFontSize" Value="13"/>
            <Setter Property="CenterTitleFontSize" Value="25"/>
            <Setter Property="CenterSubtitleFontSize" Value="12"/>
        </Style>

        <!-- ── 单日托盘基底（设计 §3.1：状态栏信息窗的印刷版；固定 1080 竖版，不提供横置）── -->
        <Style Selector="Border.tray-root">
            <Setter Property="Padding" Value="44"/>
        </Style>
        <Style Selector="Border.tray-card">
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.tray-header">
            <Setter Property="Padding" Value="32,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.tray-logo">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-brand">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-0.3"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-date">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="LetterSpacing" Value="0.8"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-k">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-v">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-1"/>
            <Setter Property="Margin" Value="0,8,0,7"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-s">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <Style Selector="Border.tray-segbar">
            <Setter Property="Height" Value="18"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{DynamicResource AppMiniTrackBrush}"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style Selector="Border.tray-seg-first">
            <Setter Property="CornerRadius" Value="9,0,0,9"/>
        </Style>
        <Style Selector="Border.tray-seg-last">
            <Setter Property="CornerRadius" Value="0,9,9,0"/>
        </Style>
        <Style Selector="Border.tray-segcard">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.tray-card-h">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-card-v">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="-0.4"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-card-s">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <Style Selector="Border.tray-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,28,0,20"/>
            <Setter Property="Background" Value="{DynamicResource AppLineBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-section">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-section-meta">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <Style Selector="Border.tray-row">
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style Selector="TextBlock.tray-name">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-num">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.tray-sub">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <!-- 托盘 48px 品牌槽（信息窗的近距离尺度；伪类/令牌机制仍走 SharedStyles 的 agent-chip / model-chip） -->
        <Style Selector="Border.tray-chip">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.tray-chip Image.agent-logo, Border.tray-chip Image.model-logo">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style Selector="Border.tray-chip PathIcon.model-fallback">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>
        <Style Selector="Border.tray-chip TextBlock">
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </UserControl.Styles>

    <ThemeVariantScope x:Name="ThemeScope">
      <Panel>
        <!-- 宽度由 code-behind 按版式给（竖版 1080 / 横版 1800），导出按它 2× 光栅化 -->
        <Border x:Name="PosterRoot"
                Classes="poster-root"
                IsVisible="{Binding !IsSingleDay}"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="{DynamicResource AppBackgroundBrush}">
            <StackPanel Spacing="14">

                <!-- 页头：图标在左，字标 + 日期范围在右同一个左边界上（两行共用一个起排点）。
                     日期不右对齐：海报上没有任何元素从右边起排，孤零零一条挂在右上角就没了参照系。
                     同一排版理由也适用于不写页标题「总览」——那是应用内的页面名。 -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,12">
                    <Border Grid.Column="0" Classes="poster-logo" VerticalAlignment="Center">
                        <Image Source="avares://Tokenmetry.App/Assets/app-icon.png"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="9" VerticalAlignment="Center">
                        <TextBlock Classes="poster-brand" Text="Tokenmetry"/>
                        <TextBlock Classes="poster-subtitle" Text="{Binding RangeText}"/>
                    </StackPanel>
                </Grid>

                <!-- 四张 KPI（阴影由 code-behind 按令牌给，见 ApplyPanelShadows） -->
                <Grid x:Name="KpiGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                    <Border Grid.Column="0" Classes="kpi poster-kpi">
                        <StackPanel>
                            <TextBlock Classes="kpi-top poster-kpi-cap" Text="{Binding KpiTotalTokens, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Classes="kpi-value poster-kpi-value" Text="{Binding TotalTokensText}"/>
                            <!-- 脚注不能说"缓存读取/输入相关"：那是第四张卡的口径，重复且挂错卡 -->
                            <TextBlock Classes="kpi-foot" Text="{Binding KpiFootAcrossAgents, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="kpi poster-kpi">
                        <StackPanel>
                            <TextBlock Classes="kpi-top poster-kpi-cap" Text="{Binding KpiEstimatedCost, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Classes="kpi-value poster-kpi-value" Text="{Binding CostText}"/>
                            <TextBlock Classes="kpi-foot" Text="{Binding KpiFootPriceEstimate, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="kpi poster-kpi">
                        <StackPanel>
                            <TextBlock Classes="kpi-top poster-kpi-cap" Text="{Binding KpiSessions, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Classes="kpi-value poster-kpi-value" Text="{Binding SessionsText}"/>
                            <TextBlock Classes="kpi-foot" Text="{Binding KpiFootAcrossAgents, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="kpi poster-kpi">
                        <StackPanel>
                            <TextBlock Classes="kpi-top poster-kpi-cap" Text="{Binding KpiCacheShare, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Classes="kpi-value poster-kpi-value" Text="{Binding CacheShareText}"/>
                            <TextBlock Classes="kpi-foot" Text="{Binding KpiFootCacheOfInput, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 六个面板：每行一个栅格（横/竖版的行内比例不同，见 ApplyLayout），面板本体只声明一次 -->
                <StackPanel x:Name="PanelGrid" Spacing="14">

                    <!-- 竖版三行（固定两列） -->
                    <Grid x:Name="PortraitRow1" ColumnDefinitions="1.45*,0.95*" ColumnSpacing="14">
                        <!-- 趋势 -->
                        <Border x:Name="TrendPanel" Grid.Column="0" Classes="panel poster-panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="panel-title poster-panel-title"
                                           Text="{Binding PanelTrend, Source={x:Static loc:Translations.Instance}}"/>
                                <c:TrendChart x:Name="TrendChartControl"
                                              Mode="DailyTokens"
                                              DailyPoints="{Binding Daily}"
                                              ChartFontScale="1.9"
                                              ShowPeakAnnotation="True"/>
                            </StackPanel>
                        </Border>

                        <!-- Agent 环形 -->
                        <Border x:Name="AgentPanel" Grid.Column="1" Classes="panel poster-panel">
                            <StackPanel Spacing="13">
                                <TextBlock Classes="panel-title poster-panel-title"
                                           Text="{Binding PanelAgentDonut, Source={x:Static loc:Translations.Instance}}"/>
                                <c:DonutChart Segments="{Binding AgentSegments}"
                                              AnimateSweep="False"
                                              CenterTitle="{Binding TotalTokensText}"
                                              CenterSubtitle="{Binding DonutCenterSubtitle, Source={x:Static loc:Translations.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="PortraitRow2" ColumnDefinitions="*,*" ColumnSpacing="14">
                        <!-- 模型分布 -->
                        <Border x:Name="ModelPanel" Grid.Column="0" Classes="panel poster-panel">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="panel-title poster-panel-title"
                                           Text="{Binding PanelModelDistribution, Source={x:Static loc:Translations.Instance}}"/>
                                <Grid ColumnDefinitions="*,92,62" ColumnSpacing="10" Margin="0,0,0,2">
                                    <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding ThModel, Source={x:Static loc:Translations.Instance}}"/>
                                    <TextBlock Grid.Column="1" Classes="table-th" TextAlignment="Right" Text="{Binding ThTokenCount, Source={x:Static loc:Translations.Instance}}"/>
                                    <TextBlock Grid.Column="2" Classes="table-th" TextAlignment="Right" Text="{Binding ThShare, Source={x:Static loc:Translations.Instance}}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ModelRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SharePosterRow">
                                            <Border Classes="poster-row" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0">
                                                <Grid ColumnDefinitions="*,92,62" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                            <!-- 模型行：内置厂商 logo（与总览页同一条 ModelChip 链；未知/无标厂商落
                                                                 Φ 字形或问号兜底，不伪造品牌色块） -->
                                                            <Border Grid.Column="0" Classes="model-chip poster-model-chip"
                                                                    c:ModelChip.Avatar="{Binding Avatar}"
                                                                    IsVisible="{Binding HasIcon}"
                                                                    ToolTip.Tip="{Binding Name}"
                                                                    VerticalAlignment="Center">
                                                                <Panel>
                                                                    <TextBlock Text="{Binding Avatar.GlyphText}"/>
                                                                    <Image Classes="model-logo"/>
                                                                    <Image Classes="model-avatar"
                                                                           Source="{Binding Avatar.ImageDataUri, Converter={x:Static c:DataUriImageConverter.Instance}}"/>
                                                                    <PathIcon Classes="app-icon model-fallback"
                                                                              Data="{StaticResource AppIconCircleHelp}"/>
                                                                </Panel>
                                                            </Border>
                                                            <!-- 名字列必须是 * 约束的 Grid：横向 StackPanel 以无限宽测量子级，
                                                                 TextTrimming 永远不生效，长名字会压到 Token/占比列上 -->
                                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Classes="table-td" Text="{Binding Name}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           IsVisible="{Binding !HasMaskedName}"/>
                                                                <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasMaskedName}">
                                                                    <TextBlock Grid.Column="0" Classes="table-td" Text="{Binding Name}"/>
                                                                    <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding MaskedName}"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Effect>
                                                                            <BlurEffect Radius="5.5"/>
                                                                        </TextBlock.Effect>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                        <ProgressBar Classes="mini" Value="{Binding BarValue}" Height="5"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="table-num" Text="{Binding TokensText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Classes="table-num" Text="{Binding ShareText}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}" IsVisible="{Binding !HasModels}"/>
                            </StackPanel>
                        </Border>

                        <!-- Token 类型构成 -->
                        <Border x:Name="TypePanel" Grid.Column="1" Classes="panel poster-panel">
                            <StackPanel Spacing="13">
                                <TextBlock Classes="panel-title poster-panel-title"
                                           Text="{Binding PanelTypeDonut, Source={x:Static loc:Translations.Instance}}"/>
                                <c:DonutChart Segments="{Binding TypeSegments}"
                                              AnimateSweep="False"
                                              CenterTitle="{Binding CacheShareText}"
                                              CenterSubtitle="{Binding DonutCenterSubtitle, Source={x:Static loc:Translations.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="PortraitRow3" ColumnDefinitions="*,*" ColumnSpacing="14">
                        <!-- 项目排行 -->
                        <Border x:Name="ProjectPanel" Grid.Column="0" Classes="panel poster-panel">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="panel-title poster-panel-title"
                                           Text="{Binding PanelProjectRanking, Source={x:Static loc:Translations.Instance}}"/>
                                <Grid ColumnDefinitions="*,92,62" ColumnSpacing="10" Margin="0,0,0,2">
                                    <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding LabelProjectDir, Source={x:Static loc:Translations.Instance}}"/>
                                    <TextBlock Grid.Column="1" Classes="table-th" TextAlignment="Right" Text="{Binding ThTokenCount, Source={x:Static loc:Translations.Instance}}"/>
                                    <TextBlock Grid.Column="2" Classes="table-th" TextAlignment="Right" Text="{Binding ThShare, Source={x:Static loc:Translations.Instance}}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ProjectRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SharePosterRow">
                                            <Border Classes="poster-row" BorderBrush="{DynamicResource AppLineBrush}" BorderThickness="0,1,0,0">
                                                <Grid ColumnDefinitions="*,92,62" ColumnSpacing="10">
                                                    <StackPanel Grid.Column="0" Spacing="5">
                                                        <Grid VerticalAlignment="Center">
                                                            <TextBlock Classes="table-td" Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding !HasMaskedName}"/>
                                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding HasMaskedName}">
                                                                <TextBlock Grid.Column="0" Classes="table-td" Text="{Binding Name}"/>
                                                                <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding MaskedName}"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Effect>
                                                                        <BlurEffect Radius="5.5"/>
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Grid>
                                                        <ProgressBar Classes="mini" Value="{Binding BarValue}" Height="5"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Classes="table-num" Text="{Binding TokensText}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Classes="table-num" Text="{Binding ShareText}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}" IsVisible="{Binding !HasProjects}"/>
                            </StackPanel>
                        </Border>

                        <!-- 成本趋势 -->
                        <Border x:Name="CostPanel" Grid.Column="1" Classes="panel poster-panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="panel-title poster-panel-title"
                                           Text="{Binding PanelCostTrend, Source={x:Static loc:Translations.Instance}}"/>
                                <c:TrendChart x:Name="CostChartControl"
                                              Mode="CostUsd"
                                              DailyPoints="{Binding Daily}"
                                              ChartFontScale="1.9"
                                              ShowPeakAnnotation="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 横版两行（固定三列）：与上面共用同一批面板，切换版式时移动子级。
                         Grid 的 ColumnDefinitions 数量在运行期变化会踩 Avalonia 的测量缓存
                         （MeasureCellsGroup 索引越界），所以两种版式各带一套固定定义的容器。 -->
                    <Grid x:Name="LandscapeRow1" ColumnDefinitions="2.1*,1*,1*" ColumnSpacing="14" IsVisible="False"/>
                    <Grid x:Name="LandscapeRow2" ColumnDefinitions="*,*,1.2*" ColumnSpacing="14" IsVisible="False"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══ 单日托盘基底（设计 §3.1：状态栏信息窗的印刷版）══
             头部 + 三格 KPI + 构成条 + 构成三卡 + 主要 Agent + 模型用量。
             刻意不画信息窗的「记录中」状态点与「单日峰值」徽标：静态海报上的运行状态是假的，
             峰值也不一定当天就是峰值——版式沿用，声称的事实只留数据里有的。 -->
        <Border x:Name="TrayRoot"
                Width="1080"
                Classes="poster-root tray-root"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Background="{DynamicResource AppBackgroundBrush}"
                IsVisible="{Binding IsSingleDay}">
            <Border x:Name="TrayCard" Classes="panel tray-card">
                <StackPanel>

                    <!-- 头部：品牌 + 日期 -->
                    <Border Classes="tray-header" Height="96">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="15">
                            <Border Grid.Column="0" Classes="tray-logo" VerticalAlignment="Center">
                                <Image Source="avares://Tokenmetry.App/Assets/app-icon.png"
                                       Width="38" Height="38"/>
                            </Border>
                            <TextBlock Grid.Column="1" Classes="tray-brand" Text="Tokenmetry"
                                       VerticalAlignment="Center" Margin="9,0,0,0"/>
                            <TextBlock Grid.Column="3" Classes="tray-date" Text="{Binding SingleDayDateText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="32">

                        <!-- 三格 KPI -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="22">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="tray-k" Text="{Binding KpiTotalTokens, Source={x:Static loc:Translations.Instance}}"/>
                                <TextBlock Classes="tray-v table-num" Text="{Binding TotalTokensText}"/>
                                <TextBlock Classes="tray-s table-num" Text="{Binding TotalTokensRawText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Classes="tray-k" Text="{Binding KpiEstimatedCost, Source={x:Static loc:Translations.Instance}}"/>
                                <TextBlock Classes="tray-v table-num" Text="{Binding CostText}"/>
                                <TextBlock Classes="tray-s" Text="{Binding KpiFootPriceEstimate, Source={x:Static loc:Translations.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="tray-k" Text="{Binding KpiCacheShare, Source={x:Static loc:Translations.Instance}}"/>
                                <TextBlock Classes="tray-v table-num" Text="{Binding CacheShareText}"/>
                                <TextBlock Classes="tray-s" Text="{Binding KpiFootCacheOfInput, Source={x:Static loc:Translations.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 构成条（列宽由 code-behind 按三段 token 比例给） -->
                        <Border Classes="tray-segbar" Margin="0,30,0,16">
                            <Grid x:Name="TrayTypeBar" ColumnDefinitions="*,*,*">
                                <Border Grid.Column="0" Classes="tray-seg-first"
                                        Background="{DynamicResource AppTokenTypeInputBrush}"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource AppTokenTypeOutputBrush}"/>
                                <Border Grid.Column="2" Classes="tray-seg-last"
                                        Background="{DynamicResource AppTokenTypeCacheBrush}"/>
                            </Grid>
                        </Border>

                        <!-- 构成三卡（三段之和的分母，与环形同口径） -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding HasTrayTypes}">
                            <Border Grid.Column="0" Classes="tray-segcard">
                                <StackPanel>
                                    <TextBlock Classes="tray-card-h" Text="{Binding TrayTypes[0].Label}"/>
                                    <TextBlock Classes="tray-card-v table-num" Text="{Binding TrayTypes[0].ValueText}"/>
                                    <TextBlock Classes="tray-card-s table-num" Text="{Binding TrayTypes[0].ShareText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="tray-segcard">
                                <StackPanel>
                                    <TextBlock Classes="tray-card-h" Text="{Binding TrayTypes[1].Label}"/>
                                    <TextBlock Classes="tray-card-v table-num" Text="{Binding TrayTypes[1].ValueText}"/>
                                    <TextBlock Classes="tray-card-s table-num" Text="{Binding TrayTypes[1].ShareText}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="tray-segcard">
                                <StackPanel>
                                    <TextBlock Classes="tray-card-h" Text="{Binding TrayTypes[2].Label}"/>
                                    <TextBlock Classes="tray-card-v table-num" Text="{Binding TrayTypes[2].ValueText}"/>
                                    <TextBlock Classes="tray-card-s table-num" Text="{Binding TrayTypes[2].ShareText}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Classes="tray-divider"/>

                        <!-- 主要 Agent（Top4） -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="tray-section"
                                       Text="{Binding SharePosterTrayAgents, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Grid.Column="1" Classes="tray-section-meta"
                                       Text="{Binding SharePosterTrayByTokens, Source={x:Static loc:Translations.Instance}}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TrayAgentRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SharePosterTrayRow">
                                    <Border Classes="tray-row">
                                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                                            <Border Grid.Column="0" Classes="agent-chip agent-chip-lg tray-chip"
                                                    c:AgentChip.Logo="{Binding AgentVendor}"
                                                    IsVisible="{Binding IsAgent}"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="{Binding AgentGlyph}"/>
                                                    <Image Classes="agent-logo"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock Classes="tray-name" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Classes="mini" Height="5" Value="{Binding BarValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Classes="tray-num table-num" Text="{Binding TokensText}" HorizontalAlignment="Right"/>
                                                <TextBlock Classes="tray-sub table-num" Text="{Binding CostText}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}"
                                   IsVisible="{Binding !HasTrayAgents}"/>

                        <Border Classes="tray-divider"/>

                        <!-- 模型用量（Top3） -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Classes="tray-section"
                                       Text="{Binding SharePosterTrayModels, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Grid.Column="1" Classes="tray-section-meta"
                                       Text="{Binding SharePosterTrayByTokens, Source={x:Static loc:Translations.Instance}}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TrayModelRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SharePosterTrayRow">
                                    <Border Classes="tray-row">
                                        <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="16">
                                            <Border Grid.Column="0" Classes="model-chip model-chip-lg tray-chip"
                                                    c:ModelChip.Avatar="{Binding Avatar}"
                                                    IsVisible="{Binding HasModelIcon}"
                                                    VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="{Binding Avatar.GlyphText}"/>
                                                    <Image Classes="model-logo"/>
                                                    <Image Classes="model-avatar"
                                                           Source="{Binding Avatar.ImageDataUri, Converter={x:Static c:DataUriImageConverter.Instance}}"/>
                                                    <PathIcon Classes="app-icon model-fallback"
                                                              Data="{StaticResource AppIconCircleHelp}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                                                <TextBlock Classes="tray-name" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Classes="mini" Height="5" Value="{Binding BarValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Classes="tray-num table-num" Text="{Binding TokensText}" HorizontalAlignment="Right"/>
                                                <TextBlock Classes="tray-sub table-num" Text="{Binding CostText}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}"
                                   IsVisible="{Binding !HasTrayModels}"/>

                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
      </Panel>
    </ThemeVariantScope>
</UserControl>
