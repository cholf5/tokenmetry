<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Tokenmetry.App.ViewModels"
        xmlns:v="using:Tokenmetry.App.Views"
        xmlns:loc="using:Tokenmetry.App.Localization"
        mc:Ignorable="d"
        x:Class="Tokenmetry.App.Views.SharePosterDialog"
        x:DataType="vm:SharePosterDialogViewModel"
        Title="{Binding SharePosterTitle, Source={x:Static loc:Translations.Instance}}"
        Width="1100" Height="920"
        WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <!-- 分段选项（P5 定下的 filter-chip 视觉）：RadioButton 去掉圆点、改成胶囊按钮，
             选中走 chip 令牌；ComboBox 在这样只有 2–3 个互斥短选项的场景里多一层弹层。 -->
        <Style Selector="RadioButton.seg-chip">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg-chip:checked">
            <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppChipTextBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppChipTextBrush}"/>
        </Style>
        <Style Selector="RadioButton.seg-chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AppChipTextBrush}"/>
        </Style>
        <Style Selector="RadioButton.seg-chip:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- 选项：四组「标签 + 芯片」在 WrapPanel 里自动换行——样式组扩到 5 个芯片后，
             定宽窗口装不下单行八列（德/法语长标签尤甚），分组换行让任何语言都不裁切。 -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,16">
            <TextBlock Classes="page-title" Text="{Binding SharePosterTitle, Source={x:Static loc:Translations.Instance}}"/>
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,26,8">
                    <TextBlock Classes="setting-label" VerticalAlignment="Center"
                               Text="{Binding SharePosterStyle, Source={x:Static loc:Translations.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding StyleOptions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SharePosterOption">
                                <RadioButton Classes="seg-chip" GroupName="poster-style"
                                             Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,26,8">
                    <TextBlock Classes="setting-label" VerticalAlignment="Center"
                               Text="{Binding SharePosterLayout, Source={x:Static loc:Translations.Instance}}"/>
                    <ItemsControl x:Name="LayoutOptionsHost" ItemsSource="{Binding LayoutOptions}"
                                  IsEnabled="{Binding CanChooseLayout}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SharePosterOption">
                                <RadioButton Classes="seg-chip" GroupName="poster-layout"
                                             Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,26,8">
                    <TextBlock Classes="setting-label" VerticalAlignment="Center"
                               Text="{Binding SharePosterTheme, Source={x:Static loc:Translations.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding ThemeOptions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SharePosterOption">
                                <RadioButton Classes="seg-chip" GroupName="poster-theme"
                                             Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBlock Classes="setting-label" VerticalAlignment="Center"
                               Text="{Binding SharePosterMask, Source={x:Static loc:Translations.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding MaskOptions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SharePosterOption">
                                <RadioButton Classes="seg-chip" GroupName="poster-mask"
                                             Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </WrapPanel>
            <!-- 样式锁版式：说明原因，不静默禁用 -->
            <TextBlock x:Name="LayoutNotice" Classes="setting-hint" TextWrapping="Wrap"
                       Text="{Binding LayoutNoticeText}"
                       IsVisible="{Binding ShowLayoutNotice}"/>
        </StackPanel>

        <!-- 预览：默认整体缩放到预览区全貌（fit 由代码后置算），Ctrl/⌘+滚轮放大、双击复位。
             缩放本体是 LayoutTransformControl——预览是活视图不是位图，任何倍率都矢量重排不糊。
             Grid 垫层承担居中：ScrollViewer 的 ContentPresenter 会把比视口小的内容拉伸铺满，
             少这一层海报会被撑变形；Grid 内居中让缩放节点永远按自己想要的尺寸排布。 -->
        <Border Grid.Row="1" Classes="panel" Padding="8">
            <ScrollViewer x:Name="PreviewScroll"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <LayoutTransformControl x:Name="PreviewHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <v:SharePosterView x:Name="PreviewView" DataContext="{Binding Preview}"/>
                    </LayoutTransformControl>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 导出 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Grid.Column="0" Classes="setting-hint" VerticalAlignment="Center"/>
            <Button x:Name="CopyButton" Grid.Column="1" Classes="app-btn primary"
                    Content="{Binding SharePosterCopy, Source={x:Static loc:Translations.Instance}}" Click="OnCopyClick"/>
            <Button x:Name="SaveButton" Grid.Column="2" Classes="app-btn"
                    Content="{Binding SharePosterSave, Source={x:Static loc:Translations.Instance}}" Click="OnSaveClick"/>
        </Grid>
    </Grid>
</Window>
