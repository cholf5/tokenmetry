<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:c="using:Tokenmetry.App.Controls"
             xmlns:loc="using:Tokenmetry.App.Localization"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Views.SessionsView"
             x:DataType="vm:SessionsViewModel">

    <!--
        D-008 会话明细页（原型 #page-sessions）：页头 + 明细面板（搜索 + 排序在页面内；
        Agent 复选 / 模型 / 项目筛选在右栏快速筛选，经 VM 提交事件驱动本页重查）+
        明细表（ListBox 虚拟化：页面根 Grid 用 * 行约束视口，万行 fixture 只实例化视口内行；
        行配方用共享 data-table 类，Q-002 收编）+
        计数条（显示 X / Y 条）与「加载更多」（I-029 分页契约）。
        明细行观感对齐原型 .sessiontable + .table（table-th/td 令牌、行顶分隔线、Agent 软色底图标）。
        加载失败语义（审查修复轮）：错误面板出现时隐藏空态与计数条，已加载行保留不清。
    -->

    <!-- Q-006：PageHost 外边距归零后本页自补（无页面级滚动面——列表滚动条贴卡内缘属有意设计）；
         头 22,22,22,0 / 面板 22,0,22,0 / 错误面板 22,0,22,30 = 原 PageHost 22,22,22,30 的逐边拆分 -->
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="13">

        <!-- 页头（原型 .pagehead）+ 加载失败诚实错误态 -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="22,22,22,0">
            <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
            <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
        </StackPanel>

        <!-- ═══ 明细面板（原型 .panel.widepanel）═══ -->
        <Border Grid.Row="1" Classes="panel" Margin="22,0,22,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

                <!-- detailhead：搜索 + 排序（Agent 复选/模型/项目在右栏快速筛选，D-008 定案）。
                     placeholder 口径诚实：facts 无标题字段，搜索命中会话标识/项目/模型/Agent（I-029）。 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,150" ColumnSpacing="10">
                    <TextBox Grid.Column="0"
                             PlaceholderText="{Binding SearchPlaceholder, Source={x:Static loc:Translations.Instance}}"
                             Text="{Binding SearchText, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="1"
                              MinWidth="140"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionSortOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- 表头（原型 .sessiontable thead；列宽与行模板一致。
                     文本列星宽、数字列定宽：最小窗口（主列 456px）下会话列仍保留可读宽度，
                     文本经 TextTrimming 截断，不把最后列挤出面板） -->
                <Grid Grid.Row="1" ColumnDefinitions="2*,60,1.2*,72,58,68" ColumnSpacing="8" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding ThSession, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="1" Classes="table-th" Text="{Binding TopbarAgent, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="2" Classes="table-th" Text="{Binding LabelModels, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="3" Classes="table-th" TextAlignment="Right" Text="Token"/>
                    <TextBlock Grid.Column="4" Classes="table-th" TextAlignment="Right" Text="{Binding KpiEstimatedCost, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="5" Classes="table-th" Text="{Binding ThLastActivity, Source={x:Static loc:Translations.Instance}}"/>
                </Grid>

                <!-- 明细行（ListBox 虚拟化；SelectedSession = 行点击占位下钻） -->
                <ListBox Grid.Row="2"
                         Classes="data-table"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionRowViewModel">
                            <Border BorderBrush="{DynamicResource AppLineBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,8,0,2">
                                <Grid ColumnDefinitions="2*,60,1.2*,72,58,68" ColumnSpacing="8">
                                    <!-- 会话（项目主文本 + 会话标识副文本；tooltip 挂完整 SessionId 可复制） -->
                                    <StackPanel Grid.Column="0" Spacing="3" ToolTip.Tip="{Binding SessionIdText}">
                                        <TextBlock Classes="table-td" Text="{Binding TitleText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Classes="page-subtitle" Text="{Binding SessionIdText}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- Agent（行内品牌 logo + 名，对齐模型列的 model-chip；
                                         logo 经 AgentChip.Logo 附加属性 → agent-* 伪类 DynamicResource
                                         取 AppAgentLogo*，单色标按 ActualThemeVariant 明暗翻黑白） -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Classes="agent-chip" c:AgentChip.Logo="{Binding LogoVendor}">
                                            <Panel>
                                                <TextBlock Text="{Binding IconGlyph}"/>
                                                <Image Classes="agent-logo"/>
                                            </Panel>
                                        </Border>
                                        <TextBlock Classes="table-td" Text="{Binding Agent}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="table-td" Text="{Binding ModelText}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Classes="table-num" Text="{Binding TokensText}"
                                               VerticalAlignment="Center"/>
                                    <!-- 估算成本四态：未知成本呈「未知」，绝不折 0 -->
                                    <TextBlock Grid.Column="4" Classes="table-num" Text="{Binding CostText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Classes="table-td" Text="{Binding LastActivityText}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态（无行且无错误：过滤后无匹配 / 数据源为空，诚实呈现；错误态下隐藏，见 ShowEmptyState） -->
                <TextBlock Grid.Row="2" Classes="table-empty" Text="{Binding NoMatchingSessions, Source={x:Static loc:Translations.Instance}}"
                           IsVisible="{Binding ShowEmptyState}"
                           VerticalAlignment="Top"/>

                <!-- 计数条 + 加载更多（原型 #sessionCount 文案去掉"示例"；错误态下隐藏避免与错误面板矛盾） -->
                <StackPanel Grid.Row="3" Spacing="8" IsVisible="{Binding ShowCountLine}">
                    <Button Classes="link-btn"
                            Content="{Binding LoadMore, Source={x:Static loc:Translations.Instance}}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding HasMore}"
                            Command="{Binding LoadMoreCommand}"/>
                    <TextBlock Classes="page-subtitle" Text="{Binding CountText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 加载失败（诚实错误态；已加载行保留，筛选/搜索再变化自动重试） -->
        <Border Grid.Row="2" Classes="panel" Padding="13" Margin="22,0,22,30" IsVisible="{Binding HasLoadError}">
            <TextBlock Classes="page-subtitle" Text="{Binding LoadError}"/>
        </Border>
    </Grid>
</UserControl>
