<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Tokenmetry.App.ViewModels"
        xmlns:c="using:Tokenmetry.App.Controls"
        xmlns:views="using:Tokenmetry.App.Views"
        xmlns:svc="using:Tokenmetry.App.Services"
        xmlns:loc="using:Tokenmetry.App.Localization"
        mc:Ignorable="d"
        x:Class="Tokenmetry.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">

    <!--
        D-003 两栏应用外壳（原型 .app/.topbar/.shell/.sidebar；原 .sessions-panel 已删）：
        顶部栏 = 全局筛选四维（时间范围 + Agent + Model + Project）+ 数据状态 + 设置入口；
        左侧栏 = 品牌 + 9 项导航；中间 = 页面路由（ContentControl + DataTemplates）。
        2026-10-18 右栏撤除：最近会话/快速筛选定案见 docs/plans/2026-10-18-right-rail-removal-design.md；
        筛选全部并入顶栏四维（FilterStateService）。
        窗口 chrome 沿用系统边框（2026-10-12 卡内决策，不复刻原型 mac 红绿灯）；
        D-026 只让 Windows 原生 caption 跟随明暗（DWM 沉浸式深色），不自绘标题栏。
        最小尺寸 960×640：184 + ≥776 主内容两栏不破（原三栏 276 列归还主内容）。
    -->

    <Window.Styles>
        <!-- A-12 顶栏状态灯三态（默认绿 / warn 橙 / error 红），Classes 条件绑定见状态点元素 -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource AppAccentGreenBrush}"/>
        </Style>
        <Style Selector="Ellipse.status-dot.warn">
            <Setter Property="Fill" Value="{DynamicResource AppAccentOrangeBrush}"/>
            <!-- 异常态呼吸（motion design §7）：仅 warn/error 循环吸引注意；正常绿常亮 -->
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.status-dot.error">
            <Setter Property="Fill" Value="{DynamicResource AppAccentRedBrush}"/>
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.4"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- 侧栏导航列表（原型 .nav）：条目 8px 圆角、悬停/选中走 D-003 外壳令牌；
             静息态用 AppNavRestBackgroundBrush（同 hover RGB 的 0 alpha）而非 Transparent——
             BrushTransition 在透明白与原色之间插值会闪白 -->
        <Style Selector="ListBox.nav-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource AppNavRestBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppNavForegroundBrush}"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <!-- hover 渐变（motion design §6）：底色/前景 120ms 过渡，不跳变；
                 底色起止两端同 RGB，过渡只走 alpha（见上方静息态令牌说明） -->
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppNavActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}"/>
        </Style>
        <!-- 选中指示条（原型 .nav button.active 的 inset 2px）：条目模板内常驻 2px 占位，
             仅选中态着色（颜色走 AppNavActiveIndicatorBrush），图标不因选中而位移 -->
        <Style Selector="ListBox.nav-list ListBoxItem Border.nav-indicator">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:selected Border.nav-indicator">
            <Setter Property="Background" Value="{DynamicResource AppNavActiveIndicatorBrush}"/>
        </Style>

        <!-- 顶部栏图标按钮（原型 .iconbtn）：内容为矢量图标（Path.app-icon，描边色见下方状态样式） -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <!-- hover 渐变（motion design §6） -->
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- 矢量图标颜色走 Foreground（模板 TemplateBinding）：侧栏导航未选中/选中、
             禁用态直接随祖先 Foreground 继承生效，无需逐态样式；顶栏按钮给 AppTextBrush
             显式基线（Semi Button 自身 Foreground 与文本令牌不同源），禁用态盖 muted -->
        <Style Selector="Button.icon-btn PathIcon.app-icon">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="Button.icon-btn:disabled PathIcon.app-icon">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>

        <!-- 刷新进行中（motion design §6）：LoaderCircle 弧形矢量手柄式旋转（复用初始化菊花的
             矢量旋转手法；Path 的几何包围盒为整圆、旋转中心即墨迹中心，无 overlay-spinner
             注释里的字形盒偏移问题；结束随 IsVisible 隐没即停） -->
        <Style Selector="PathIcon.refresh-running-glyph">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 顶部栏筛选标签（.select 语义的静态说明文字） -->
        <Style Selector="TextBlock.topbar-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 首次初始化遮罩（IsInitializingData）：全窗半透明 scrim + 中央卡片（旋转虚线圆菊花）
             ——首次使用库内无数据，启动首轮采集扫描期间给醒目的"正在初始化"反馈，
             覆盖层拦截命中测试，初始化期间不与底层页面交互 -->
        <Style Selector="Border.overlay-card">
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="40,32"/>
        </Style>
        <!-- 矢量菊花：Ellipse 虚线圆绕自身几何中心旋转。不用字形旋转——文本旋转中心是布局盒
             中心（基线 + 行高决定），与字形墨迹中心不重合（◌ U+25CC 主字体不覆盖、由系统回退
             字体渲染，偏差更大），墨迹绕错误原点公转，视觉上转动不匀、忽上忽下；
             矢量圆的旋转中心与墨迹中心恒等，转动均匀。
             2026-10-24：同类字形回退问题已整体收敛——界面图标全部矢量化为 AppIcon*（Icons.axaml）。 -->
        <Style Selector="Ellipse.overlay-spinner">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Stroke" Value="{DynamicResource AppLinkBrush}"/>
            <Setter Property="StrokeThickness" Value="3"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeDashArray" Value="0.01,3.2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.overlay-title">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.overlay-subtitle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="330"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
    </Window.Styles>

    <!-- D-003 页面路由：CurrentPage（页面 VM）→ 视图。Q-002：旧视图（Dashboard/Reports/
         ModelBreakdown/TrendSpike/EmptyState）已删除，S-004 起为 9 个真实页 + 未知兜底占位；
         StylePreviewView 为 dev-only 预览宿主（无导航入口，TOKENMETRY_PREVIEW_WINDOW=1 才打开）。 -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:OverviewViewModel">
            <views:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SessionsViewModel">
            <views:SessionsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:AgentsViewModel">
            <views:AgentsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ModelsViewModel">
            <views:ModelsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:TimeViewModel">
            <views:TimeAnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CostViewModel">
            <views:CostAnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PagePlaceholderViewModel">
            <views:PagePlaceholderView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DataPricingViewModel">
            <views:DataPricingView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="52,*">
        <!-- ═══ 顶部栏（.topbar：52px，底边 1px 描边）═══ -->
        <Border Grid.Row="0"
                x:Name="TopBar"
                Background="{DynamicResource AppTopbarBackgroundBrush}"
                BorderBrush="{DynamicResource AppLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="18,0" VerticalAlignment="Center">
                <!-- 全局时间范围（D-020：档名按钮 + 弹层 = 档位清单/我的预设/自定义日期；
                     取代 ComboBox + 自定义档 inline DatePicker——顶栏不再随档位切换 reflow） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="topbar-label" Text="{Binding TopbarTimeRange, Source={x:Static loc:Translations.Instance}}"/>
                    <c:TimeRangePicker DataContext="{Binding TimePicker}"/>
                </StackPanel>
                <!-- 全局 Agent 筛选（选项清单 = AgentCatalogService 真实数据，D-008 接线；初始仅"所有 Agent"） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                    <TextBlock Classes="topbar-label" Text="{Binding TopbarAgent, Source={x:Static loc:Translations.Instance}}"/>
                    <ComboBox MinWidth="140"
                              ItemsSource="{Binding Filters.AgentOptions}"
                              SelectedItem="{Binding Filters.Agent, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:AgentOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- 全局模型筛选（选项 = AgentCatalogService 模型维度缓存，查询值 = 规范名） -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                    <TextBlock Classes="topbar-label" Text="{Binding TopbarModel, Source={x:Static loc:Translations.Instance}}"/>
                    <ComboBox MinWidth="124"
                              ItemsSource="{Binding Filters.ModelOptions}"
                              SelectedItem="{Binding Filters.Model, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:ModelFilterOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- 全局项目筛选（选项 = 项目维度缓存，查询值 = 原始路径） -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                    <TextBlock Classes="topbar-label" Text="{Binding TopbarProject, Source={x:Static loc:Translations.Instance}}"/>
                    <ComboBox MinWidth="130"
                              ItemsSource="{Binding Filters.ProjectOptions}"
                              SelectedItem="{Binding Filters.Project, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:ProjectFilterOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- 数据状态（轻量实现：就绪 + 最近刷新时间；真实状态接线 TODO 见 MainWindowViewModel） -->
                <Border Grid.Column="5"
                        Background="{DynamicResource AppPanelAltBrush}"
                        BorderBrush="{DynamicResource AppLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,7"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- A-12 状态灯：默认绿（就绪/刷新中），无数据橙、刷新失败红——
                             由 DashboardViewModel.Status 每轮回写（BackgroundRefreshWiring → NoteDataSourceStatus） -->
                        <Ellipse Width="7" Height="7" Classes="status-dot"
                                 Classes.warn="{Binding IsDataSourceWarned}"
                                 Classes.error="{Binding IsDataSourceError}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DataStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
                <!-- 手动刷新（⟳）：经 BackgroundRefreshService 单飞槽触发一轮采集刷新（与定时器 /
                     托盘「立即刷新」/ 数据与计价页重扫同一合并语义）；扫描进行中按钮禁用并切换为
                     进行中字形，轮次结束的状态/时间戳/页面重查回写由 BackgroundRefreshWiring 统一完成 -->
                <Button Grid.Column="6"
                        Classes="icon-btn"
                        Command="{Binding RefreshDataCommand}"
                        IsEnabled="{Binding !RefreshDataCommand.IsRunning}"
                        ToolTip.Tip="{Binding TooltipRefreshNow, Source={x:Static loc:Translations.Instance}}">
                    <Panel>
                        <PathIcon Classes="app-icon"
                              Data="{StaticResource AppIconRotateCw}"
                              Width="16" Height="16"
                              IsVisible="{Binding !RefreshDataCommand.IsRunning}"/>
                        <PathIcon Classes="app-icon refresh-running-glyph"
                              Data="{StaticResource AppIconLoaderCircle}"
                              Width="16" Height="16"
                              IsVisible="{Binding RefreshDataCommand.IsRunning}"/>
                    </Panel>
                </Button>
                <!-- 设置入口（导航到设置页；数据源与计价在侧栏「数据与计价」） -->
                <Button Grid.Column="7"
                        Classes="icon-btn"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="{Binding NavSettings, Source={x:Static loc:Translations.Instance}}">
                    <PathIcon Classes="app-icon"
                          Data="{StaticResource AppIconSettings}"
                          Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ 两栏（.shell：184 / *；原 276 右栏已撤除，空间归还主内容）═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="184,*">

            <!-- 左侧导航（.sidebar） -->
            <Border Grid.Column="0"
                    x:Name="Sidebar"
                    Width="184"
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource AppLineBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="10,0">
                    <!-- 品牌（logo/标题；原型 .brandmark + .brand）。标示图形 2026-10-24 起为
                         D-018 定稿应用图标本体（绿柱 v1，居中带 Apple 网格边距的烘焙资产）——
                         此前占位的「圆环 + 弧形」不是任何定稿设计，读作卡住的加载圈 -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,18,8,16" Orientation="Horizontal" Spacing="9">
                        <Image Source="avares://Tokenmetry.App/Assets/app-icon.png"
                               Width="24" Height="24"/>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Tokenmetry"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="ANALYTICS"
                                       FontSize="9"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 8 项导航（ListBox：条目可聚焦、方向键可移动选中，满足键盘可达） -->
                    <ListBox x:Name="NavList"
                             Classes="nav-list"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Classes="nav-indicator"
                                            Width="2" Height="16"
                                            CornerRadius="1"
                                            VerticalAlignment="Center"/>
                                    <!-- 矢量页面图标：Icon 键名经 PageIcon.Icon 翻译成 pi-* 伪类给 Data，
                                         颜色随选中态经 Foreground 继承生效 -->
                                    <PathIcon Classes="app-icon"
                                          Width="16" Height="16"
                                          c:PageIcon.Icon="{Binding Page.Icon}"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Page.Label}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 主内容区（页面路由；未落地页面为 PagePlaceholderView 占位）。
                 进场过渡（motion design）：code-behind 监听 Content 变更，Opacity 0→1 +
                 Y 8→0（180ms ease-out，TopLevel.RequestAnimationFrame 驱动），只有进场、无退出动画。
                 Q-006：外边距归零——滚动面铺满主内容列直达窗口右/底缘（overlay 滚动条贴窗缘），
                 页面留白由根滚动面自持（ScrollViewer.page-root；会话页头尾自补）。 -->
            <ContentControl Grid.Column="1"
                            x:Name="PageHost"
                            Margin="0"
                            Content="{Binding CurrentPage}"/>
        </Grid>

        <!-- ═══ 首次初始化遮罩（覆盖全窗，ZIndex 压过顶栏与两栏）═══
             IsInitializingData 仅由启动路径维护：库内完全无数据（首次使用）→ 启动首轮采集
             扫描期间挂起，轮次结束（成败均然）摘除——no data / error 的诚实终态由顶栏状态灯
             呈现，遮罩不掩盖结果。测试按 x:Name 定位。 -->
        <Panel Grid.Row="0" Grid.RowSpan="2" x:Name="InitializingOverlay"
               ZIndex="100"
               IsVisible="{Binding IsInitializingData}">
            <Border Background="{DynamicResource AppOverlayScrimBrush}"/>
            <Border Classes="overlay-card"
                    x:Name="OverlayCard"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <Ellipse Classes="overlay-spinner"/>
                    <TextBlock Classes="overlay-title" TextAlignment="Center"
                               Text="{Binding InitializingTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Classes="overlay-subtitle" TextAlignment="Center"
                               Text="{Binding InitializingSubtitle, Source={x:Static loc:Translations.Instance}}"/>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>
