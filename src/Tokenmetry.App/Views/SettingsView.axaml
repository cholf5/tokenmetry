<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:loc="using:Tokenmetry.App.Localization"
             xmlns:controls="using:Tokenmetry.App.Controls"
             x:Class="Tokenmetry.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!--
        S-004 设置页（自 S-002 合并页拆出后收缩为应用偏好）：外观与通用（主题三态 / 界面语言 /
        刷新间隔 / 关窗行为 / 开机自启动）+ 本地路径（只读说明 + 在文件管理器中打开）。
        数据源 / 统计口径 / 模型目录 / 别名映射在数据与计价页（DataPricingView）。全部设置项全自动
        保存（改完即生效并落盘，无保存按钮——对齐 stupid-dict；刷新间隔非法输入用行内提示兜住不落盘）。

        2026-10-29 版式收敛：表单改成「标签列 + 控件列」两列（标签 setting-label、说明 setting-hint），
        内容最大宽度 760——此前是 220px 控件贴左、标签与说明同款 muted 12px，右侧三分之二空白，
        标签、控件与帮助文字没有层级。设置页的信息结构本身也是产品的一部分，不再沿用默认表单皮肤。
    -->
    <ScrollViewer Classes="page-root">
        <StackPanel Spacing="13" Margin="0,0,0,4" MaxWidth="760" HorizontalAlignment="Left">

            <!-- 页头（原型 .pagehead） -->
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
            </StackPanel>

            <!-- ═══ 外观与通用（全部设置项全自动保存：改完即生效并落盘）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="16">
                    <TextBlock Classes="panel-title" Text="{Binding AppearanceTitle, Source={x:Static loc:Translations.Instance}}"/>

                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">

                        <!-- 主题（画板：整套配色气质，Styles/Themes/ 的生成画板） -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding LabelTheme, Source={x:Static loc:Translations.Instance}}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <ComboBox ItemsSource="{Binding PaletteOptions}" SelectedItem="{Binding SelectedPalette}"
                                      Width="300" HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PaletteOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                       Text="{Binding ThemeHint, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>

                        <!-- 模式（画板 × 模式两维的模式维；单档画板置灰——模式随画板固定） -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding ThemeModeLabel, Source={x:Static loc:Translations.Instance}}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <ComboBox ItemsSource="{Binding EffectiveThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                      IsEnabled="{Binding IsModeSelectionEnabled}"
                                      Width="300" HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThemeOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                       Text="{Binding ThemeModeHint, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>

                        <!-- 界面语言（切换即时全局生效并落盘） -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding LabelLanguage, Source={x:Static loc:Translations.Instance}}"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                                      Width="300" HorizontalAlignment="Left"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding Label}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                       Text="{Binding LanguageHint, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>

                        <!-- 刷新间隔 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding LabelRefreshInterval, Source={x:Static loc:Translations.Instance}}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                            <TextBox Text="{Binding RefreshMinutesText}" PlaceholderText="1" Width="300"
                                     HorizontalAlignment="Left"/>
                            <!-- 全自动保存的行内校验：非法输入显示提示且不落盘（保留上一个合法值） -->
                            <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                       Text="{Binding RefreshMinutesError}"
                                       Foreground="{DynamicResource AppAccentRedBrush}"
                                       IsVisible="{Binding RefreshMinutesError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                       Text="{Binding RefreshHint, Source={x:Static loc:Translations.Instance}}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Q-016：「启用异常通知」随 in-app toast 通道整体删除（日累计异常 × 分钟级刷新
                         = 整日轰炸，用户拍板删除；异常持续状态由弹层今日花费 KPI 徽标承载，Q-011）。
                         A-11 假开关红线同向适用：通道没了，开关必须一起走。 -->
                    <!-- S-005：关窗行为（消费者 = MainWindow.OnClosing 的关窗分派） -->
                    <StackPanel Spacing="4">
                        <CheckBox Content="{Binding CheckMinimizeToTrayOnClose, Source={x:Static loc:Translations.Instance}}"
                                  IsChecked="{Binding MinimizeToTrayOnClose}"/>
                        <TextBlock Classes="setting-hint" TextWrapping="Wrap" Margin="24,0,0,0"
                                   Text="{Binding CheckMinimizeToTrayOnCloseHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>

                    <!-- S-006：开机自启动（默认关；OS 注册 = IAutoStartManager，静默启动参数见 AutoStartManager.LaunchArg） -->
                    <StackPanel Spacing="4">
                        <CheckBox Content="{Binding CheckAutoStartOnBoot, Source={x:Static loc:Translations.Instance}}"
                                  IsChecked="{Binding AutoStartOnBoot}"/>
                        <TextBlock Classes="setting-hint" TextWrapping="Wrap" Margin="24,0,0,0"
                                   Text="{Binding CheckAutoStartOnBootHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>

                    <!-- I-045：采集文件日志（默认开；日志目录入口在下方「本地路径」区） -->
                    <StackPanel Spacing="4">
                        <CheckBox Content="{Binding CheckFileLogging, Source={x:Static loc:Translations.Instance}}"
                                  IsChecked="{Binding FileLoggingEnabled}"/>
                        <TextBlock Classes="setting-hint" TextWrapping="Wrap" Margin="24,0,0,0"
                                   Text="{Binding CheckFileLoggingHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 分享海报（默认值；海报本身继承顶部栏筛选，这里只决定对话框的起值）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="panel-title" Text="{Binding SharePosterSettingsTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                               Text="{Binding SharePosterSettingsHint, Source={x:Static loc:Translations.Instance}}"/>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding SharePosterDefaultLayout, Source={x:Static loc:Translations.Instance}}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding SharePosterLayoutOptions}"
                                  SelectedItem="{Binding SharePosterLayoutOption}"
                                  Width="300" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SharePosterOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding SharePosterDefaultTheme, Source={x:Static loc:Translations.Instance}}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SharePosterThemeOptions}"
                                  SelectedItem="{Binding SharePosterThemeOption}"
                                  Width="300" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SharePosterOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="setting-label"
                                   Text="{Binding SharePosterDefaultMask, Source={x:Static loc:Translations.Instance}}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SharePosterMaskOptions}"
                                  SelectedItem="{Binding SharePosterMaskOption}"
                                  Width="300" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SharePosterOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                               Text="{Binding SharePosterMaskHint, Source={x:Static loc:Translations.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 本地路径（只读说明 + 底部一个「打开目录」出口）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="panel-title" Text="{Binding LocalPathsTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelCacheDb, Source={x:Static loc:Translations.Instance}}"/>
                        <!-- SelectableTextBlock：路径要能选中复制（只读说明区且失败时靠它自取路径） -->
                        <SelectableTextBlock Grid.Column="1" Classes="table-td" Text="{Binding CacheDbPath}" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelSettingsFile, Source={x:Static loc:Translations.Instance}}"/>
                        <SelectableTextBlock Grid.Column="1" Classes="table-td" Text="{Binding SettingsFilePath}" TextWrapping="Wrap"/>
                    </Grid>
                    <!-- I-045：采集日志路径（排障自取路径；SelecteableTextBlock 同上） -->
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelLogFile, Source={x:Static loc:Translations.Instance}}"/>
                        <SelectableTextBlock Grid.Column="1" Classes="table-td" Text="{Binding LogDirectory}" TextWrapping="Wrap"/>
                    </Grid>
                    <!-- 动作回到面板底部左对齐一行（同「关于」区的「检查更新」位置与样式）：标题行右侧挂
                         实心按钮会在宽面板上悬在右缘、与左侧键值行脱开；底部左对齐让面板级动作“读完之后
                         就在下面”，也与页内其它面板按钮同列。两个文件同目录，一个动作就够。
                         只读语义不变——不提供更改数据目录。 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="app-btn"
                                Content="{Binding SettingsOpenDataFolder, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding OpenDataFolderCommand}"/>
                        <!-- I-045：报 issue 时有东西可贴（错误报告出口；卡内定案只做入口不做内置查看器） -->
                        <Button Classes="app-btn"
                                Content="{Binding SettingsOpenLogFolder, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding OpenLogFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ 关于（版本/版权/许可/仓库 + 更新检查，I-039/I-041）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="panel-title" Text="{Binding AboutTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelCurrentVersion, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding UpdateAppVersion}"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelCopyright, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding AboutCopyright}"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelLicense, Source={x:Static loc:Translations.Instance}}"/>
                        <!-- 许可名是专有名词不进 i18n（同 stupid-dict 的 "MIT"）；点击直达仓库 LICENSE 文件 -->
                        <HyperlinkButton Grid.Column="1" Padding="0" VerticalAlignment="Center"
                                         Content="GNU AGPL-3.0" NavigateUri="{Binding AboutLicenseUrl}"/>
                    </Grid>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="setting-label" Text="{Binding LabelRepository, Source={x:Static loc:Translations.Instance}}"/>
                        <HyperlinkButton Grid.Column="1" Padding="0" VerticalAlignment="Center"
                                         Content="{Binding AboutRepositoryUrl}" NavigateUri="{Binding AboutRepositoryUrl}"/>
                    </Grid>
                    <!-- AGPL-3.0 §7(d)：交互界面显示 Appropriate Legal Notices 的「无担保」半句 -->
                    <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                               Text="{Binding AboutWarrantyHint, Source={x:Static loc:Translations.Instance}}"/>
                    <!-- 求 Star 行：句中「Star」嵌成真链接（Avalonia 无内联 Hyperlink，LinkTextBlock
                         按链接词拆句渲染 + 命中测试开仓库；链词是 GitHub 专名，同「GNU AGPL-3.0」不进
                         i18n，全语种恒为拉丁「Star」，TranslationsTests 有不变式）。 -->
                    <controls:LinkTextBlock Classes="setting-hint" TextWrapping="Wrap"
                                            SourceText="{Binding AboutStarHint, Source={x:Static loc:Translations.Instance}}"
                                            LinkText="Star"
                                            LinkUrl="{Binding AboutRepositoryUrl}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <Button Classes="app-btn"
                                Content="{Binding SettingsCheckUpdate, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding CheckUpdateCommand}"/>
                        <!-- 发现新版本才亮出的一对出口：应用内直下（已安装副本下载后直接静默升级；
                             其余落「下载」文件夹 + 文件管理器显示）与浏览器开 Release 页（逃生口）。 -->
                        <Button Classes="app-btn primary"
                                Content="{Binding SettingsDownloadUpdate, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding DownloadUpdateCommand}"
                                IsVisible="{Binding IsUpdateAvailable}"/>
                        <!-- 下载校验完成后的最后一步：重启即生效（与主窗横幅同一个状态、同一个命令出口） -->
                        <Button Classes="app-btn primary"
                                Content="{Binding ActionRestartNow, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding RestartUpdateCommand}"
                                IsVisible="{Binding IsUpdateReadyToRestart}"/>
                        <Button Classes="app-btn"
                                Content="{Binding SettingsOpenReleasePage, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding OpenReleasePageCommand}"
                                IsVisible="{Binding IsUpdateAvailable}"/>
                    </StackPanel>
                    <!-- 下载进度：设置页自己发起的下载也要看得见百分比（横幅可能已被「稍后」收起） -->
                    <ProgressBar Minimum="0" Maximum="100" Height="4"
                                 Value="{Binding UpdateDownloadPercent}"
                                 IsVisible="{Binding IsUpdateProgressVisible}"/>
                    <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                               Text="{Binding UpdateStatusText}"
                               IsVisible="{Binding UpdateStatusText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <!-- 升级方式不同，提示也不同：Windows 安装副本点「下载更新」= 下载后自动安装并重启；
                         便携版 / macOS / Linux 仍是「下载 → 解压覆盖」。 -->
                    <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                               IsVisible="{Binding IsInstalledCopy}"
                               Text="{Binding AboutHintInstaller, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                               IsVisible="{Binding !IsInstalledCopy}"
                               Text="{Binding AboutHint, Source={x:Static loc:Translations.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 跨设备同步（relay 设计 §4.6：显式 opt-in 例外，默认零网络；账号与网络偏好归应用偏好页）═══ -->
            <Border Classes="panel" IsVisible="{Binding HasSyncState}">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <TextBlock Grid.Column="0" Classes="panel-title"
                                   Text="{Binding SyncTitle, Source={x:Static loc:Translations.Instance}}"/>
                        <!-- 开关 = 启用/关闭动作的入口（关闭态拨上 = 以当前输入启用；开启态拨下 = 关闭同步） -->
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSyncEnabled}"/>
                    </Grid>

                    <!-- 未启用：通道选择 + 凭据输入 + 启用提示 -->
                    <StackPanel Spacing="14" IsVisible="{Binding !IsSyncEnabled}">
                        <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                   Text="{Binding SyncDisabledHint, Source={x:Static loc:Translations.Instance}}"/>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <RadioButton GroupName="syncMode" Content="{Binding SyncModeOfficial, Source={x:Static loc:Translations.Instance}}"
                                         IsChecked="{Binding IsOfficialMode}"/>
                            <RadioButton GroupName="syncMode" Content="{Binding SyncModeSelfHosted, Source={x:Static loc:Translations.Instance}}"
                                         IsChecked="{Binding !IsOfficialMode}"/>
                        </StackPanel>

                        <!-- 官方通道：GitHub 登录（loopback 回监听；client_id 编译期常量，未配置时点击呈错误态） -->
                        <Button Classes="app-btn"
                                Content="{Binding SyncLoginGitHub, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding LoginGitHubCommand}"
                                IsVisible="{Binding IsOfficialMode}"/>

                        <!-- 自建通道：中继地址 + CLI 签发的账号 token -->
                        <StackPanel Spacing="10" IsVisible="{Binding !IsOfficialMode}">
                            <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Classes="setting-label"
                                           Text="{Binding SyncEndpoint, Source={x:Static loc:Translations.Instance}}"/>
                                <TextBox Grid.Column="1" Text="{Binding SyncEndpointInput}"
                                         PlaceholderText="http://192.168.1.10:8080"/>
                            </Grid>
                            <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Classes="setting-label"
                                           Text="{Binding SyncToken, Source={x:Static loc:Translations.Instance}}"/>
                                <!-- token 掩码显示（防 shoulder-surfing；值明文随 settings.json 落盘为设计已知取舍） -->
                                <TextBox Grid.Column="1" Text="{Binding SyncTokenInput}" PasswordChar="•"/>
                            </Grid>
                        </StackPanel>

                        <Button Classes="app-btn primary" HorizontalAlignment="Left"
                                Content="{Binding SyncEnable, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding EnableSyncCommand}"/>
                    </StackPanel>

                    <!-- 已启用：状态 + 设备管理 -->
                    <StackPanel Spacing="14" IsVisible="{Binding IsSyncEnabled}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Classes="setting-hint" Text="{Binding SyncStatusText}"/>
                            <TextBlock Classes="setting-hint"
                                       Text="{Binding LastSyncText}"
                                       IsVisible="{Binding LastSyncText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            <Button Classes="app-btn" Content="{Binding SyncNow, Source={x:Static loc:Translations.Instance}}"
                                    Command="{Binding SyncNowCommand}"/>
                            <Button Classes="app-btn" Content="{Binding SyncDisable, Source={x:Static loc:Translations.Instance}}"
                                    Command="{Binding DisableSyncCommand}"/>
                        </StackPanel>

                        <!-- 排行榜子区（leaderboard 设计 §4.4）：随「已启用」分支显隐——同步未连接即不渲染。
                             拨开仅解锁名字输入与保存按钮（PUT 在保存）；拨关立即 PUT optIn=false 并清展示
                             （VM 内投影守卫防回环）。展示名预填 GET 回来的生效名。 -->
                        <StackPanel Spacing="10">
                            <TextBlock Classes="panel-title"
                                       Text="{Binding LeaderboardSection, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                       Text="{Binding LeaderboardOptInHint, Source={x:Static loc:Translations.Instance}}"/>
                            <Grid ColumnDefinitions="132,*" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Classes="setting-label"
                                           Text="{Binding LeaderboardOptIn, Source={x:Static loc:Translations.Instance}}"/>
                                <ToggleSwitch Grid.Column="1" HorizontalAlignment="Left"
                                              IsChecked="{Binding LeaderboardOptIn}"/>
                            </Grid>
                            <Grid ColumnDefinitions="132,Auto,*" ColumnSpacing="16">
                                <TextBlock Grid.Column="0" Classes="setting-label"
                                           Text="{Binding LeaderboardDisplayName, Source={x:Static loc:Translations.Instance}}"/>
                                <TextBox Grid.Column="1" Width="220" Text="{Binding LeaderboardDisplayNameInput}"
                                         IsEnabled="{Binding LeaderboardOptIn}"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="app-btn"
                                            Content="{Binding LeaderboardSave, Source={x:Static loc:Translations.Instance}}"
                                            Command="{Binding SaveLeaderboardCommand}"/>
                                    <Button Classes="link-btn"
                                            Content="{Binding LeaderboardViewOnWeb, Source={x:Static loc:Translations.Instance}}"
                                            Command="{Binding OpenLeaderboardCommand}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="132,Auto,*" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Classes="setting-label"
                                       Text="{Binding SyncDeviceName, Source={x:Static loc:Translations.Instance}}"/>
                            <TextBox Grid.Column="1" Width="220" Text="{Binding DeviceNameInput}"/>
                            <Button Grid.Column="2" Classes="app-btn" VerticalAlignment="Center"
                                    Content="{Binding SyncRename, Source={x:Static loc:Translations.Instance}}"
                                    Command="{Binding RenameDeviceCommand}"/>
                        </Grid>

                        <TextBlock Classes="setting-label"
                                   Text="{Binding SyncDevices, Source={x:Static loc:Translations.Instance}}"/>
                        <ItemsControl ItemsSource="{Binding DeviceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SyncDeviceRowVM">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,2">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                            <SelectableTextBlock Classes="setting-hint" Text="{Binding DeviceId}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="setting-hint" VerticalAlignment="Center"
                                                   Text="{Binding LastSeenText}"/>
                                        <Button Grid.Column="3" Classes="app-btn"
                                                Content="{Binding SyncRemove, Source={x:Static loc:Translations.Instance}}"
                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveDeviceCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsLocal}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 移除确认（内联面板：解绑会级联清该设备的全部行，不可不问） -->
                        <Border Classes="panel" IsVisible="{Binding IsRemoveConfirmVisible}">
                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold"
                                           Text="{Binding SyncRemoveConfirmTitle, Source={x:Static loc:Translations.Instance}}"/>
                                <TextBlock Classes="setting-hint" TextWrapping="Wrap"
                                           Text="{Binding SyncRemoveConfirmMessage, Source={x:Static loc:Translations.Instance}}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="app-btn"
                                            Content="{Binding SyncRemove, Source={x:Static loc:Translations.Instance}}"
                                            Command="{Binding ConfirmRemoveCommand}"/>
                                    <Button Classes="app-btn"
                                            Content="{Binding ModelFormCancel, Source={x:Static loc:Translations.Instance}}"
                                            Command="{Binding CancelRemoveCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
