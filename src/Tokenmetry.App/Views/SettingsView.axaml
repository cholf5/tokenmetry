<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:loc="using:Tokenmetry.App.Localization"
             xmlns:c="using:Tokenmetry.App.Controls"
             x:Class="Tokenmetry.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!--
        S-002 数据源与设置页（原型 #page-settings）：页头 + 已识别的数据源表（真实扫描快照，
        全局重扫——采集管道不支持 per-source，按钮语义如实）+ 统计口径说明区（逐项定案，
        全部说明样式，不做假开关）+ 模型聚合卡（用户维护的别名映射，原始名 → 规范名，
        统计按规范名合并）+ 既有设置项迁入（主题三态 / 界面语言 / 刷新间隔 / 通知 /
        ccusage 命令 / 本地路径）。全部设置项全自动保存（改完即生效并落盘，无保存按钮——
        对齐 stupid-dict；刷新间隔非法输入用行内提示兜住不落盘）；重扫操作经 IToastService
        反馈（I-027）。
    -->
    <ScrollViewer>
        <StackPanel Spacing="13" Margin="0,0,0,4">

            <!-- 页头（原型 .pagehead） -->
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
            </StackPanel>

            <!-- ═══ 已识别的数据源（widepanel）：行 = 采集扫描注册表快照，无手写清单 ═══ -->
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <!-- panelhead：标题 + meta + 全局重扫（per-source 重扫不支持，语义见按钮文案） -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Classes="Secondary"
                                Content="{Binding ScanButtonText}"
                                Command="{Binding RescanCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Classes="page-subtitle"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SourceMetaText}"/>
                        <TextBlock Classes="panel-title" Text="{Binding SourcesPanelTitle, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 表头（原型 .table：数据源 / 状态 / 最近扫描 / 记录数；per-source 重扫列不设——
                         采集管道为单信号量串行全源扫描，逐行重扫按钮会是假能力） -->
                    <Grid Grid.Row="1" ColumnDefinitions="1.6*,1*,0.9*,0.9*" ColumnSpacing="8" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding ThSource, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-th" Text="{Binding ThStatus, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="2" Classes="table-th" Text="{Binding ThLastScan, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="3" Classes="table-th" Text="{Binding ThRecords, Source={x:Static loc:Translations.Instance}}" TextAlignment="Right"/>
                    </Grid>

                    <!-- 数据源行（整表随快照重建；状态着色经 status-* 类条件绑定） -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SourceRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DataSourceRowViewModel">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="1.6*,1*,0.9*,0.9*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Classes="table-td" FontWeight="SemiBold"
                                                   Text="{Binding Agent}" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Classes="table-td"
                                                   Classes.status-ok="{Binding IsOk}"
                                                   Classes.status-partial="{Binding IsPartial}"
                                                   Classes.status-nodata="{Binding IsNoData}"
                                                   Classes.status-error="{Binding IsError}"
                                                   Classes.status-pending="{Binding IsPending}"
                                                   Text="{Binding StatusText}"/>
                                        <TextBlock Grid.Column="2" Classes="table-td"
                                                   Text="{Binding LastScanText}"/>
                                        <TextBlock Grid.Column="3" Classes="table-num"
                                                   Text="{Binding RecordCountText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ═══ 统计口径：逐项定案为说明样式（S-002 Dev Log），不做假开关 ═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panel-title" Text="{Binding CaliberTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <ItemsControl ItemsSource="{Binding CaliberRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CaliberItem">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="1.6*,1.8*" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="chip" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Badge}"/>
                                            </Border>
                                            <TextBlock Classes="table-td" FontWeight="SemiBold"
                                                       Text="{Binding Text}" TextWrapping="Wrap"
                                                       VerticalAlignment="Top"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="page-subtitle"
                                                   Text="{Binding Note}" TextWrapping="Wrap"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ 模型聚合（别名映射）：原始模型名 → 规范名，统计按规范名合并（规则增删即存即热更新）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panel-title" Text="{Binding AliasPanelTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                               Text="{Binding AliasPanelHint, Source={x:Static loc:Translations.Instance}}"/>

                    <!-- 规则列表（整表随增删重建；目标侧附规范名的厂商图标——统计里显示的是规范名） -->
                    <ItemsControl ItemsSource="{Binding AliasRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AliasRuleRowViewModel">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Border Classes="model-chip" c:ModelChip.Vendor="{Binding Vendor}">
                                                <TextBlock Text="{Binding Glyph}"/>
                                            </Border>
                                            <TextBlock Classes="table-td" Text="{Binding Alias}"
                                                       ToolTip.Tip="{Binding Alias}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="table-td"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="→" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="table-td" Text="{Binding Target}"
                                                   ToolTip.Tip="{Binding Target}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="3" Classes="link-btn" VerticalAlignment="Center"
                                                Content="{Binding AliasRemove, Source={x:Static loc:Translations.Instance}}"
                                                Command="{Binding $parent[ItemsControl].DataContext.RemoveAliasRuleCommand}"
                                                CommandParameter="{Binding Alias}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="page-subtitle"
                               Text="{Binding AliasEmpty, Source={x:Static loc:Translations.Instance}}"
                               IsVisible="{Binding HasNoAliasRules}"/>

                    <!-- 新增规则：两侧都是「候选下拉 + 自由输入」（AutoCompleteBox） -->
                    <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="page-subtitle" Text="{Binding AliasSourceLabel, Source={x:Static loc:Translations.Instance}}"/>
                            <AutoCompleteBox ItemsSource="{Binding AliasCandidates}"
                                             Text="{Binding NewAliasSource, Mode=TwoWay}"
                                             PlaceholderText="{Binding AliasSourcePlaceholder, Source={x:Static loc:Translations.Instance}}"
                                             TextFilter="{x:Static c:AutoCompleteFilters.CaseInsensitiveContains}"
                                             MinimumPrefixLength="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="page-subtitle" Text="{Binding AliasTargetLabel, Source={x:Static loc:Translations.Instance}}"/>
                            <AutoCompleteBox ItemsSource="{Binding AliasCandidates}"
                                             Text="{Binding NewAliasTarget, Mode=TwoWay}"
                                             PlaceholderText="{Binding AliasTargetPlaceholder, Source={x:Static loc:Translations.Instance}}"
                                             TextFilter="{x:Static c:AutoCompleteFilters.CaseInsensitiveContains}"
                                             MinimumPrefixLength="0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Classes="Secondary"
                                Content="{Binding AliasAdd, Source={x:Static loc:Translations.Instance}}"
                                Command="{Binding AddAliasRuleCommand}"
                                VerticalAlignment="Center"/>
                        <TextBlock Classes="page-subtitle" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding AliasError}"
                                   Foreground="{DynamicResource AppAccentRedBrush}"
                                   IsVisible="{Binding AliasError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                    <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                               Text="{Binding AliasCandidatesHint, Source={x:Static loc:Translations.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 外观与通用（既有设置项迁入新信息架构；全部设置项全自动保存：改完即生效并落盘）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Classes="panel-title" Text="{Binding AppearanceTitle, Source={x:Static loc:Translations.Instance}}"/>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="{Binding LabelTheme, Source={x:Static loc:Translations.Instance}}"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                  Width="220" HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="{Binding ThemeHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>

                    <!-- 界面语言（zh/en/system；切换即时全局生效并落盘） -->
                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="{Binding LabelLanguage, Source={x:Static loc:Translations.Instance}}"/>
                        <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                                  Width="220" HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LanguageOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="{Binding LanguageHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="{Binding LabelRefreshInterval, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBox Text="{Binding RefreshMinutesText}" PlaceholderText="15" Width="220"
                                 HorizontalAlignment="Left"/>
                        <!-- 全自动保存的行内校验：非法输入显示提示且不落盘（保留上一个合法值） -->
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="{Binding RefreshMinutesError}"
                                   Foreground="{DynamicResource AppAccentRedBrush}"
                                   IsVisible="{Binding RefreshMinutesError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="{Binding RefreshHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="{Binding LabelCcusageCli, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBox Text="{Binding CcusageCommand}" PlaceholderText="ccusage" Width="320"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="{Binding CcusageHint, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>

                    <!-- A-11：两开关中仅「异常通知」有真实行为（接 ISystemNotification → in-app toast，
                         见 ToastSystemNotification）；「显示调试信息」无任何 UI 消费者（消费视图已删），
                         按假开关红线删除——诚实优先，未来有调试出口再恢复。 -->
                    <CheckBox Content="{Binding CheckAnomalyNotifications, Source={x:Static loc:Translations.Instance}}"
                              IsChecked="{Binding AnomalyNotificationsEnabled}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 本地路径（只读说明）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="panel-title" Text="{Binding LocalPathsTitle, Source={x:Static loc:Translations.Instance}}"/>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="page-subtitle" Text="{Binding LabelCacheDb, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding CacheDbPath}" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="page-subtitle" Text="{Binding LabelSettingsFile, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding SettingsFilePath}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
