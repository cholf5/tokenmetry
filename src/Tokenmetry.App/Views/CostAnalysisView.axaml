<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:loc="using:Tokenmetry.App.Localization"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Views.CostAnalysisView"
             x:DataType="vm:CostViewModel">

    <!--
        D-013 成本分析页（原型 #page-cost）：页头 + KPI 六卡两排三列（估算总成本四态 / 输入占比 / 输出占比 /
        缓存读占比 / 缓存写占比 / 待确认价格）+ 「成本计算口径」静态三行说明表（实际计费优先 · 价格表估算 ·
        未知不折零）。Q-007：输入/输出/缓存读/缓存写四项 Token 构成占比单列成卡（分子合计 = 分母
        Σ TotalTokens，占比拼起来覆盖全部 Token），KPI 脚注显式标注口径；修正项 1：单排六卡挤压、
        首卡标题溢出，改两排三列；待确认价格为定价引擎全局口径，脚注说明不随筛选变化。
    -->
    <ScrollViewer Classes="page-root">
        <StackPanel Spacing="13" Margin="0,0,0,4">

            <!-- 页头（原型 .pagehead：区分真实计费、模型价格估算与无法估价的数据） -->
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
            </StackPanel>

            <!-- 加载失败（诚实错误态；已加载 KPI 保留，筛选再变化自动重试） -->
            <Border Classes="panel" Padding="13" IsVisible="{Binding HasLoadError}">
                <TextBlock Classes="page-subtitle" Text="{Binding LoadError}"/>
            </Border>

            <!-- ═══ .kpis：六张 KPI 卡两排三列（Q-007 修正项 1：单排六列挤压、首卡标题溢出；
                 第一排 = 总成本 + 输入/输出占比，第二排 = 缓存读/写占比 + 待确认价格）═══ -->
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="12">

                <!-- 1. 估算总成本（AggregatedCost 四态：未知 / $x.xx+ / $x.xx / —，未知绝不折 0） -->
                <Border Grid.Column="0" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipAmberBackgroundBrush}">
                                <PathIcon Classes="app-icon"
                                          Data="{StaticResource AppIconDollarCircle}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource AppIconChipAmberForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="{Binding KpiTotalCost, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding TotalCostText}"/>
                        <TextBlock Classes="kpi-foot" Text="{Binding KpiFootKnownCostOnly, Source={x:Static loc:Translations.Instance}}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. 输入成本占比（Token 构成口径显式标注——决策点方案 b，不做隐式近似） -->
                <Border Grid.Column="1" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipBlueBackgroundBrush}">
                                <PathIcon Classes="app-icon"
                                          Data="{StaticResource AppIconArrowDown}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource AppIconChipBlueForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="{Binding KpiInputCostShare, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding InputShareText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="{Binding KpiFootTokenShareBasis, Source={x:Static loc:Translations.Instance}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. 输出成本占比（同上口径；原型 meta「输出单价通常更高」为定价常识，非本页数据） -->
                <Border Grid.Column="2" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipPurpleBackgroundBrush}">
                                <PathIcon Classes="app-icon"
                                          Data="{StaticResource AppIconArrowUp}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource AppIconChipPurpleForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="{Binding KpiOutputCostShare, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding OutputShareText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="{Binding KpiFootTokenShareBasis, Source={x:Static loc:Translations.Instance}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4. 缓存读取占比（Q-007 单列成卡；Token 构成口径，分子 ΣCacheRead）。
                     图标 hard-drive-upload = 数据出盘（从缓存读出），与输入 ↓ / 输出 ↑ 方向语言同构 -->
                <Border Grid.Row="1" Grid.Column="0" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipNeutralBackgroundBrush}">
                                <PathIcon Classes="app-icon"
                                          Data="{StaticResource AppIconHardDriveUpload}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource AppIconChipNeutralForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="{Binding KpiCacheReadShare, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding CacheReadShareText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="{Binding KpiFootTokenShareBasis, Source={x:Static loc:Translations.Instance}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 5. 缓存写占比（Q-007 单列成卡；分子 ΣCacheCreation，Anthropic 口径 cache_creation）。
                     图标 hard-drive-download = 数据入盘（写入缓存） -->
                <Border Grid.Row="1" Grid.Column="1" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipNeutralBackgroundBrush}">
                                <PathIcon Classes="app-icon"
                                          Data="{StaticResource AppIconHardDriveDownload}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource AppIconChipNeutralForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="{Binding KpiCacheWriteShare, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding CacheWriteShareText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="{Binding KpiFootTokenShareBasis, Source={x:Static loc:Translations.Instance}}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 6. 待确认价格（PricingEngine.GetUnpricedModels 全局口径——不随时间范围/Agent 筛选变化） -->
                <Border Grid.Row="1" Grid.Column="2" Classes="kpi"
                        ToolTip.Tip="{Binding UnpricedModelsTooltip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <!-- 缺价是数据质量风险：0 个 = 中性芯片，>0 = 琥珀警示（不再用成功绿） -->
                            <Border Classes="icon-chip"
                                    Classes.neutral="{Binding !HasUnpricedModels}"
                                    Classes.warn="{Binding HasUnpricedModels}">
                                <PathIcon Classes="app-icon"
                                          Data="{StaticResource AppIconCircleHelp}"
                                          Width="15" Height="15"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="{Binding KpiUnpriced, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding UnpricedCountText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="{Binding KpiFootUnpriced, Source={x:Static loc:Translations.Instance}}"
                                   TextWrapping="Wrap"/>
                        <!-- I-035：缺价模型的处理入口在设置页的模型目录（关联 / 定价）。
                             这里只指路，不做跨页跳转（本页定位是"如实说明口径"，动作在设置页）。 -->
                        <TextBlock Classes="kpi-foot" TextWrapping="Wrap"
                                   Text="{Binding KpiFootUnpricedWhere, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 未知成本说明行（估算总成本含未知贡献时可见；D-010 口径的页面级说明） -->
            <TextBlock Classes="page-subtitle" Text="{Binding UnknownCostNoteText}"
                       IsVisible="{Binding HasUnknownCostNote}"
                       TextWrapping="Wrap"/>

            <!-- ═══ 成本计算口径（静态三行说明表，原型同款；内容与 docs/reconciliation 口径对齐）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panel-title" Text="{Binding PanelCostBasis, Source={x:Static loc:Translations.Instance}}"/>
                    <Grid ColumnDefinitions="1.1*,1.3*,2.2*" ColumnSpacing="10" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding ThItem, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-th" Text="{Binding ThSuggestedDisplay, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="2" Classes="table-th" Text="{Binding ThCaveats, Source={x:Static loc:Translations.Instance}}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CostBasisRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CostBasisRowViewModel">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="1.1*,1.3*,2.2*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Classes="table-td" FontWeight="SemiBold"
                                                   Text="{Binding Item}" VerticalAlignment="Top"/>
                                        <Border Grid.Column="1" Classes="chip" HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Stance}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="table-td"
                                                   Text="{Binding Note}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
