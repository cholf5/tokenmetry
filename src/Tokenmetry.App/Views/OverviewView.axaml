<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:c="using:Tokenmetry.App.Controls"
             xmlns:loc="using:Tokenmetry.App.Localization"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <!--
        D-006/D-007 总览页（原型 #page-overview）：页头（标题/副标题）+ 四张 KPI 卡 +
        Token 使用趋势（D-004 TrendChart DailyTokens）+ Agent 使用占比环形（D-005 DonutChart）+
        两个 .gridEqual 下行（D-007）：模型使用分布表 / Token 类型构成环形 / 项目排行表 / 成本趋势折线。
        筛选控件在外壳顶部栏（D-003 全局状态），本页只随 FilterStateService 刷新；
        「查看详情 ↗」经 VM 构造注入的导航回调（外壳 GoToPage）跳模型/项目页。
        Q-002：页面根补 ScrollViewer（同时间/成本/设置页模式）——最小窗口高度下底部面板不再被裁剪。
    -->
    <ScrollViewer Classes="page-root">
        <StackPanel Spacing="13" Margin="0,0,0,4">

        <!-- 页头（原型 .pagehead；筛选下拉在顶部栏，不在此重复） -->
        <StackPanel Spacing="4">
            <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
            <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
        </StackPanel>

        <!-- 加载失败（诚实错误态；筛选再变化自动重试） -->
        <Border Classes="panel" Padding="13" IsVisible="{Binding HasLoadError}">
            <TextBlock Classes="page-subtitle" Text="{Binding LoadError}"/>
        </Border>

        <!-- ═══ .kpis：四张 KPI 卡（icon-chip 四色对齐原型 .kpi-icon nth-child 顺序）═══ -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

            <!-- 1. 总 Token 数 -->
            <Border Grid.Column="0" Classes="kpi">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip"
                                Background="{DynamicResource AppIconChipBlueBackgroundBrush}">
                            <PathIcon Classes="app-icon"
                                  Data="{StaticResource AppIconCoins}"
                                  Width="15" Height="15"
                                  Foreground="{DynamicResource AppIconChipBlueForegroundBrush}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding KpiTotalTokens, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding TokensCard.Value}"/>
                    <!-- D-007 P3 顺手修：横排 StackPanel 在窄主区把脚注裁切，改 Grid（Auto,*）让说明列换行 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <TextBlock Grid.Column="0" Classes="kpi-foot"
                                   Text="{Binding TokensCard.ChangeText}"
                                   Classes.kpi-change-up="{Binding TokensCard.IsUp}"
                                   Classes.kpi-change-down="{Binding TokensCard.IsDown}"
                                   Classes.kpi-change-flat="{Binding TokensCard.IsFlat}"/>
                        <TextBlock Grid.Column="1" Classes="kpi-foot"
                                   Text="{Binding KpiFootVsPrevious, Source={x:Static loc:Translations.Instance}}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. 估算成本（未知成本四态文案由 VM 给出：未知 / $x.xx+ / $x.xx / —） -->
            <Border Grid.Column="1" Classes="kpi">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip"
                                Background="{DynamicResource AppIconChipAmberBackgroundBrush}">
                            <PathIcon Classes="app-icon"
                                  Data="{StaticResource AppIconDollarCircle}"
                                  Width="15" Height="15"
                                  Foreground="{DynamicResource AppIconChipAmberForegroundBrush}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding KpiEstimatedCost, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding CostCard.Value}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <TextBlock Grid.Column="0" Classes="kpi-foot"
                                   Text="{Binding CostCard.ChangeText}"
                                   Classes.kpi-change-up="{Binding CostCard.IsUp}"
                                   Classes.kpi-change-down="{Binding CostCard.IsDown}"
                                   Classes.kpi-change-flat="{Binding CostCard.IsFlat}"/>
                        <TextBlock Grid.Column="1" Classes="kpi-foot"
                                   Text="{Binding KpiFootPriceEstimate, Source={x:Static loc:Translations.Instance}}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. 会话数 -->
            <Border Grid.Column="2" Classes="kpi">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip"
                                Background="{DynamicResource AppIconChipPurpleBackgroundBrush}">
                            <PathIcon Classes="app-icon"
                                  Data="{StaticResource AppIconTable}"
                                  Width="15" Height="15"
                                  Foreground="{DynamicResource AppIconChipPurpleForegroundBrush}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding KpiSessions, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding SessionsCard.Value}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <TextBlock Grid.Column="0" Classes="kpi-foot"
                                   Text="{Binding SessionsCard.ChangeText}"
                                   Classes.kpi-change-up="{Binding SessionsCard.IsUp}"
                                   Classes.kpi-change-down="{Binding SessionsCard.IsDown}"
                                   Classes.kpi-change-flat="{Binding SessionsCard.IsFlat}"/>
                        <TextBlock Grid.Column="1" Classes="kpi-foot"
                                   Text="{Binding KpiFootAcrossAgents, Source={x:Static loc:Translations.Instance}}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. 缓存读取占比（总 token 为 0 时无基数 → "—"，不伪造 0%） -->
            <Border Grid.Column="3" Classes="kpi">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip"
                                Background="{DynamicResource AppIconChipGreenBackgroundBrush}">
                            <PathIcon Classes="app-icon"
                                  Data="{StaticResource AppIconZap}"
                                  Width="15" Height="15"
                                  Foreground="{DynamicResource AppIconChipGreenForegroundBrush}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding KpiCacheShare, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding CacheCard.Value}"/>
                    <!-- D-006 审查 P3：此卡脚注最长，窄主区原横排被裁切 → Grid + 换行 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <TextBlock Grid.Column="0" Classes="kpi-foot"
                                   Text="{Binding CacheCard.ChangeText}"
                                   Classes.kpi-change-up="{Binding CacheCard.IsUp}"
                                   Classes.kpi-change-down="{Binding CacheCard.IsDown}"
                                   Classes.kpi-change-flat="{Binding CacheCard.IsFlat}"/>
                        <TextBlock Grid.Column="1" Classes="kpi-foot"
                                   Text="{Binding KpiFootCacheOfInput, Source={x:Static loc:Translations.Instance}}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ .grid2 第一行：趋势图 + Agent 环形（gap:12px；minmax(0,1.55fr)/minmax(250px,.85fr)）═══ -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="0.85*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Token 使用趋势（原型 .panel + .panelhead h2/.meta/.legend；.chart 高 190px） -->
            <Border Grid.Column="0" Classes="panel">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="kpi-foot" Text="{Binding LegendDaily, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                            <!-- 图例三色 ← 原型 legend 输入=blue / 输出=purple / 总量=cyan -->
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="series-dot"
                                        Background="{DynamicResource AppAccentBlueBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LegendInput, Source={x:Static loc:Translations.Instance}}" FontSize="10"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="series-dot"
                                        Background="{DynamicResource AppAccentPurpleBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LegendOutput, Source={x:Static loc:Translations.Instance}}" FontSize="10"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="series-dot"
                                        Background="{DynamicResource AppAccentCyanBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LegendTotal, Source={x:Static loc:Translations.Instance}}" FontSize="10"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Classes="panel-title" Text="{Binding PanelTrend, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:TrendChart Height="190" Mode="DailyTokens" DailyPoints="{Binding DailyPoints}"/>
                </StackPanel>
            </Border>

            <!-- Agent 使用占比（环中心 = KPI 总 Token 紧凑格式，副文字对齐原型 "Total Tokens"） -->
            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="13">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="kpi-foot" Text="{Binding MetaByTotalTokens, Source={x:Static loc:Translations.Instance}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Classes="panel-title" Text="{Binding PanelAgentDonut, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:DonutChart Segments="{Binding AgentSegments}"
                                  CenterTitle="{Binding AgentDonutCenterTitle}"
                                  CenterSubtitle="Total Tokens"
                                  HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ .gridEqual 第一行（D-007）：模型使用分布 + Token 类型构成 ═══ -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 模型使用分布（Top6 + mini bar，bar 值 = 占全部模型 token 的百分比；原型 .table 三列） -->
            <Border Grid.Column="0" Classes="panel">
                <StackPanel Spacing="9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="link-btn"
                                Command="{Binding OpenModelsCommand}"
                                VerticalAlignment="Center" Content="{Binding ViewDetails, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Classes="panel-title" Text="{Binding PanelModelDistribution, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid ColumnDefinitions="*,76,52" ColumnSpacing="10" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding ThModel, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="1" Classes="table-th" TextAlignment="Right" Text="{Binding ThTokenCount, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="2" Classes="table-th" TextAlignment="Right" Text="{Binding ThShare, Source={x:Static loc:Translations.Instance}}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ModelRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DimensionRowViewModel">
                                <!-- 行顶分隔线 ← 原型 .table td{border-top:1px solid #202f45}（AppLineBrush 同源令牌） -->
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid ColumnDefinitions="*,76,52" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <!-- 模型行：头像（含用户自定义头像/图标选择器四模式）；项目行仍用系列色圆点 -->
                                                <Border Classes="model-chip" c:ModelChip.Avatar="{Binding Avatar}"
                                                        IsVisible="{Binding HasModelIcon}"
                                                        ToolTip.Tip="{Binding Name}">
                                                    <Panel>
                                                        <TextBlock Text="{Binding Avatar.GlyphText}"/>
                                                        <Image Classes="model-logo"/>
                                                        <Image Classes="model-avatar"
                                                               Source="{Binding Avatar.ImageDataUri, Converter={x:Static c:DataUriImageConverter.Instance}}"/>
                                                        <PathIcon Classes="app-icon model-fallback"
                                                                  Data="{StaticResource AppIconCircleHelp}"/>
                                                    </Panel>
                                                </Border>
                                                <Border Classes="series-dot" Background="{Binding DotBrush}"
                                                        IsVisible="{Binding !HasModelIcon}"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Classes="table-td" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <ProgressBar Classes="mini" Value="{Binding BarValue}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="table-num" Text="{Binding TokensText}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Classes="table-num" Text="{Binding ShareText}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空数据诚实空态（原型 .empty 同款文案） -->
                    <TextBlock Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}" IsVisible="{Binding !HasModelRows}"/>
                </StackPanel>
            </Border>

            <!-- Token 类型构成（三段：输入(未缓存)/输出/缓存相关，固定三色对齐原型 typeDonut） -->
            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="13">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="kpi-foot" Text="{Binding MetaNormalizedAcrossSources, Source={x:Static loc:Translations.Instance}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Classes="panel-title" Text="{Binding PanelTypeDonut, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:DonutChart Segments="{Binding TypeSegments}"
                                  CenterTitle="{Binding TypeDonutCenterTitle}"
                                  CenterSubtitle="Total Tokens"
                                  HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ .gridEqual 第二行（D-007）：项目 / 目录排行 + 成本趋势 ═══ -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 项目 / 目录排行（排名 + 归一化项目名 + token + 占比 + mini bar） -->
            <Border Grid.Column="0" Classes="panel">
                <StackPanel Spacing="9">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="link-btn"
                                Command="{Binding OpenProjectsCommand}"
                                VerticalAlignment="Center" Content="{Binding ViewDetails, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Classes="panel-title" Text="{Binding PanelProjectRanking, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid ColumnDefinitions="22,*,76,52" ColumnSpacing="10" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Classes="table-th" Text="#"/>
                        <TextBlock Grid.Column="1" Classes="table-th" Text="{Binding LabelProjectDir, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="2" Classes="table-th" TextAlignment="Right" Text="{Binding ThTokenCount, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Grid.Column="3" Classes="table-th" TextAlignment="Right" Text="{Binding ThShare, Source={x:Static loc:Translations.Instance}}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ProjectRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DimensionRowViewModel">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0" Padding="0,8">
                                    <Grid ColumnDefinitions="22,*,76,52" ColumnSpacing="10">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center">
                                            <TextBlock Classes="table-th" Text="{Binding Rank}"/>
                                            <Border Classes="series-dot" Background="{Binding DotBrush}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Classes="table-td" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Classes="mini" Value="{Binding BarValue}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="table-num" Text="{Binding TokensText}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Classes="table-num" Text="{Binding ShareText}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}" IsVisible="{Binding !HasProjectRows}"/>
                </StackPanel>
            </Border>

            <!-- 成本趋势（TrendChart CostUsd 吃同窗口日序列成本列：补零日 $0 成线 + 淡点辨识，
                 未知成本日断线 + 淡点，空态内置） -->
            <Border Grid.Column="1" Classes="panel">
                <StackPanel Spacing="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Classes="kpi-foot" Text="{Binding MetaEstimateUsd, Source={x:Static loc:Translations.Instance}}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Classes="panel-title" Text="{Binding PanelCostTrend, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:TrendChart Height="190" Mode="CostUsd" DailyPoints="{Binding DailyPoints}"/>
                </StackPanel>
            </Border>
        </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
