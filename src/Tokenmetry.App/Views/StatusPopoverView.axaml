<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tokenmetry.App.ViewModels"
             xmlns:loc="using:Tokenmetry.App.Localization"
             xmlns:c="using:Tokenmetry.App.Controls"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Views.StatusPopoverView"
             x:DataType="vm:StatusPopoverViewModel">
    <!-- [D-015/Q-011/Q-017] 状态栏快捷信息窗 · 内容层（跨平台共享 UserControl，壳层在 D-016）：
         信息架构按原型 docs/design/tokenmetry_statusbar_prototype.html 锁定——头部状态灯 +
         三格 KPI + Token 构成条 + 主要 Agent Top4 + 速率 banner + footer 快捷入口。
         Q-011 修正：原型/初版的 Warn banner 撤除——日尺度异常全天常驻会整日挤掉转瞬即逝的
         实时速率，归位为 popover-cost-warn-badge，与速率 banner 正交并存。
         落地偏离原型（卡内修正项）：Agent 图标用真品牌标（agent-chip 机制）/ 颜色全令牌化
         DynamicResource（本文件零硬编码色值，headless 断言固化）/ 最小字号 10px /
         构成条三段色与总览页 Token 构成同令牌（AppTokenType*，不随明暗翻转）。
         Q-017：KPI 三格同字号（17）同列宽（原型 22px 主格 + 1.3fr 撤除）；异常徽章迁头部
         品牌/状态之后（Q-011 曾贴 KPI 花费格数字旁，挤占格局且不如头部醒目）。
         数据全走 IUsageQueryService / DashboardViewModel 既有回写（口径见 StatusPopoverViewModel）。 -->
    <UserControl.Styles>
        <!-- 卡片壳：438px 固定宽（原型 .popup），投影由 D-016 壳层窗负责（Border BoxShadow 需要透明窗留边）；
             毛玻璃变体（D-016 B5/B6）由壳层窗协商到 AcrylicBlur 时切 acrylic 类启用，默认保持不透明——
             系统透明效果关闭 / RDP / 旧 Win10 等回落场景文字对比度不受影响。
             acrylic-square（仅 Windows）：窗口贴合卡片后圆角交给 DWM 原生（Win11 8px / Win10 方形），
             本卡改方形去描边——描边画在系统裁剪之外会出现角部断线 -->
        <Style Selector="Border.popover-card">
            <Setter Property="Width" Value="438"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.popover-card.acrylic">
            <Setter Property="Background" Value="{DynamicResource AppPopoverCardBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.popover-card.acrylic.acrylic-square">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- 头部（52px）：底描边 ← 原型 .head border-bottom -->
        <Style Selector="Border.popover-head">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- 状态灯：Idle 绿 / Active 蓝（随 VM 态类切换；原型 .live 的绿色点同语义）；
             异常不改变灯色（Q-011：灯只反映实时态，异常由头部徽章承载，Q-017 起迁入） -->
        <Style Selector="Ellipse.popover-live-dot">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="Fill" Value="{DynamicResource AppAccentGreenBrush}"/>
        </Style>
        <Style Selector="Ellipse.popover-live-dot.active">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBlueBrush}"/>
        </Style>
        <Style Selector="Button.popover-icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- 速率 banner ← 原型 .banner（Active 蓝调）；warn 变体随 Q-011 撤除（异常归位徽章，
             Q-017 起徽章在头部） -->
        <Style Selector="Border.popover-banner">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,0,0,13"/>
            <Setter Property="Background" Value="{DynamicResource AppBannerActiveBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBannerActiveLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Ellipse.popover-banner-dot">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{DynamicResource AppAccentBlueBrush}"/>
        </Style>
        <!-- 今日花费异常徽章（Q-011 归位、Q-017 迁头部）：日尺度异常的应用级警示位——头部
             品牌/状态之后，不挤占 KPI 格局；配色复用 D-015 warn banner 的既有令牌
             （AppBannerWarn*），文本用橙强调（明暗各自协调值）。
             Q-018：文本样式从嵌套后代选择器（Border...badge TextBlock）改自类
             （popover-cost-warn-text）——ToolTip 在逻辑树上是挂载目标的子节点，后代选择器
             会把 tooltip 内容 TextBlock 一并染橙（暗色浅底橙字不可读）；tooltip 底色挂
             chart-tip 令牌类（Semi 默认 ToolTip 配色错配，B-006 图表侧前科） -->
        <Style Selector="Border.popover-cost-warn-badge">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource AppBannerWarnBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBannerWarnLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.popover-cost-warn-text">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccentOrangeBrush}"/>
        </Style>
        <!-- KPI 三格与 metric 卡 ← 原型 .stats/.metric；Q-017 字号收敛 17/12/10
            （原型 22px 主次层级撤除；修正项 3：下限 10） -->
        <Style Selector="TextBlock.popover-cap">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        </Style>
        <Style Selector="Border.popover-seg-card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Ellipse.popover-seg-dot">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="6"/>
        </Style>
        <!-- Agent 行：透明整行按钮（点击 → 会话页），行内 30×30 品牌芯片 + mini bar -->
        <Style Selector="Button.popover-agent-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,7"/>
            <!-- Semi Button 主题默认 HorizontalAlignment=Center（收缩后整行居中），
                 行钮在垂直 StackPanel 里必须显式撑满，图标列/数字列才能逐行对齐 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.popover-agent-row:pointer /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <!-- footer 双按钮 ← 原型 .foot；主按钮走品牌蓝 + 恒白文字 -->
        <Style Selector="Button.popover-btn">
            <Setter Property="Padding" Value="9"/>
            <!-- 同行钮：覆盖 Semi 主题 Center，按钮须填满 *,1.4* 网格列 -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="Button.popover-btn.primary">
            <Setter Property="Background" Value="{DynamicResource AppAccentBlueBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBlueBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnBrandForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.popover-hr">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,15"/>
            <Setter Property="Background" Value="{DynamicResource AppCardLineBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="popover-card">
        <StackPanel>
            <!-- 头部：品牌 + 状态灯 + ⚙ -->
            <Border Classes="popover-head">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" VerticalAlignment="Center">
                    <!-- 品牌标示用 D-018 定稿应用图标本体（2026-10-24 起替换「T」字占位芯片） -->
                    <Image Grid.Column="0" Source="avares://Tokenmetry.App/Assets/app-icon.png"
                           Width="28" Height="28" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Tokenmetry" FontWeight="Bold" FontSize="13"
                               Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"
                                Margin="12,0,0,0" VerticalAlignment="Center">
                        <Ellipse Classes="popover-live-dot"
                                 Classes.active="{Binding StateClassActive}"/>
                        <TextBlock x:Name="LiveTextBlock" Text="{Binding LiveText}" FontSize="10"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   VerticalAlignment="Center"/>
                        <!-- Q-017 异常徽章：从 KPI 花费格迁头部（品牌/状态之后）——应用级警示位
                             更醒目，且不挤占本就不宽裕的 KPI 格局；Q-018：tooltip 显式挂
                             chart-tip 令牌底（Semi 默认 ToolTip 配色错配，B-006 前科），
                             内容绑定完整异常消息 -->
                        <Border Classes="popover-cost-warn-badge" IsVisible="{Binding IsCostWarn}"
                                Margin="6,0,0,0">
                            <ToolTip.Tip>
                                <ToolTip Classes="chart-tip" Content="{Binding CostWarnDetail}"/>
                            </ToolTip.Tip>
                            <TextBlock Classes="popover-cost-warn-text" Text="{Binding CostWarnBadgeText}"/>
                        </Border>
                    </StackPanel>
                    <Button Grid.Column="4" Classes="popover-icon-btn"
                            Command="{Binding OpenSettingsCommand}"
                            VerticalAlignment="Center">
                        <PathIcon Classes="app-icon"
                              Data="{StaticResource AppIconSettings}"
                              Width="15" Height="15"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Margin="16">
                <!-- 速率 banner（Q-011：只承载实时速率，Idle 隐藏；异常在头部徽章） -->
                <Border Classes="popover-banner" IsVisible="{Binding IsBannerVisible}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                        <Ellipse Grid.Column="0" Classes="popover-banner-dot"
                                 VerticalAlignment="Top" Margin="0,4,0,0"/>
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding BannerTitle}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="{Binding BannerSubtitle}" FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPI 三格 ← 原型 .stats；Q-017 偏离原型：主次字号层级（22/17）与 1.3* 主格
                     撤除——三格同字号（17）同列宽，与异常徽章迁头部（下）同批 -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="13">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Classes="popover-cap"
                                   Text="{Binding PopoverTodayTokens, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Text="{Binding TodayTokensText}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                        <TextBlock Classes="popover-cap"
                                   Text="{Binding PopoverTodayTokensCap, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="popover-cap"
                                   Text="{Binding KpiEstimatedCost, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Text="{Binding TodayCostText}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                        <TextBlock Classes="popover-cap"
                                   Text="{Binding MetaEstimateUsd, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Classes="popover-cap"
                                   Text="{Binding PopoverCacheHit, Source={x:Static loc:Translations.Instance}}"/>
                        <TextBlock Text="{Binding CacheShareText}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                        <TextBlock Classes="popover-cap"
                                   Text="{Binding PopoverCacheCaption, Source={x:Static loc:Translations.Instance}}"/>
                    </StackPanel>
                </Grid>

                <!-- Token 构成条 ← 原型 .bar（in/out/cache 三段，段宽 = 占比星号权重；
                     ColumnDefinitions 不能在 XAML 绑定，经 ProportionalColumns 附加属性翻译） -->
                <Border Height="9" CornerRadius="5" Margin="0,14,0,9" ClipToBounds="True"
                        Background="{DynamicResource AppMiniTrackBrush}">
                    <Grid c:ProportionalColumns.Shares="{Binding SegmentShares}">
                        <Border Grid.Column="0" Background="{DynamicResource AppTokenTypeInputBrush}"/>
                        <Border Grid.Column="1" Background="{DynamicResource AppTokenTypeOutputBrush}"/>
                        <Border Grid.Column="2" Background="{DynamicResource AppTokenTypeCacheBrush}"/>
                    </Grid>
                </Border>

                <!-- 构成 metric 三卡 ← 原型 .break -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                    <Border Grid.Column="0" Classes="popover-seg-card">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Classes="popover-seg-dot" Fill="{DynamicResource AppTokenTypeInputBrush}"/>
                                <TextBlock Text="{Binding LegendInput, Source={x:Static loc:Translations.Instance}}"
                                           FontSize="10" Foreground="{DynamicResource AppTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding InputTokensText}" FontSize="12"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="{Binding InputShareText}" FontSize="10" Classes="popover-cap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="popover-seg-card">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Classes="popover-seg-dot" Fill="{DynamicResource AppTokenTypeOutputBrush}"/>
                                <TextBlock Text="{Binding LegendOutput, Source={x:Static loc:Translations.Instance}}"
                                           FontSize="10" Foreground="{DynamicResource AppTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OutputTokensText}" FontSize="12"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="{Binding OutputShareText}" FontSize="10" Classes="popover-cap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="popover-seg-card">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Classes="popover-seg-dot" Fill="{DynamicResource AppTokenTypeCacheBrush}"/>
                                <TextBlock Text="{Binding PopoverSegCache, Source={x:Static loc:Translations.Instance}}"
                                           FontSize="10" Foreground="{DynamicResource AppTextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CacheTokensText}" FontSize="12"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="{Binding CacheSegShareText}" FontSize="10" Classes="popover-cap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Classes="popover-hr"/>

                <!-- 主要 Agent 区头 -->
                <Grid Margin="0,0,0,7" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding PopoverTopAgents, Source={x:Static loc:Translations.Instance}}"
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                    <Button Grid.Column="1" Classes="link-btn"
                            Content="{Binding ViewDetails, Source={x:Static loc:Translations.Instance}}"
                            Command="{Binding OpenAgentDetailsCommand}"/>
                </Grid>

                <!-- Agent Top4 行（点击 → 会话页带该 Agent 筛选） -->
                <ItemsControl ItemsSource="{Binding TopAgents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatusPopoverAgentRowViewModel">
                            <Button Classes="popover-agent-row"
                                    Command="{Binding $parent[ItemsControl].((vm:StatusPopoverViewModel)DataContext).OpenAgentRowCommand}"
                                    CommandParameter="{Binding AgentId}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" Classes="agent-chip-lg"
                                            c:AgentChip.Logo="{Binding LogoVendor}">
                                        <Panel>
                                            <TextBlock Text="{Binding Glyph}"/>
                                            <Image Classes="agent-logo"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Margin="0,1,0,0"/>
                                        <ProgressBar Classes="mini" Value="{Binding BarValue}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <!-- 修正项 2：右列单行「紧凑 tokens / 价格」（D-019），占比文案由 bar 承载 -->
                                    <TextBlock Grid.Column="2" Text="{Binding TokensCostText}" FontSize="11"
                                               TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppTextBrush}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 诚实空态（今日无数据） -->
                <TextBlock Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}"
                           IsVisible="{Binding IsNoData}" FontSize="11"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           Margin="0,4,0,0"/>

                <!-- 模型用量 Top3（D-019）：按今日已知成本降序（未知成本沉底），行右列单行
                     「紧凑 tokens / 价格」（修正项 3 与 Agent 行统一，token 副题退场），
                     回答"今天钱花在哪个模型"——Agent 维度与模型价差正交。行结构复用 Agent 行
                     （popover-agent-row 样式同吃 Semi 拉伸修复），图标槽换 model-chip-lg +
                     ModelChip.Avatar（ModelAvatarVisual 机制），行点击 → 模型统计页。
                     无数据整块隐藏（Agent 区已有诚实空态行，不重复渲染第二处）。 -->
                <StackPanel x:Name="TopModelsSection" IsVisible="{Binding HasTopModels}" Margin="0,13,0,0">
                    <TextBlock Text="{Binding PopoverTopModels, Source={x:Static loc:Translations.Instance}}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7"
                               Foreground="{DynamicResource AppTextBrush}"/>
                    <ItemsControl ItemsSource="{Binding TopModels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusPopoverModelRowViewModel">
                                <Button Classes="popover-agent-row"
                                        Command="{Binding $parent[ItemsControl].((vm:StatusPopoverViewModel)DataContext).OpenModelsCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" Classes="model-chip-lg"
                                                c:ModelChip.Avatar="{Binding Avatar}">
                                            <Panel>
                                                <TextBlock Text="{Binding Avatar.GlyphText}"/>
                                                <Image Classes="model-logo"/>
                                                <Image Classes="model-avatar"
                                                       Source="{Binding Avatar.ImageDataUri, Converter={x:Static c:DataUriImageConverter.Instance}}"/>
                                                <PathIcon Classes="app-icon model-fallback"
                                                          Data="{StaticResource AppIconCircleHelp}"/>
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource AppTextBrush}"/>
                                            <ProgressBar Classes="mini" Value="{Binding BarValue}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TokensCostText}" FontSize="11"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AppTextBrush}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Classes="popover-hr"/>

                <!-- footer：最近会话 → 会话页（修正项 5）/ 打开完整统计 → 总览页（主按钮） -->
                <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="7">
                    <Button Grid.Column="0" Classes="popover-btn"
                            Content="{Binding PopoverRecentSessions, Source={x:Static loc:Translations.Instance}}"
                            Command="{Binding OpenRecentSessionsCommand}"/>
                    <Button Grid.Column="1" Classes="popover-btn primary"
                            Content="{Binding PopoverOpenStats, Source={x:Static loc:Translations.Instance}}"
                            Command="{Binding OpenStatsCommand}"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
