<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- D-016：macOS 托盘 interop（MacTrayInterop）用函数指针做动态 ObjC 类的 IMP -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- D-018：应用图标 .ico（全出血多尺寸）→ Windows exe 文件 / 固定任务栏图标；
         app-icon.png（Apple 网格）与 app-icon-window.png（全出血 256）分别供 macOS
         Dock interop 与 Window.Icon（App.axaml.cs / MainWindow 构造器）。 -->
    <ApplicationIcon>Assets/app-icon.ico</ApplicationIcon>
    <!-- 版本唯一事实：发版 tag = v{本值}（scripts/release.sh 改这里并打 tag、CI 校验两者一致），
         应用内更新检查以程序集版本为比较基线（UpdateChecker.CurrentVersion）。三段数字。 -->
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <!-- Q-002：Avalonia.Controls.DataGrid / Semi.Avalonia.DataGrid 随 TrendSpike(D-002) 临时页移除
         （生产视图不再使用 DataGrid，App.axaml 的 DataGridSemiTheme 一并撤下）。 -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Irihi.Avalonia.Shared" Version="0.5.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tokenmetry.Core\Tokenmetry.Core.csproj" />
    <ProjectReference Include="..\Tokenmetry.Infrastructure\Tokenmetry.Infrastructure.csproj" />
  </ItemGroup>

  <!-- A-0：托盘图标资产（彩色版通用；-template 单色版 macOS 状态栏模板图标，跟随明暗自动反色） -->
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- D-008：headless 页面层测试需要访问 VM 的 internal 测试对账入口（防抖提交钩子 /
       Agent 范围解析 / 查询映射构造器等，与 OverviewViewModel "internal 供测试对账" 同纪律）。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tokenmetry.App.Headless.Tests" />
    <InternalsVisibleTo Include="Tokenmetry.App.Tests" />
  </ItemGroup>
</Project>
