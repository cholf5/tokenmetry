<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:Tokenmetry.App.Controls"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Controls.DonutChart">
    <!-- D-005 环形图控件（原型 .donutrow：左环 + 右图例）。几何为自绘 StreamGeometry 圆弧段
         （Avalonia 无内置 Arc），中心标题/副标题 Grid 叠层；颜色走 I-027 令牌，明暗由
         DynamicResource 自动翻转（纯 Avalonia 绘制，无需手工重建）。
         根布局用 Grid（Auto,*）而非横向 StackPanel：横向 StackPanel 以无限宽测量子级，
         图例行（8,*,Auto）会按名字全宽展开溢出面板；Grid 的 * 列把图例约束在环右侧剩余宽度内。 -->
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
        <!-- 环 + 中心文字（尺寸由 DonutSize 驱动，原型 142px） -->
        <Panel x:Name="DonutHost" Grid.Column="0" Width="142" Height="142" VerticalAlignment="Center">
            <Canvas x:Name="ArcCanvas" Width="142" Height="142"/>
            <!-- 空数据占位环（与弧段同厚度，令牌灰；尺寸/厚度在重建时代码对齐） -->
            <Ellipse x:Name="EmptyRing"
                     Width="125" Height="125"
                     Stretch="None"
                     Stroke="{DynamicResource AppPanelAltBrush}"
                     StrokeThickness="13"
                     IsVisible="False"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="1"
                        IsHitTestVisible="False">
                <TextBlock x:Name="CenterTitleText"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextBrush}"
                           TextAlignment="Center"/>
                <TextBlock x:Name="CenterSubtitleText"
                           FontSize="11"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           TextAlignment="Center"/>
            </StackPanel>
        </Panel>

        <!-- 图例列表（原型 .legendlist/.legendrow：swatch + name + 百分比） -->
        <ItemsControl x:Name="LegendList" Grid.Column="1" VerticalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="c:DonutLegendItem">
                    <Grid ColumnDefinitions="8,*,Auto" ColumnSpacing="7" Margin="0,5">
                        <Border Grid.Column="0"
                                Width="7" Height="7"
                                CornerRadius="3"
                                VerticalAlignment="Center"
                                Background="{Binding Brush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding PercentText}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextBrush}"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空数据只由环心副题承载（"暂无数据"）：右侧再放一条同义文案会在同一面板里说两遍，
             且与图例列争宽。图例列保持空（Auto 列宽归零）。 -->
    </Grid>
</UserControl>
