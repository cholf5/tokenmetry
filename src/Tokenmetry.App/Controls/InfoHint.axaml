<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Tokenmetry.App.Controls"
             x:Class="Tokenmetry.App.Controls.InfoHint"
             x:Name="Root"
             x:DataType="controls:InfoHint">
    <!-- 设置项悬停说明：轻量 ⓘ + ToolTip 承载原本常驻在每项下方的小字（S-004 版面收口）。
         图标只是悬停靶（21×21 命中区，Cursor=Help），说明文字挂在 ToolTip 里折行显示；
         外观全部走 SharedStyles 的 setting-info / setting-tip 令牌类。 -->
    <Border Classes="setting-info">
        <ToolTip.Tip>
            <ToolTip Classes="setting-tip">
                <TextBlock Classes="setting-tip-text" Text="{Binding Hint, ElementName=Root}"/>
            </ToolTip>
        </ToolTip.Tip>
        <PathIcon Classes="app-icon setting-info-icon"/>
    </Border>
</UserControl>
