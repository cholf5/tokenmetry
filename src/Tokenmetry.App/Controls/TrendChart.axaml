<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sp="using:ScottPlot.Avalonia"
             xmlns:loc="using:Tokenmetry.App.Localization"
             mc:Ignorable="d"
             x:Class="Tokenmetry.App.Controls.TrendChart">
    <!-- D-004 正式趋势图控件：三种形态共用一个 AvaPlot（绘图代码集中在 code-behind，D-002 结论）。
         数据经样式属性传入（Mode / DailyPoints / HourlyDistribution），控件自身无 DataContext 依赖。
         ScottPlot 不吃 Avalonia DynamicResource —— 图表 chrome 色在每次 RebuildPlot 时按当前
         ActualThemeVariant 从 Tokens.axaml 令牌现取，主题变更经 ActualThemeVariantChanged 触发重建。 -->
    <Panel>
        <sp:AvaPlot x:Name="PlotControl"
                    PointerMoved="OnPlotPointerMoved"
                    PointerExited="OnPlotPointerExited"/>
        <!-- 诚实空态：无数据点 / 双端有界窗口全补零（IsEffectivelyEmpty）时覆盖提示（不画伪零线） -->
        <StackPanel x:Name="EmptyState"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="4"
                    IsVisible="False">
            <TextBlock Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       TextAlignment="Center"/>
            <TextBlock Text="{Binding NoUsageInRange, Source={x:Static loc:Translations.Instance}}"
                       FontSize="11"
                       Foreground="{DynamicResource AppMutedTextBrush}"
                       TextAlignment="Center"/>
        </StackPanel>
        <!-- 悬停浮窗（motion design）：Avalonia 层浮层替代 ScottPlot 自绘 Tooltip。
             X = 数据点锚点（ComputeTooltipOrigin：右偏 14px、右半翻转、数据区夹回）不随鼠标；
             Y 跟随光标上下（SmoothDamp 临界阻尼弹簧，加速+刹车）。DispatcherTimer 16ms 步进：
             X 换点 lerp 滑行、Y 弹簧跟随；显隐走 SharedStyles chart-hovertip 的 Opacity transition。
             IsHitTestVisible=False 不挡图表交互。 -->
        <Border x:Name="HoverTip"
                Classes="chart-hovertip"
                IsHitTestVisible="False"
                IsVisible="False">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <!-- Foreground/FontSize 直接落在 TextBlock 本地（元素值 > Semi 全局默认样式）：
                 与 chart-tip 同源（AppTextBrush + 12px）。TextElement 附加属性经 Border 继承
                 实测会被 Semi 的 TextBlock 默认样式盖过，故不设在 Border 样式上。 -->
            <TextBlock x:Name="HoverTipText" TextWrapping="NoWrap"
                       Foreground="{DynamicResource AppTextBrush}"
                       FontSize="12"/>
        </Border>
    </Panel>
</UserControl>
