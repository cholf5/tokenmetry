    <!-- loader-circle -->
    <StreamGeometry x:Key="AppIconLoaderCircle">M21 12a9 9 0 1 1-6.219-8.56</StreamGeometry>
    <!-- coins -->
    <StreamGeometry x:Key="AppIconCoins">M13.744 17.736a6 6 0 1 1-7.48-7.48 M15 6h1v4 M6.134 14.768 l.866-.5 2 3.464 M 10 8 a 6 6 0 1 0 12 0 a 6 6 0 1 0 -12 0</StreamGeometry>
    <!-- zap -->
    <StreamGeometry x:Key="AppIconZap">M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z</StreamGeometry>
    <!-- hard-drive-upload -->
    <StreamGeometry x:Key="AppIconHardDriveUpload">M16 6 l-4-4-4 4 M12 2v8 M 4 14 H 20 A 2 2 0 0 1 22 16 V 20 A 2 2 0 0 1 20 22 H 4 A 2 2 0 0 1 2 20 V 16 A 2 2 0 0 1 4 14 Z M6 18h.01 M10 18h.01</StreamGeometry>
    <!-- hard-drive-download -->
    <StreamGeometry x:Key="AppIconHardDriveDownload">M12 2v8 M16 6 l-4 4-4-4 M 4 14 H 20 A 2 2 0 0 1 22 16 V 20 A 2 2 0 0 1 20 22 H 4 A 2 2 0 0 1 2 20 V 16 A 2 2 0 0 1 4 14 Z M6 18h.01 M10 18h.01</StreamGeometry>
    <!-- circle-help -->
    <StreamGeometry x:Key="AppIconCircleHelp">M 2 12 a 10 10 0 1 0 20 0 a 10 10 0 1 0 -20 0 M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3 M12 17h.01</StreamGeometry>
    <!-- x -->
    <StreamGeometry x:Key="AppIconClose">M18 6 6 18 M6 6 l12 12</StreamGeometry>
    <!-- arrow-up / arrow-down（成本分析页「输入成本占比 / 输出成本占比」卡，2026-10-29）：
         替换原 ↓ / ↑ 文本字形（同 I-040 的字形回退问题）。lucide 1.61.0 同名图标路径，
         生成器 ICONS 已登记；离线环境按生成规则落盘，联网重跑结果一致。 -->
    <StreamGeometry x:Key="AppIconArrowUp">M5 12 l7-7 7 7 M12 19V5</StreamGeometry>
    <StreamGeometry x:Key="AppIconArrowDown">M12 5v14 M19 12 l-7 7-7-7</StreamGeometry>

</ResourceDictionary>
