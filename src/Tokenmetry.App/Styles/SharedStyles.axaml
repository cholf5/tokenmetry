<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        I-027 共享样式：原型选择器的 Avalonia 对应物，视图用 Classes="..." 引用。
        类名对齐原型 CSS 类（card/panel/kpi/chip/page-title/panel-title/link-btn/mini），
        令牌一律 DynamicResource 引用 Styles/Tokens.axaml，视图内禁止再写硬编码色值。
        规范见 docs/design/design-tokens.md。
    -->

    <!-- 卡片表面 ← 原型 .kpi,.panel{background:linear-gradient(145deg,…);border:1px solid #22324a;border-radius:11px} -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
    </Style>

    <!-- 面板 = 卡片表面 + 15px 内边距（自足，无需再连用 card）← 原型 .panel{padding:15px} -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="15"/>
    </Style>

    <!-- KPI 卡 = 卡片表面 + 原型 .kpi{padding:15px 15px 13px;min-height:124px}（自足） -->
    <Style Selector="Border.kpi">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="15,15,13,13"/>
        <Setter Property="MinHeight" Value="124"/>
    </Style>

    <!-- KPI 卡顶标签 ← 原型 .kpi-top{color:#b7c5d9;font-size:12px}（D-006） -->
    <Style Selector="TextBlock.kpi-top">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AppKpiTitleBrush}"/>
    </Style>

    <!-- KPI 主数值 ← 原型 .kpi-value{font-size:25px;font-weight:700;letter-spacing:-.6px;margin:8px 0 4px;white-space:nowrap} -->
    <Style Selector="TextBlock.kpi-value">
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LetterSpacing" Value="-0.6"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    </Style>

    <!-- KPI 脚注 ← 原型 .kpi-foot{font-size:11px;color=muted 变量} -->
    <Style Selector="TextBlock.kpi-foot">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>

    <!-- KPI 环比箭头 ← 原型 .kpi-foot 的 .up=var green / .down=var red（D-006）。
         颜色复用 :root 强调色令牌（AppAccentGreen/RedBrush 与 green/red 变量同源）；
         箭头态经 Classes.kpi-change-up/down/flat 类绑定切换，平/无对比用 muted。
         注意必须排在 kpi-foot 之后：同为单类选择器，后声明的 Foreground 覆盖脚注底色。 -->
    <Style Selector="TextBlock.kpi-change-up">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentGreenBrush}"/>
    </Style>
    <Style Selector="TextBlock.kpi-change-down">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentRedBrush}"/>
    </Style>
    <Style Selector="TextBlock.kpi-change-flat">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>

    <!-- 页面标题 ← 原型 .pagehead h1{font-size:21px;font-weight:650;letter-spacing:-.4px} -->
    <Style Selector="TextBlock.page-title">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LetterSpacing" Value="-0.4"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    </Style>

    <!-- 页面副标题 ← 原型 .subtitle{color: muted 变量; font-size:12px} -->
    <Style Selector="TextBlock.page-subtitle">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>

    <!-- 面板标题 ← 原型 .panelhead h2{font-size:13px;font-weight:650} -->
    <Style Selector="TextBlock.panel-title">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    </Style>

    <!-- 链接按钮 ← 原型 .linkbtn{color:#80adff;font-size:11px;border:0;background:none} -->
    <Style Selector="Button.link-btn">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppLinkBrush}"/>
    </Style>

    <!-- chip 标签 ← 原型 .chip{padding:3px 7px;border-radius:5px;background:#1b2c44;color:#a8c8ff;font-size:10px}
         用在 Border 上（TextBlock 无 CornerRadius），文字颜色经附加属性继承给子 TextBlock。 -->
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppChipTextBrush}"/>
        <Setter Property="TextBlock.FontSize" Value="10"/>
    </Style>

    <!-- filter-chip（模型目录筛选）：Semi ToggleButton 收敛为 .chip 的小号标签观感，选中态用导航强调色 -->
    <Style Selector="ToggleButton.filter-chip">
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppChipTextBrush}"/>
    </Style>
    <Style Selector="ToggleButton.filter-chip:checked">
        <Setter Property="Background" Value="{DynamicResource AppNavActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}"/>
    </Style>
    <!-- Semi 的 ToggleButton 模板在 :pointerover / :pressed 伪类下直写模板内 ContentPresenter 的
         背景（ButtonSolidPrimaryPointeroverBackground 等），优先级高于控件级 Background setter——
         不反制的话，选中 chip 悬停/按压会闪现主题主色。模板级选择器把四态全部钉在同一组令牌上。 -->
    <Style Selector="ToggleButton.filter-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppChipTextBrush}"/>
    </Style>
    <Style Selector="ToggleButton.filter-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppChipTextBrush}"/>
    </Style>
    <Style Selector="ToggleButton.filter-chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}"/>
    </Style>
    <Style Selector="ToggleButton.filter-chip:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppNavActiveBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}"/>
    </Style>

    <!-- 图标软色底容器 ← 原型 .kpi-icon{width:30px;height:30px;border-radius:9px;…;font-size:15px}，
         背景/前景色由使用处按变体给 AppIconChip{Hue}BackgroundBrush / ForegroundBrush -->
    <Style Selector="Border.icon-chip">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="TextBlock.FontSize" Value="15"/>
    </Style>
    <!-- Border 无内容对齐属性：图标字形经子选择器居中 -->
    <Style Selector="Border.icon-chip > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Agent 图标槽（I-034，原 D-008 的「chip-* 四色软色底 + 散列字形」退场）：
         行内官方品牌 logo（AppAgentLogo* DrawingImage，生成自 lobe-icons，与模型图标同机制），
         未覆盖的 Agent（Codebuff / Droid / pi-agent 及命名存储）保留散列字形兜底（中性前景随明暗翻转）。
         两种槽位：agent-chip = 16×16 透明行内槽（会话明细 Agent 列，对齐 model-chip 行高）；
         agent-chip-lg = 30×30 圆角 9 中性软底（Agent 统计页 KPI 卡 / 右栏最近会话行，保留原型 .kpi-icon
         的视觉锚点，但底色改中性——原散列色对一个 Agent 无语义）。品牌伪类经附加属性
         AgentChip.Logo 驱动。（同 ModelChip 机制）。logo 源一律 DynamicResource——单色官方标按明暗
         给出黑/白两套（AgentLogos.axaml 的 ThemeDictionaries），其余 color 版两主题同值。 -->
    <Style Selector="Border.agent-chip">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="TextBlock.FontSize" Value="11"/>
        <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppIconChipNeutralForegroundBrush}"/>
    </Style>
    <Style Selector="Border.agent-chip-lg">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{DynamicResource AppIconChipNeutralBackgroundBrush}"/>
        <Setter Property="TextBlock.FontSize" Value="15"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppIconChipNeutralForegroundBrush}"/>
    </Style>
    <!-- 字形（散列兜底）默认隐藏，仅 generic 显示；logo 同理仅命中品牌伪类时显示。 -->
    <Style Selector="Border.agent-chip TextBlock, Border.agent-chip-lg TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.agent-generic TextBlock">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-chip Image.agent-logo">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.agent-chip-lg Image.agent-logo">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.agent-claudecode Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoClaudeCode}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-codex Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoCodex}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-geminicli Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoGeminiCli}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-amp Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoAmp}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-openclaw Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoOpenClaw}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-qwen Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoQwen}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-kimi Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoKimi}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-goose Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoGoose}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-opencode Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoOpenCode}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-kilo Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoKilo}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-hermes Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoHermes}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-grok Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoGrok}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-antigravity Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoAntigravity}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-copilot Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoCopilot}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-zai Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoZai}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.agent-dsh Image.agent-logo">
        <Setter Property="Source" Value="{DynamicResource AppAgentLogoDsh}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- generic：无 lobe 对应，不设 logo 规则——Image 保持隐藏、字形兜底（诚实回退） -->

    <!-- 模型图标（ModelVisualMap/ModelChip）：行内官方品牌 logo（AppModelLogo* DrawingImage，
         生成自 lobe-icons，无色块），phi/未识别厂商保留字形兜底（中性前景随明暗翻转）。
         尺寸对齐 11px 表格行高（16×16）；厂商伪类经附加属性 ModelChip.Vendor 驱动（同 AgentChip
         机制）。logo 源一律 DynamicResource——openai/grok 的单色官方标按明暗给出黑/白两套
         （ModelLogos.axaml 的 ThemeDictionaries），其余 color 版两主题同值。 -->
    <Style Selector="Border.model-chip">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="TextBlock.FontSize" Value="11"/>
        <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource AppIconChipNeutralForegroundBrush}"/>
    </Style>
    <!-- 字形（Φ/◇）默认隐藏，仅 phi/generic 显示；logo 同理仅命中厂商伪类时显示。 -->
    <Style Selector="Border.model-chip TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.model-phi TextBlock, Border.model-generic TextBlock">
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-chip Image.model-logo">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border.model-claude Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoClaude}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-openai Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoOpenAI}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-gemini Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoGemini}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-glm Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoGlm}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-deepseek Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoDeepSeek}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-qwen Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoQwen}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-kimi Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoKimi}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-llama Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoLlama}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-grok Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoGrok}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-mistral Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoMistral}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-doubao Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoDoubao}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-minimax Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoMiniMax}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-cohere Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoCohere}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-ernie Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoErnie}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border.model-hunyuan Image.model-logo">
        <Setter Property="Source" Value="{DynamicResource AppModelLogoHunyuan}"/>
        <Setter Property="IsVisible" Value="True"/>
    </Style>
    <!-- phi / generic：无 lobe 对应，不设 logo 规则——Image 保持隐藏、字形兜底（诚实回退） -->



    <!-- 图例/表格圆点 ← 原型 .modeldot{width:7px;height:7px;border-radius:3px}，颜色由使用处给 AppSeries{N}Brush -->
    <Style Selector="Border.series-dot">
        <Setter Property="Width" Value="7"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="CornerRadius" Value="3"/>
    </Style>

    <!-- mini 进度条 ← 原型 .mini-track{height:4px;background:#23334b;border-radius:5px} + .mini-fill{linear-gradient(90deg,#3e7df0,#65b9ff)}。
         复用内置 ProgressBar：PART_Track / PART_Indicator 由 ProgressBar 自身代码按 Value(0-100) 计算宽度，
         此处仅替换模板外观；类选择器优先级高于 Semi 的 ControlTheme，模板会被本样式覆盖。 -->
    <Style Selector="ProgressBar.mini">
        <Setter Property="Height" Value="4"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Template">
            <ControlTemplate TargetType="ProgressBar">
                <Border x:Name="PART_Track"
                        Background="{DynamicResource AppMiniTrackBrush}"
                        CornerRadius="5"
                        ClipToBounds="True">
                    <Border x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AppMiniFillBrush}"
                            CornerRadius="5"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- 预览表（D-007 模型分布 / 项目排行）← 原型 .table{font-size:11px}：
         th{color:muted;font-weight:500} / td{color:#c8d4e5（原型表体色；此处用 AppTextBrush #e8eef9 略亮于原型，可读性优先，如需逐像素还原可补专用令牌）} / td.num{text-align:right;tabular-nums} -->
    <Style Selector="TextBlock.table-th">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.table-td">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    </Style>
    <Style Selector="TextBlock.table-num">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
    </Style>
    <!-- 表格空态 ← 原型 .empty{padding:20px;color:var muted;text-align:center} -->
    <Style Selector="TextBlock.table-empty">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0,16"/>
    </Style>

    <!-- 数据表列表（Q-002 跨页统一）：Agent/模型/项目排行与会话明细共用一套 ListBox 行配方
         （收编自 4 个页面的局部副本，原类名 rank-table / session-table 统一为 data-table）。
         行 hover ← 原型 tr:hover{background:#17253a}：Dark 经 AppNavHoverBackgroundBrush（同源令牌，
         与外壳导航 hover 一致），Light 用其协调值；透明 ListBox 本体、行内距与圆角同原配方。
         行顶分隔线与单元格令牌（table-th/td/num）仍在各页行模板里。 -->
    <Style Selector="ListBox.data-table">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.data-table ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,8"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBox.data-table ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}"/>
    </Style>

    <!-- 数据源表状态色（S-002，原型 .up 为绿色 / ● 部分数据 为橙色）：
         未检出 / 尚未扫描用 muted（无数据的源不做绿色假象）。颜色复用 :root 强调色令牌
         （AppAccentGreen/OrangeBrush 与原型 green/orange 变量同源）；行 VM 的 Is* 布尔经
         Classes 条件绑定切换（同 kpi-change-* 模式）。必须排在 table-td 之后：
         同为单类选择器，后声明的 Foreground 覆盖表体底色。 -->
    <Style Selector="TextBlock.status-ok">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentGreenBrush}"/>
    </Style>
    <Style Selector="TextBlock.status-partial">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentOrangeBrush}"/>
    </Style>
    <Style Selector="TextBlock.status-nodata">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>
    <!-- A-6：源扫描抛异常被逐源隔离后的诚实失败态（红），区别于"部分数据"（橙）与"未检出"（灰） -->
    <Style Selector="TextBlock.status-error">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentRedBrush}"/>
    </Style>
    <Style Selector="TextBlock.status-pending">
        <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
    </Style>

    <!-- 图表悬浮提示（B-006）：DonutChart/Heatmap 的 ToolTip 统一挂 chart-tip 类（ChartTooltips.Set）。
         Semi 12.1 默认 ToolTip 配色错配且不随本应用令牌（Light 浅底白字 / Dark 深底黑字，均不可读），
         这里换成本应用令牌：chip 底 + 卡片描边 + 正文文字色；圆角 6 / 内距 10,7 / 字号 12 与
         TrendChart 的 ScottPlot 气泡（ApplyTooltipChrome，令牌相同）在两套悬浮面上观感一致。
         边距/圆角/字号跟随原型弹层语汇，配色必须用令牌（DynamicResource 随明暗翻转）。 -->
    <Style Selector="ToolTip.chart-tip">
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 图表悬停浮窗（motion design）：TrendChart 内的 Avalonia 浮层，与 chart-tip 同源令牌；
         位置由 code-behind 每帧插值（点间平滑移动 / 纵向跟随），显隐只做 120ms 淡入淡出；
         IsHitTestVisible=False 由元素自带，浮层不挡图表交互。 -->
    <Style Selector="Border.chart-hovertip">
        <Setter Property="Background" Value="{DynamicResource AppChipBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,7"/>
        <!-- 左上锚定：code-behind 以浮窗左上角像素位（ComputeTooltipOrigin）驱动
             RenderTransform，拉伸对齐会让整卡背景铺满图表 -->
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Opacity" Value="0"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/>
            </Transitions>
        </Setter>
    </Style>

</Styles>
