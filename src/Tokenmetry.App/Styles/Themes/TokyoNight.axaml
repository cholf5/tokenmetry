<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tokenmetry.App.Styles.Themes.TokyoNight">

<!--
    TokyoNight 画板（Dark）：ThemeService 按 settings.ThemePalette 运行期换入。
    Tokyo Night 官方色板（github.com/folke/tokyonight.nvim）：Night 主题 bg #1a1b26、bg_dark #16161e、bg_highlight #292e42、fg #c0caf5、fg_dark #a9b1d6 + 六强调色。
    由 scripts/generate-theme-palettes.py 生成，勿手改；改色请改脚本内画板定义后重跑。
    x:Class = 编译期 XAML + 同名 code-behind（ThemeService 类型化实例化）；不要去掉——
    运行期 AvaloniaXamlLoader.Load(Uri) 带 RequiresUnreferencedCode，AOT 发布直接 IL2026。
-->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- TokyoNight Dark：Tokyo Night 官方色板（github.com/folke/tokyonight.nvim）：Night 主题 bg #1a1b26、bg_dark #16161e、bg_highlight #292e42、fg #c0caf5、fg_dark #a9b1d6 + 六强调色。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报表面吃画板，但专用可视化令牌与数据语义色全画板恒定，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1a1b26"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#24283b"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#292e42"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#3b4261"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#c0caf5"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#a9b1d6"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#7aa2f7"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#7dcfff"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#bb9af7"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#9ece6a"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#ff9e64"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#f7768e"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#20222f" Offset="0"/>
                <GradientStop Color="#1c1e2a" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#2f334d"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#7aa2f7"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#272e43"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#7aa2f7"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#292e42"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#a9b1d6"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#333e5c"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#8daff8"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#563d36"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#ff9e64"/>
            <SolidColorBrush x:Key="AppIconChipPurpleBackgroundBrush" Color="#443c5c"/>
            <SolidColorBrush x:Key="AppIconChipPurpleForegroundBrush" Color="#c1a3f8"/>
            <SolidColorBrush x:Key="AppIconChipGreenBackgroundBrush" Color="#3c4a38"/>
            <SolidColorBrush x:Key="AppIconChipGreenForegroundBrush" Color="#9ece6a"/>
            <SolidColorBrush x:Key="AppIconChipNeutralBackgroundBrush" Color="#373949"/>
            <SolidColorBrush x:Key="AppIconChipNeutralForegroundBrush" Color="#b9c2ec"/>
            <!-- 侧栏 -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#16161e"/>
            <!-- 顶栏 -->
            <SolidColorBrush x:Key="AppTopbarBackgroundBrush" Color="#171823"/>
            <!-- 导航前景（未选中） -->
            <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#a9b1d6"/>
            <!-- 导航选中底 -->
            <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#2e3450"/>
            <!-- 导航选中字 -->
            <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#7aa2f7"/>
            <!-- 导航指示条 -->
            <SolidColorBrush x:Key="AppNavActiveIndicatorBrush" Color="#7aa2f7"/>
            <!-- 导航悬停底 -->
            <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#222436"/>
            <!-- 导航静息（同 hover RGB 的 0 alpha，BrushTransition 起点） -->
            <SolidColorBrush x:Key="AppNavRestBackgroundBrush" Color="#00222436"/>
            <!-- 图表网格 -->
            <SolidColorBrush x:Key="AppChartGridLineBrush" Color="#252a3f"/>
            <!-- 图表轴线 -->
            <SolidColorBrush x:Key="AppChartAxisLineBrush" Color="#343b58"/>
            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e61a1b26"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#232842"/>
            <!-- banner 活动线 -->
            <SolidColorBrush x:Key="AppBannerActiveLineBrush" Color="#3b4261"/>
            <!-- banner 告警底 -->
            <SolidColorBrush x:Key="AppBannerWarnBackgroundBrush" Color="#3a3024"/>
            <!-- banner 告警线 -->
            <SolidColorBrush x:Key="AppBannerWarnLineBrush" Color="#6b5836"/>
            <!-- 滚动条滑块 -->
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#3f4667"/>
            <!-- 滚动条悬停 -->
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#565f89"/>
            <!-- 品牌色表面文字（恒白） -->
            <SolidColorBrush x:Key="AppOnBrandForegroundBrush" Color="#ffffff"/>
            <!-- 弹窗毛玻璃面（panel 90% 不透明） -->
            <SolidColorBrush x:Key="AppPopoverCardBackgroundBrush" Color="#e624283b"/>
            <!-- 弹窗外投影色 -->
            <Color x:Key="AppPopoverShadowColor">#000000</Color>
            <!-- Semi 控件别名键覆盖：Semi.Avalonia v12.1 的控件 ControlTheme 只消费控件别名键（Themes/{Light,Dark}/{Control}.axaml 用 StaticResource 烤死的语义值），覆盖别名键是 Semi 原生控件跟随本画板的唯一通道；对 design-tokens.md §1「Semi* 禁止覆盖」的有意识例外（覆盖既有键、非新增键）。白名单 = 应用实际使用的控件族，逐键核对自 v12.1.0.1 源码；语义值由画板主值派生。 -->
            <SolidColorBrush x:Key="WindowDefaultBackground" Color="#1a1b26"/>
            <SolidColorBrush x:Key="WindowDefaultForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="DefaultForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="TextBoxTextCaretBrush" Color="#c0caf5"/>
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#222430"/>
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#303241"/>
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="TextBoxForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#a9b1d6"/>
            <SolidColorBrush x:Key="TextBoxInnerForeground" Color="#a9b1d6"/>
            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#262734"/>
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#656a83"/>
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="#222430"/>
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="#aac4fa"/>
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#ffffff"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#222430"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPlaceHolderForeground" Color="#a9b1d6"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#303241"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="#262734"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBorderBrush" Color="#262734"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="#a9b1d6"/>
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="#656a83"/>
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#656a83"/>
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#24283b"/>
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#3b4261"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#222430"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#222430"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#3a466a"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#3f4d74"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedDisabledBackground" Color="#262734"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedBorderBrush" Color="#3b4261"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" Color="#aac4fa"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#aac4fa"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush" Color="#dae5fd"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBackground" Color="#24283b"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBorderBrush" Color="#3b4261"/>
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#656a83"/>
            <SolidColorBrush x:Key="CheckBoxGlyphFill" Color="#ffffff"/>
            <SolidColorBrush x:Key="CheckBoxDefaultBorderBrush" Color="#707590"/>
            <SolidColorBrush x:Key="CheckBoxPointeroverBackground" Color="#222430"/>
            <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="CheckBoxPressedBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="CheckBoxPressedBorderBrush" Color="#dae5fd"/>
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground" Color="#aac4fa"/>
            <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush" Color="#aac4fa"/>
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground" Color="#dae5fd"/>
            <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush" Color="#dae5fd"/>
            <SolidColorBrush x:Key="CheckBoxDefaultDisabledBackground" Color="#262734"/>
            <SolidColorBrush x:Key="CheckBoxDefaultDisabledBorderBrush" Color="#3b4261"/>
            <SolidColorBrush x:Key="CheckBoxCheckedDisabledBackground" Color="#455884"/>
            <SolidColorBrush x:Key="CheckBoxCheckedDisabledBorderBrush" Color="#455884"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedBackground" Color="#3a466a"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedDisabledBorderBrush" Color="#455884"/>
            <SolidColorBrush x:Key="CheckBoxCardPointeroverBackground" Color="#222430"/>
            <SolidColorBrush x:Key="CheckBoxCardPressedBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#aac4fa"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#dae5fd"/>
            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#7dcfff"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#b7c0e9"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#1a1b26"/>
            <SolidColorBrush x:Key="FlyoutBackground" Color="#24283b"/>
            <SolidColorBrush x:Key="FlyoutForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#3b4261"/>
            <SolidColorBrush x:Key="ListBoxItemDisabledForeground" Color="#656a83"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#222430"/>
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#292b39"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#3a466a"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#3f4d74"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedDisabledBackground" Color="#262734"/>
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#3b4261"/>
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#24283b"/>
            <SolidColorBrush x:Key="NotificationCardInformationIconForeground" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="NotificationCardSuccessIconForeground" Color="#9ece6a"/>
            <SolidColorBrush x:Key="NotificationCardWarningIconForeground" Color="#ff9e64"/>
            <SolidColorBrush x:Key="NotificationCardErrorIconForeground" Color="#f7768e"/>
            <SolidColorBrush x:Key="NotificationCardTitleForeground" Color="#c0caf5"/>
            <SolidColorBrush x:Key="NotificationCardMessageForeground" Color="#b7c0e9"/>
            <SolidColorBrush x:Key="NotificationCardLightInformationBorderBrush" Color="#7aa2f7"/>
