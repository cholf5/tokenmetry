            <SolidColorBrush x:Key="NotificationCardLightSuccessBorderBrush" Color="#9ece6a"/>
            <SolidColorBrush x:Key="NotificationCardLightSuccessBackground" Color="#425247"/>
            <SolidColorBrush x:Key="NotificationCardLightWarningBorderBrush" Color="#ff9e64"/>
