            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBackground" Color="#624258"/>
            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBorderBrush" Color="#624258"/>
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#7aa2f7"/>
            <SolidColorBrush x:Key="ButtonDefaultSecondaryForeground" Color="#7dcfff"/>
            <SolidColorBrush x:Key="ButtonDefaultTertiaryForeground" Color="#b7c0e9"/>
            <SolidColorBrush x:Key="ButtonDefaultSuccessForeground" Color="#9ece6a"/>
