            <SolidColorBrush x:Key="NotificationCardLightSuccessBorderBrush" Color="#98bb6c"/>
            <SolidColorBrush x:Key="NotificationCardLightSuccessBackground" Color="#464e44"/>
            <SolidColorBrush x:Key="NotificationCardLightWarningBorderBrush" Color="#ffa066"/>
            <SolidColorBrush x:Key="NotificationCardLightWarningBackground" Color="#5f4843"/>
            <SolidColorBrush x:Key="NotificationCardLightErrorBorderBrush" Color="#e6717e"/>
            <SolidColorBrush x:Key="NotificationCardLightErrorBackground" Color="#593c49"/>
            <SolidColorBrush x:Key="DataValidationErrorsForeground" Color="#e6717e"/>
            <SolidColorBrush x:Key="DataValidationErrorsBackground" Color="#593c49"/>
            <SolidColorBrush x:Key="DataValidationErrorsBorderBrush" Color="#593c49"/>
            <SolidColorBrush x:Key="DataValidationErrorsPointeroverBackground" Color="#624250"/>
            <SolidColorBrush x:Key="DataValidationErrorsPointeroverBorderBrush" Color="#624250"/>
            <SolidColorBrush x:Key="DataValidationErrorsPressedBackground" Color="#6b4858"/>
            <SolidColorBrush x:Key="DataValidationErrorsPressedBorderBrush" Color="#6b4858"/>
