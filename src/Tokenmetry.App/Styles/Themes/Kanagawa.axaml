            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBackground" Color="#624250"/>
            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBorderBrush" Color="#624250"/>
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#7e9cd8"/>
            <SolidColorBrush x:Key="ButtonDefaultSecondaryForeground" Color="#7fb4ca"/>
            <SolidColorBrush x:Key="ButtonDefaultTertiaryForeground" Color="#d4ceaa"/>
            <SolidColorBrush x:Key="ButtonDefaultSuccessForeground" Color="#98bb6c"/>
            <SolidColorBrush x:Key="ButtonDefaultWarningForeground" Color="#ffa066"/>
