            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBorderBrush" Color="#6a6170"/>
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#9cb5ce"/>
            <SolidColorBrush x:Key="ButtonDefaultSecondaryForeground" Color="#88c0d0"/>
            <SolidColorBrush x:Key="ButtonDefaultTertiaryForeground" Color="#d0d6df"/>
