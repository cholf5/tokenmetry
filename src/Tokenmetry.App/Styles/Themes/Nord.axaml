            <SolidColorBrush x:Key="CheckBoxCardCheckedBackground" Color="#535f71"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush" Color="#9cb5ce"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedDisabledBorderBrush" Color="#606e80"/>
            <SolidColorBrush x:Key="CheckBoxCardPointeroverBackground" Color="#383d49"/>
            <SolidColorBrush x:Key="CheckBoxCardPressedBackground" Color="#3f4550"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#bfcfdf"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#e1e8f0"/>
            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#9cb5ce"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#88c0d0"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#d0d6df"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#eceff4"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#2e3440"/>
            <SolidColorBrush x:Key="FlyoutBackground" Color="#3b4252"/>
            <SolidColorBrush x:Key="FlyoutForeground" Color="#eceff4"/>
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#4c566a"/>
            <SolidColorBrush x:Key="ListBoxItemDisabledForeground" Color="#848891"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#eceff4"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#383d49"/>
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#eceff4"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#3f4550"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#eceff4"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#535f71"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#5a667a"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedDisabledBackground" Color="#3b414d"/>
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#4c566a"/>
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#3b4252"/>
