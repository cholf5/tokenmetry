<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<!--
    Solarized 画板（Light/Dark）：ThemeService 按 settings.ThemePalette 运行期换入。
    Solarized 官方色板（ethanschoonover.com/solarized）：base03-base3 八阶灰 + yellow/orange/red/magenta/violet/blue/cyan/green 八强调色。
    由 scripts/generate-theme-palettes.py 生成，勿手改；改色请改脚本内画板定义后重跑。
-->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Solarized Light：Solarized 官方色板（ethanschoonover.com/solarized）：base03-base3 八阶灰 + yellow/orange/red/magenta/violet/blue/cyan/green 八强调色。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报内容与数据语义色不吃应用画板，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#fdf6e3"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#eee8d5"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#e6decb"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#d3ccba"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#3e4d52"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#586b72"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#1d699e"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#1d706a"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#565cbb"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#596600"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#af4113"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#c22321"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#f4edda" Offset="0"/>
                <GradientStop Color="#ece4cf" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#d8d0bc"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#1d699e"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#d1d6cd"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#195d8d"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#ded6c2"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#5b6b73"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#dde8f0"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#1d699e"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#f3e2dc"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#af4113"/>
            <SolidColorBrush x:Key="AppIconChipPurpleBackgroundBrush" Color="#e6e7f5"/>
            <SolidColorBrush x:Key="AppIconChipPurpleForegroundBrush" Color="#565cbb"/>
            <SolidColorBrush x:Key="AppIconChipGreenBackgroundBrush" Color="#e6e8d9"/>
            <SolidColorBrush x:Key="AppIconChipGreenForegroundBrush" Color="#596600"/>
            <SolidColorBrush x:Key="AppIconChipNeutralBackgroundBrush" Color="#d5dadc"/>
            <SolidColorBrush x:Key="AppIconChipNeutralForegroundBrush" Color="#46565c"/>
            <!-- 侧栏 -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#f0e8d3"/>
            <!-- 顶栏 -->
            <SolidColorBrush x:Key="AppTopbarBackgroundBrush" Color="#f4eedd"/>
            <!-- 导航前景（未选中） -->
            <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#586b72"/>
            <!-- 导航选中底 -->
            <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#d2d6cc"/>
            <!-- 导航选中字 -->
            <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#195d8d"/>
            <!-- 导航指示条 -->
            <SolidColorBrush x:Key="AppNavActiveIndicatorBrush" Color="#1d699e"/>
            <!-- 导航悬停底 -->
            <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#e8e0c9"/>
            <!-- 导航静息（同 hover RGB 的 0 alpha，BrushTransition 起点） -->
            <SolidColorBrush x:Key="AppNavRestBackgroundBrush" Color="#00e8e0c9"/>
            <!-- 图表网格 -->
            <SolidColorBrush x:Key="AppChartGridLineBrush" Color="#e0d8c3"/>
            <!-- 图表轴线 -->
            <SolidColorBrush x:Key="AppChartAxisLineBrush" Color="#c8bfa9"/>
            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e6fdf6e3"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#e4edf3"/>
            <!-- banner 活动线 -->
            <SolidColorBrush x:Key="AppBannerActiveLineBrush" Color="#b0cadd"/>
            <!-- banner 告警底 -->
            <SolidColorBrush x:Key="AppBannerWarnBackgroundBrush" Color="#f2e2c8"/>
            <!-- banner 告警线 -->
            <SolidColorBrush x:Key="AppBannerWarnLineBrush" Color="#d9c49a"/>
            <!-- 滚动条滑块 -->
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#c3ba9d"/>
            <!-- 滚动条悬停 -->
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#a8a08a"/>
            <!-- 品牌色表面文字（恒白） -->
            <SolidColorBrush x:Key="AppOnBrandForegroundBrush" Color="#ffffff"/>
            <!-- 弹窗毛玻璃面（panel 90% 不透明） -->
            <SolidColorBrush x:Key="AppPopoverCardBackgroundBrush" Color="#e6eee8d5"/>
            <!-- 弹窗外投影色 -->
            <Color x:Key="AppPopoverShadowColor">#000000</Color>
            <!-- Semi 控件别名键覆盖：Semi.Avalonia v12.1 的控件 ControlTheme 只消费控件别名键（Themes/{Light,Dark}/{Control}.axaml 用 StaticResource 烤死的语义值），覆盖别名键是 Semi 原生控件跟随本画板的唯一通道；对 design-tokens.md §1「Semi* 禁止覆盖」的有意识例外（覆盖既有键、非新增键）。白名单 = 应用实际使用的控件族，逐键核对自 v12.1.0.1 源码；语义值由画板主值派生。 -->
            <SolidColorBrush x:Key="WindowDefaultBackground" Color="#fdf6e3"/>
            <SolidColorBrush x:Key="WindowDefaultForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="DefaultForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="TextBoxTextCaretBrush" Color="#3e4d52"/>
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#e5e0ce"/>
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#dedac9"/>
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#d7d4c4"/>
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#1d699e"/>
            <SolidColorBrush x:Key="TextBoxForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#586b72"/>
            <SolidColorBrush x:Key="TextBoxInnerForeground" Color="#586b72"/>
            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#e2ddcc"/>
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#9fa29a"/>
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="#e5e0ce"/>
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="#154c73"/>
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#ffffff"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#e5e0ce"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPlaceHolderForeground" Color="#586b72"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#dedac9"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#dedac9"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#d7d4c4"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="#e2ddcc"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBorderBrush" Color="#e2ddcc"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#1d699e"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#1d699e"/>
            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="#586b72"/>
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="#9fa29a"/>
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#9fa29a"/>
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#f7f5ec"/>
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#d3ccba"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#3e4d52"/>
