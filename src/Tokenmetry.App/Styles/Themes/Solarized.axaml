            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#e5e0ce"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#e5e0ce"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedForeground" Color="#3e4d52"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#dedac9"/>
