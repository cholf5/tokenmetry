        <ResourceDictionary x:Key="Dark">
            <!-- Solarized Dark：Solarized 官方色板（ethanschoonover.com/solarized）：base03-base3 八阶灰 + yellow/orange/red/magenta/violet/blue/cyan/green 八强调色。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报内容与数据语义色不吃应用画板，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#002b36"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#073642"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#0a3a47"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#174b57"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#bac4c5"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#8ea0a7"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#4ca2df"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#2eb1a7"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#9094d3"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#8ea300"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#ec7e51"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#e97f7e"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#093845" Offset="0"/>
                <GradientStop Color="#07323e" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#164956"/>
