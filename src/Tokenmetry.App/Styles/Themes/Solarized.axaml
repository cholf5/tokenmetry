            <SolidColorBrush x:Key="ComboBoxItemSelectedDisabledBackground" Color="#e2ddcc"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedBorderBrush" Color="#d3ccba"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" Color="#154c73"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#154c73"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush" Color="#0d3048"/>
