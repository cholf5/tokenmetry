            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBackground" Color="#6c4551"/>
            <SolidColorBrush x:Key="DataValidationErrorsPointerOverBorderBrush" Color="#6c4551"/>
            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#8c9eff"/>
            <SolidColorBrush x:Key="ButtonDefaultSecondaryForeground" Color="#8be9fd"/>
            <SolidColorBrush x:Key="ButtonDefaultTertiaryForeground" Color="#ccd2e1"/>
