            <SolidColorBrush x:Key="CheckBoxCheckedDisabledBackground" Color="#555e90"/>
            <SolidColorBrush x:Key="CheckBoxCheckedDisabledBorderBrush" Color="#555e90"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedBackground" Color="#464c70"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush" Color="#8c9eff"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedDisabledBorderBrush" Color="#555e90"/>
            <SolidColorBrush x:Key="CheckBoxCardPointeroverBackground" Color="#32343f"/>
            <SolidColorBrush x:Key="CheckBoxCardPressedBackground" Color="#3b3d47"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#bfc9ff"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#f2f4ff"/>
            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#8c9eff"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#8be9fd"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#ccd2e1"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#f8f8f2"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#282a36"/>
            <SolidColorBrush x:Key="FlyoutBackground" Color="#2f3140"/>
            <SolidColorBrush x:Key="FlyoutForeground" Color="#f8f8f2"/>
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#44475a"/>
            <SolidColorBrush x:Key="ListBoxItemDisabledForeground" Color="#86878b"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#f8f8f2"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#32343f"/>
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#f8f8f2"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#3b3d47"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#f8f8f2"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#464c70"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#4c5379"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedDisabledBackground" Color="#373843"/>
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#44475a"/>
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#2f3140"/>
            <SolidColorBrush x:Key="NotificationCardInformationIconForeground" Color="#8c9eff"/>
            <SolidColorBrush x:Key="NotificationCardSuccessIconForeground" Color="#50fa7b"/>
            <SolidColorBrush x:Key="NotificationCardWarningIconForeground" Color="#ffb86c"/>
            <SolidColorBrush x:Key="NotificationCardErrorIconForeground" Color="#ff6969"/>
            <SolidColorBrush x:Key="NotificationCardTitleForeground" Color="#f8f8f2"/>
            <SolidColorBrush x:Key="NotificationCardMessageForeground" Color="#ccd2e1"/>
            <SolidColorBrush x:Key="NotificationCardLightInformationBorderBrush" Color="#8c9eff"/>
            <SolidColorBrush x:Key="NotificationCardLightInformationBackground" Color="#464c70"/>
            <SolidColorBrush x:Key="NotificationCardLightSuccessBorderBrush" Color="#50fa7b"/>
            <SolidColorBrush x:Key="NotificationCardLightSuccessBackground" Color="#37634f"/>
