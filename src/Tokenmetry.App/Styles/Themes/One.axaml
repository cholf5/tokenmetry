        <ResourceDictionary x:Key="Dark">
            <!-- One Dark：Atom One 官方主题（github.com/atom/one-dark-syntax、one-light-syntax）：One Dark bg #282c34 / One Light bg #fafafa + 六强调色（blue/cyan/purple/green/orange/red）。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报内容与数据语义色不吃应用画板，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#282c34"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#2c313a"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#333842"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#3e4451"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#bcc2cc"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#9aa2b1"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#61afef"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#56b6c2"/>
            <!-- 强调紫 -->
