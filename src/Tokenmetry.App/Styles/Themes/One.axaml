            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#98c379"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#d19a66"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#e47d85"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#2f343f" Offset="0"/>
                <GradientStop Color="#2b3038" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#3e4451"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#61afef"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#303e4e"/>
            <!-- chip 文字 -->
