            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#d0d0d2"/>
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#f8f8f9"/>
            <SolidColorBrush x:Key="NotificationCardInformationIconForeground" Color="#1a5def"/>
            <SolidColorBrush x:Key="NotificationCardSuccessIconForeground" Color="#3c783b"/>
            <SolidColorBrush x:Key="NotificationCardWarningIconForeground" Color="#8e6101"/>
            <SolidColorBrush x:Key="NotificationCardErrorIconForeground" Color="#c82c1e"/>
