<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tokenmetry.App.Styles.Themes.One">

<!--
    One 画板（Light/Dark）：ThemeService 按 settings.ThemePalette 运行期换入。
    Atom One 官方主题（github.com/atom/one-dark-syntax、one-light-syntax）：One Dark bg #282c34 / One Light bg #fafafa + 六强调色（blue/cyan/purple/green/orange/red）。
    由 scripts/generate-theme-palettes.py 生成，勿手改；改色请改脚本内画板定义后重跑。
    x:Class = 编译期 XAML + 同名 code-behind（ThemeService 类型化实例化）；不要去掉——
    运行期 AvaloniaXamlLoader.Load(Uri) 带 RequiresUnreferencedCode，AOT 发布直接 IL2026。
-->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- One Light：Atom One 官方主题（github.com/atom/one-dark-syntax、one-light-syntax）：One Dark bg #282c34 / One Light bg #fafafa + 六强调色（blue/cyan/purple/green/orange/red）。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报内容与数据语义色不吃应用画板，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#fafafa"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#f0f0f1"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#e5e5e6"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#d0d0d2"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#383a42"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#696c77"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#1a5def"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#016f9e"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#a626a4"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#3c783b"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#8e6101"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#c82c1e"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#ffffff" Offset="0"/>
                <GradientStop Color="#f7f7f8" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#e0e0e2"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#1a5def"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#d2dbf1"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#0f4fdc"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#e5e5e6"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#5c5f66"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#dde7fd"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#1056ef"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#eee7d9"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#845a01"/>
            <SolidColorBrush x:Key="AppIconChipPurpleBackgroundBrush" Color="#f2def1"/>
            <SolidColorBrush x:Key="AppIconChipPurpleForegroundBrush" Color="#a626a4"/>
            <SolidColorBrush x:Key="AppIconChipGreenBackgroundBrush" Color="#e2ebe2"/>
            <SolidColorBrush x:Key="AppIconChipGreenForegroundBrush" Color="#387137"/>
            <SolidColorBrush x:Key="AppIconChipNeutralBackgroundBrush" Color="#dadadd"/>
            <SolidColorBrush x:Key="AppIconChipNeutralForegroundBrush" Color="#474952"/>
            <!-- 侧栏 -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#f0f0f1"/>
            <!-- 顶栏 -->
            <SolidColorBrush x:Key="AppTopbarBackgroundBrush" Color="#f5f5f6"/>
            <!-- 导航前景（未选中） -->
            <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#696c77"/>
            <!-- 导航选中底 -->
            <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#d2dbf1"/>
            <!-- 导航选中字 -->
            <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#0f4fdc"/>
            <!-- 导航指示条 -->
            <SolidColorBrush x:Key="AppNavActiveIndicatorBrush" Color="#1a5def"/>
            <!-- 导航悬停底 -->
            <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#e5e5e6"/>
            <!-- 导航静息（同 hover RGB 的 0 alpha，BrushTransition 起点） -->
            <SolidColorBrush x:Key="AppNavRestBackgroundBrush" Color="#00e5e5e6"/>
            <!-- 图表网格 -->
            <SolidColorBrush x:Key="AppChartGridLineBrush" Color="#e5e5e6"/>
            <!-- 图表轴线 -->
            <SolidColorBrush x:Key="AppChartAxisLineBrush" Color="#d0d0d2"/>
            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e6fafafa"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#e3ecfd"/>
            <!-- banner 活动线 -->
            <SolidColorBrush x:Key="AppBannerActiveLineBrush" Color="#afc6fa"/>
            <!-- banner 告警底 -->
            <SolidColorBrush x:Key="AppBannerWarnBackgroundBrush" Color="#f6ecda"/>
            <!-- banner 告警线 -->
            <SolidColorBrush x:Key="AppBannerWarnLineBrush" Color="#e0cfa9"/>
            <!-- 滚动条滑块 -->
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#bdbdc1"/>
            <!-- 滚动条悬停 -->
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#9a9a9f"/>
            <!-- 品牌色表面文字（恒白） -->
            <SolidColorBrush x:Key="AppOnBrandForegroundBrush" Color="#ffffff"/>
            <!-- 弹窗毛玻璃面（panel 90% 不透明） -->
            <SolidColorBrush x:Key="AppPopoverCardBackgroundBrush" Color="#e6f0f0f1"/>
            <!-- 弹窗外投影色 -->
            <Color x:Key="AppPopoverShadowColor">#000000</Color>
            <!-- Semi 控件别名键覆盖：Semi.Avalonia v12.1 的控件 ControlTheme 只消费控件别名键（Themes/{Light,Dark}/{Control}.axaml 用 StaticResource 烤死的语义值），覆盖别名键是 Semi 原生控件跟随本画板的唯一通道；对 design-tokens.md §1「Semi* 禁止覆盖」的有意识例外（覆盖既有键、非新增键）。白名单 = 应用实际使用的控件族，逐键核对自 v12.1.0.1 源码；语义值由画板主值派生。 -->
            <SolidColorBrush x:Key="WindowDefaultBackground" Color="#fafafa"/>
            <SolidColorBrush x:Key="WindowDefaultForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="DefaultForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="TextBoxTextCaretBrush" Color="#383a42"/>
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#dfe0e1"/>
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#d8d8da"/>
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#1a5def"/>
            <SolidColorBrush x:Key="TextBoxForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#696c77"/>
            <SolidColorBrush x:Key="TextBoxInnerForeground" Color="#696c77"/>
            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#e3e3e5"/>
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#9d9ea2"/>
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="#0e48c9"/>
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#ffffff"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPlaceHolderForeground" Color="#696c77"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#dfe0e1"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#dfe0e1"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#d8d8da"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="#e3e3e5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBorderBrush" Color="#e3e3e5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#1a5def"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#1a5def"/>
            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="#696c77"/>
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="#9d9ea2"/>
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#9d9ea2"/>
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#f8f8f9"/>
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#d0d0d2"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#dfe0e1"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#d6e2fc"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#c7d8fb"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedDisabledBackground" Color="#e3e3e5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedBorderBrush" Color="#d0d0d2"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" Color="#0e48c9"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#0e48c9"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush" Color="#0a3799"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBackground" Color="#f8f8f9"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBorderBrush" Color="#d0d0d2"/>
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#9d9ea2"/>
            <SolidColorBrush x:Key="CheckBoxGlyphFill" Color="#ffffff"/>
            <SolidColorBrush x:Key="CheckBoxDefaultBorderBrush" Color="#9fa1a8"/>
            <SolidColorBrush x:Key="CheckBoxPointeroverBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush" Color="#1a5def"/>
