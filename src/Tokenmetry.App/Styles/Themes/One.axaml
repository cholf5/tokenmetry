            <SolidColorBrush x:Key="CheckBoxCardCheckedDisabledBorderBrush" Color="#90aef0"/>
            <SolidColorBrush x:Key="CheckBoxCardPointeroverBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="CheckBoxCardPressedBackground" Color="#dfe0e1"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#0e48c9"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#0a3799"/>
            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#1a5def"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#016f9e"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#4c4e57"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#383a42"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#fafafa"/>
            <SolidColorBrush x:Key="FlyoutBackground" Color="#f8f8f9"/>
            <SolidColorBrush x:Key="FlyoutForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#d0d0d2"/>
            <SolidColorBrush x:Key="ListBoxItemDisabledForeground" Color="#9d9ea2"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#e7e7e8"/>
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#dfe0e1"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#383a42"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#d6e2fc"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#c7d8fb"/>
