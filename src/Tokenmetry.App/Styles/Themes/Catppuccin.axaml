            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#262638" Offset="0"/>
                <GradientStop Color="#222232" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#45475a"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#89b4fa"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#2d334b"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#89b4fa"/>
            <!-- mini 进度条轨道 -->
