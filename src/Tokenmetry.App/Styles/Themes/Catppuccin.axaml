        <ResourceDictionary x:Key="Dark">
            <!-- Catppuccin Dark：Catppuccin 官方色板（github.com/catppuccin/palette）：Latte（亮）base/mantle/crust/surface0-2 灰阶 + 十四强调色；Mocha（暗）同键位（base #1e1e2e / surface0-2 / mauve/blue/teal/green/peach/red）。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报表面吃画板，但专用可视化令牌与数据语义色全画板恒定，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1e1e2e"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#313244"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#45475a"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#585b70"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#cdd6f4"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#a6adc8"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#89b4fa"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#94e2d5"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#cba6f7"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#a6e3a1"/>
            <!-- 强调橙 -->
