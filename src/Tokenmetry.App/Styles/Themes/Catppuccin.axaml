<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tokenmetry.App.Styles.Themes.Catppuccin">

<!--
    Catppuccin 画板（Light/Dark）：ThemeService 按 settings.ThemePalette 运行期换入。
    Catppuccin 官方色板（github.com/catppuccin/palette）：Latte（亮）base/mantle/crust/surface0-2 灰阶 + 十四强调色；Mocha（暗）同键位（base #1e1e2e / surface0-2 / mauve/blue/teal/green/peach/red）。
    由 scripts/generate-theme-palettes.py 生成，勿手改；改色请改脚本内画板定义后重跑。
    x:Class = 编译期 XAML + 同名 code-behind（ThemeService 类型化实例化）；不要去掉——
    运行期 AvaloniaXamlLoader.Load(Uri) 带 RequiresUnreferencedCode，AOT 发布直接 IL2026。
-->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Catppuccin Light：Catppuccin 官方色板（github.com/catppuccin/palette）：Latte（亮）base/mantle/crust/surface0-2 灰阶 + 十四强调色；Mocha（暗）同键位（base #1e1e2e / surface0-2 / mauve/blue/teal/green/peach/red）。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报表面吃画板，但专用可视化令牌与数据语义色全画板恒定，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#eff1f5"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#e6e9ef"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#dce0e8"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#ccd0da"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#484b63"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5c5f77"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#0b59f4"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#127076"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#8230ee"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#2d701e"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#ac4001"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#c80e36"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#f7f8fb" Offset="0"/>
                <GradientStop Color="#f2f4f8" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#dce0e8"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#0b59f4"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#c7d5f0"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#0a4ed6"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#dce0e8"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#5c5f77"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#dae6fd"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#0a55ea"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#f3e2d9"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#ac4001"/>
            <SolidColorBrush x:Key="AppIconChipPurpleBackgroundBrush" Color="#ece0fc"/>
            <SolidColorBrush x:Key="AppIconChipPurpleForegroundBrush" Color="#8230ee"/>
            <SolidColorBrush x:Key="AppIconChipGreenBackgroundBrush" Color="#dfeadd"/>
            <SolidColorBrush x:Key="AppIconChipGreenForegroundBrush" Color="#2d701e"/>
            <SolidColorBrush x:Key="AppIconChipNeutralBackgroundBrush" Color="#d6d7dd"/>
            <SolidColorBrush x:Key="AppIconChipNeutralForegroundBrush" Color="#4e5169"/>
            <!-- 侧栏 -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#e6e9ef"/>
            <!-- 顶栏 -->
            <SolidColorBrush x:Key="AppTopbarBackgroundBrush" Color="#eaeef4"/>
            <!-- 导航前景（未选中） -->
            <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#5c5f77"/>
            <!-- 导航选中底 -->
            <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#c7d5f0"/>
            <!-- 导航选中字 -->
            <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#0a4ed6"/>
            <!-- 导航指示条 -->
            <SolidColorBrush x:Key="AppNavActiveIndicatorBrush" Color="#0b59f4"/>
            <!-- 导航悬停底 -->
            <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#dce0e8"/>
            <!-- 导航静息（同 hover RGB 的 0 alpha，BrushTransition 起点） -->
            <SolidColorBrush x:Key="AppNavRestBackgroundBrush" Color="#00dce0e8"/>
            <!-- 图表网格 -->
            <SolidColorBrush x:Key="AppChartGridLineBrush" Color="#dce0e8"/>
            <!-- 图表轴线 -->
            <SolidColorBrush x:Key="AppChartAxisLineBrush" Color="#ccd0da"/>
            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e6eff1f5"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#e2ebfe"/>
            <!-- banner 活动线 -->
            <SolidColorBrush x:Key="AppBannerActiveLineBrush" Color="#aac5fb"/>
            <!-- banner 告警底 -->
            <SolidColorBrush x:Key="AppBannerWarnBackgroundBrush" Color="#f6e3cf"/>
            <!-- banner 告警线 -->
            <SolidColorBrush x:Key="AppBannerWarnLineBrush" Color="#e2c39a"/>
            <!-- 滚动条滑块 -->
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#b0b5c3"/>
            <!-- 滚动条悬停 -->
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#9ca0b0"/>
            <!-- 品牌色表面文字（恒白） -->
            <SolidColorBrush x:Key="AppOnBrandForegroundBrush" Color="#ffffff"/>
            <!-- 弹窗毛玻璃面（panel 90% 不透明） -->
            <SolidColorBrush x:Key="AppPopoverCardBackgroundBrush" Color="#e6e6e9ef"/>
            <!-- 弹窗外投影色 -->
            <Color x:Key="AppPopoverShadowColor">#000000</Color>
            <!-- Semi 控件别名键覆盖：Semi.Avalonia v12.1 的控件 ControlTheme 只消费控件别名键（Themes/{Light,Dark}/{Control}.axaml 用 StaticResource 烤死的语义值），覆盖别名键是 Semi 原生控件跟随本画板的唯一通道；对 design-tokens.md §1「Semi* 禁止覆盖」的有意识例外（覆盖既有键、非新增键）。白名单 = 应用实际使用的控件族，逐键核对自 v12.1.0.1 源码；语义值由画板主值派生。 -->
            <SolidColorBrush x:Key="WindowDefaultBackground" Color="#eff1f5"/>
            <SolidColorBrush x:Key="WindowDefaultForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="DefaultForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="TextBoxTextCaretBrush" Color="#484b63"/>
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#dee1e8"/>
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#d8dbe2"/>
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#d1d4dd"/>
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#0b59f4"/>
            <SolidColorBrush x:Key="TextBoxForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#5c5f77"/>
            <SolidColorBrush x:Key="TextBoxInnerForeground" Color="#5c5f77"/>
            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#dbdee5"/>
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#9fa2b0"/>
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="#dee1e8"/>
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="#0947c3"/>
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#ffffff"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#dee1e8"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPlaceHolderForeground" Color="#5c5f77"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#d8dbe2"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#d8dbe2"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#d1d4dd"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="#dbdee5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBorderBrush" Color="#dbdee5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#0b59f4"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#0b59f4"/>
            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="#5c5f77"/>
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="#9fa2b0"/>
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#9fa2b0"/>
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#f4f5f8"/>
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#ccd0da"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#dee1e8"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#dee1e8"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#d8dbe2"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#d3e1fd"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#c4d7fc"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedDisabledBackground" Color="#dbdee5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedBorderBrush" Color="#ccd0da"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" Color="#0947c3"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#0947c3"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush" Color="#063592"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBackground" Color="#f4f5f8"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBorderBrush" Color="#ccd0da"/>
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#9fa2b0"/>
            <SolidColorBrush x:Key="CheckBoxGlyphFill" Color="#ffffff"/>
            <SolidColorBrush x:Key="CheckBoxDefaultBorderBrush" Color="#9396a7"/>
