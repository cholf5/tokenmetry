            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#0b59f4"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#127076"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#50536b"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#484b63"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#eff1f5"/>
            <SolidColorBrush x:Key="FlyoutBackground" Color="#f4f5f8"/>
            <SolidColorBrush x:Key="FlyoutForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#ccd0da"/>
            <SolidColorBrush x:Key="ListBoxItemDisabledForeground" Color="#9fa2b0"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#dee1e8"/>
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#d8dbe2"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#484b63"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#d3e1fd"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#c4d7fc"/>
