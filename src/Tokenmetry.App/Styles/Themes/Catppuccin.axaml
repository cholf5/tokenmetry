            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#ccd0da"/>
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#f4f5f8"/>
            <SolidColorBrush x:Key="NotificationCardInformationIconForeground" Color="#0b59f4"/>
