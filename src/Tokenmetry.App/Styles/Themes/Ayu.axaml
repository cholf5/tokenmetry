        <ResourceDictionary x:Key="Dark">
            <!-- Ayu Dark：Ayu 官方主题（github.com/ayu-theme）：Light bg #fafafa / Dark bg #0b0e14 + 六强调色（orange/green/blue/cyan/purple/red）。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报表面吃画板，但专用可视化令牌与数据语义色全画板恒定，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0b0e14"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#11151c"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#141a22"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#1f2733"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#b3b1ad"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#7d8590"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#59c2ff"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#95e6cb"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#d2a6ff"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#aad94c"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#ff8f40"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#f07178"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#0f141b" Offset="0"/>
                <GradientStop Color="#0c1017" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#1f2733"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#59c2ff"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#162735"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#59c2ff"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#141a22"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#8b929a"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#1f3d51"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#59c2ff"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#4a301f"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#ff8f40"/>
