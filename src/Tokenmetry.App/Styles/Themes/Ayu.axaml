            <SolidColorBrush x:Key="DataValidationErrorsPointeroverBorderBrush" Color="#f6c8c8"/>
            <SolidColorBrush x:Key="DataValidationErrorsPressedBackground" Color="#f4bbbb"/>
            <SolidColorBrush x:Key="DataValidationErrorsPressedBorderBrush" Color="#f4bbbb"/>
