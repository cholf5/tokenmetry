<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tokenmetry.App.Styles.Themes.Ayu">

<!--
    Ayu 画板（Light/Dark）：ThemeService 按 settings.ThemePalette 运行期换入。
    Ayu 官方主题（github.com/ayu-theme）：Light bg #fafafa / Dark bg #0b0e14 + 六强调色（orange/green/blue/cyan/purple/red）。
    由 scripts/generate-theme-palettes.py 生成，勿手改；改色请改脚本内画板定义后重跑。
    x:Class = 编译期 XAML + 同名 code-behind（ThemeService 类型化实例化）；不要去掉——
    运行期 AvaloniaXamlLoader.Load(Uri) 带 RequiresUnreferencedCode，AOT 发布直接 IL2026。
-->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Ayu Light：Ayu 官方主题（github.com/ayu-theme）：Light bg #fafafa / Dark bg #0b0e14 + 六强调色（orange/green/blue/cyan/purple/red）。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报表面吃画板，但专用可视化令牌与数据语义色全画板恒定，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#fafafa"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#f1f2f3"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#e6e8ea"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#d3d6da"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#4d5256"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#656b70"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#166ead"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#2b7a60"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#844ebb"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#587600"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#af4c05"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#da1717"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#ffffff" Offset="0"/>
                <GradientStop Color="#f8f9fa" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#e3e5e8"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#166ead"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#d2e0e9"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#14639b"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#e6e8ea"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#666b70"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#dce9f3"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#1569a4"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#f3e4d9"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#a54804"/>
            <SolidColorBrush x:Key="AppIconChipPurpleBackgroundBrush" Color="#ede4f5"/>
            <SolidColorBrush x:Key="AppIconChipPurpleForegroundBrush" Color="#7f47b8"/>
            <SolidColorBrush x:Key="AppIconChipGreenBackgroundBrush" Color="#e6ead9"/>
            <SolidColorBrush x:Key="AppIconChipGreenForegroundBrush" Color="#516c00"/>
            <SolidColorBrush x:Key="AppIconChipNeutralBackgroundBrush" Color="#d9dadb"/>
            <SolidColorBrush x:Key="AppIconChipNeutralForegroundBrush" Color="#55595e"/>
            <!-- 侧栏 -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#f1f2f3"/>
            <!-- 顶栏 -->
            <SolidColorBrush x:Key="AppTopbarBackgroundBrush" Color="#f5f6f7"/>
            <!-- 导航前景（未选中） -->
            <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#656b70"/>
            <!-- 导航选中底 -->
            <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#d2e0e9"/>
            <!-- 导航选中字 -->
            <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#14639b"/>
            <!-- 导航指示条 -->
            <SolidColorBrush x:Key="AppNavActiveIndicatorBrush" Color="#166ead"/>
            <!-- 导航悬停底 -->
            <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#e6e8ea"/>
            <!-- 导航静息（同 hover RGB 的 0 alpha，BrushTransition 起点） -->
            <SolidColorBrush x:Key="AppNavRestBackgroundBrush" Color="#00e6e8ea"/>
            <!-- 图表网格 -->
            <SolidColorBrush x:Key="AppChartGridLineBrush" Color="#e6e8ea"/>
            <!-- 图表轴线 -->
            <SolidColorBrush x:Key="AppChartAxisLineBrush" Color="#d3d6da"/>
            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e6fafafa"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#e3eef5"/>
            <!-- banner 活动线 -->
            <SolidColorBrush x:Key="AppBannerActiveLineBrush" Color="#adcce2"/>
            <!-- banner 告警底 -->
            <SolidColorBrush x:Key="AppBannerWarnBackgroundBrush" Color="#f7ecd5"/>
            <!-- banner 告警线 -->
            <SolidColorBrush x:Key="AppBannerWarnLineBrush" Color="#e3d0a8"/>
            <!-- 滚动条滑块 -->
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#bbbfc3"/>
            <!-- 滚动条悬停 -->
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#9da2a6"/>
            <!-- 品牌色表面文字（恒白） -->
            <SolidColorBrush x:Key="AppOnBrandForegroundBrush" Color="#ffffff"/>
            <!-- 弹窗毛玻璃面（panel 90% 不透明） -->
            <SolidColorBrush x:Key="AppPopoverCardBackgroundBrush" Color="#e6f1f2f3"/>
            <!-- 弹窗外投影色 -->
            <Color x:Key="AppPopoverShadowColor">#000000</Color>
            <!-- Semi 控件别名键覆盖：Semi.Avalonia v12.1 的控件 ControlTheme 只消费控件别名键（Themes/{Light,Dark}/{Control}.axaml 用 StaticResource 烤死的语义值），覆盖别名键是 Semi 原生控件跟随本画板的唯一通道；对 design-tokens.md §1「Semi* 禁止覆盖」的有意识例外（覆盖既有键、非新增键）。白名单 = 应用实际使用的控件族，逐键核对自 v12.1.0.1 源码；语义值由画板主值派生。 -->
            <SolidColorBrush x:Key="WindowDefaultBackground" Color="#fafafa"/>
            <SolidColorBrush x:Key="WindowDefaultForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="DefaultForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="TextBoxTextCaretBrush" Color="#4d5256"/>
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#dcdddf"/>
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#166ead"/>
            <SolidColorBrush x:Key="TextBoxForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#656b70"/>
            <SolidColorBrush x:Key="TextBoxInnerForeground" Color="#656b70"/>
            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#e6e7e8"/>
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#a7aaac"/>
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="#105180"/>
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#ffffff"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPlaceHolderForeground" Color="#656b70"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#dcdddf"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="#e6e7e8"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBorderBrush" Color="#e6e7e8"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#166ead"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#166ead"/>
            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="#656b70"/>
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="#a7aaac"/>
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#a7aaac"/>
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#f9f9fa"/>
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#d3d6da"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#d5e5f0"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#cadeec"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedDisabledBackground" Color="#e6e7e8"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedBorderBrush" Color="#d3d6da"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" Color="#105180"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#105180"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush" Color="#0a3553"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBackground" Color="#f9f9fa"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBorderBrush" Color="#d3d6da"/>
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#a7aaac"/>
            <SolidColorBrush x:Key="CheckBoxGlyphFill" Color="#ffffff"/>
            <SolidColorBrush x:Key="CheckBoxDefaultBorderBrush" Color="#9da1a5"/>
            <SolidColorBrush x:Key="CheckBoxPointeroverBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush" Color="#166ead"/>
            <SolidColorBrush x:Key="CheckBoxPressedBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="CheckBoxPressedBorderBrush" Color="#0a3553"/>
