            <SolidColorBrush x:Key="CheckBoxCardCheckedBackground" Color="#d5e5f0"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush" Color="#166ead"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedDisabledBorderBrush" Color="#8eb7d4"/>
            <SolidColorBrush x:Key="CheckBoxCardPointeroverBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="CheckBoxCardPressedBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush" Color="#105180"/>
            <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush" Color="#0a3553"/>
            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#166ead"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#2b7a60"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#575c60"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#fafafa"/>
            <SolidColorBrush x:Key="FlyoutBackground" Color="#f9f9fa"/>
            <SolidColorBrush x:Key="FlyoutForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#d3d6da"/>
            <SolidColorBrush x:Key="ListBoxItemDisabledForeground" Color="#a7aaac"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ListBoxItemPointeroverBackground" Color="#e9eaeb"/>
            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#e2e4e5"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#4d5256"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#d5e5f0"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#cadeec"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedDisabledBackground" Color="#e6e7e8"/>
            <SolidColorBrush x:Key="NotificationCardBorderBrush" Color="#d3d6da"/>
            <SolidColorBrush x:Key="NotificationCardBackground" Color="#f9f9fa"/>
            <SolidColorBrush x:Key="NotificationCardInformationIconForeground" Color="#166ead"/>
            <SolidColorBrush x:Key="NotificationCardSuccessIconForeground" Color="#587600"/>
            <SolidColorBrush x:Key="NotificationCardWarningIconForeground" Color="#af4c05"/>
            <SolidColorBrush x:Key="NotificationCardErrorIconForeground" Color="#da1717"/>
