            <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground" Color="#166ead"/>
            <SolidColorBrush x:Key="ButtonDefaultSecondaryForeground" Color="#2b7a60"/>
            <SolidColorBrush x:Key="ButtonDefaultTertiaryForeground" Color="#575c60"/>
