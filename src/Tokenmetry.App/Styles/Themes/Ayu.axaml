            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e60b0e14"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#101a26"/>
