        <ResourceDictionary x:Key="Dark">
            <!-- Gruvbox Dark：Gruvbox 官方色板（github.com/morhetz/gruvbox）：dark bg0-bg4 / light bg0-bg2 + neutral 与 bright/faded 双档强调色。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报内容与数据语义色不吃应用画板，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#282828"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#3c3836"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#32302f"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#504945"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#ebdbb2"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#b0a390"/>
            <!-- 强调蓝 -->
