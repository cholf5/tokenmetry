            <SolidColorBrush x:Key="ListBoxItemPressedForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ListBoxItemPressedBackground" Color="#ece7d6"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#d2e3e7"/>
            <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground" Color="#c8dde1"/>
