            <SolidColorBrush x:Key="ComboBoxItemFocusBackground" Color="#f3eedd"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ComboBoxItemPressedBackground" Color="#ece7d6"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedBackground" Color="#d2e3e7"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground" Color="#c8dde1"/>
            <SolidColorBrush x:Key="ComboBoxItemSelectedDisabledBackground" Color="#efebda"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedBorderBrush" Color="#d5c4a1"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush" Color="#043d48"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush" Color="#043d48"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush" Color="#011418"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBackground" Color="#fefcf4"/>
            <SolidColorBrush x:Key="AutoCompleteBoxPopupBorderBrush" Color="#d5c4a1"/>
            <SolidColorBrush x:Key="CheckBoxForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="CheckBoxDisabledForeground" Color="#a6a297"/>
