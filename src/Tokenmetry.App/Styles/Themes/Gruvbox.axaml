<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="Tokenmetry.App.Styles.Themes.Gruvbox">

<!--
    Gruvbox 画板（Light/Dark）：ThemeService 按 settings.ThemePalette 运行期换入。
    Gruvbox 官方色板（github.com/morhetz/gruvbox）：dark bg0-bg4 / light bg0-bg2 + neutral 与 bright/faded 双档强调色。
    由 scripts/generate-theme-palettes.py 生成，勿手改；改色请改脚本内画板定义后重跑。
    x:Class = 编译期 XAML + 同名 code-behind（ThemeService 类型化实例化）；不要去掉——
    运行期 AvaloniaXamlLoader.Load(Uri) 带 RequiresUnreferencedCode，AOT 发布直接 IL2026。
-->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Gruvbox Light：Gruvbox 官方色板（github.com/morhetz/gruvbox）：dark bg0-bg4 / light bg0-bg2 + neutral 与 bright/faded 双档强调色。
                 由 scripts/generate-theme-palettes.py 生成（对比度纪律已逐项断言），勿手改；
                 重跑脚本再生。海报令牌（AppPoster*）与图表系列色刻意不在本画板——
                 海报内容与数据语义色不吃应用画板，见 docs/design/design-tokens.md。 -->
            <!-- 页面底 -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#fbf1c7"/>
            <!-- 面板 -->
            <SolidColorBrush x:Key="AppPanelBrush" Color="#fdf8e6"/>
            <!-- 次面板 -->
            <SolidColorBrush x:Key="AppPanelAltBrush" Color="#f2e5bc"/>
            <!-- 描边 -->
            <SolidColorBrush x:Key="AppLineBrush" Color="#d5c4a1"/>
            <!-- 正文 -->
            <SolidColorBrush x:Key="AppTextBrush" Color="#3c3836"/>
            <!-- 次要文字 -->
            <SolidColorBrush x:Key="AppMutedTextBrush" Color="#665c54"/>
            <!-- 强调蓝 -->
            <SolidColorBrush x:Key="AppAccentBlueBrush" Color="#076678"/>
            <!-- 强调青 -->
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#427b58"/>
            <!-- 强调紫 -->
            <SolidColorBrush x:Key="AppAccentPurpleBrush" Color="#8f3f71"/>
            <!-- 强调绿 -->
            <SolidColorBrush x:Key="AppAccentGreenBrush" Color="#79740e"/>
            <!-- 强调橙 -->
            <SolidColorBrush x:Key="AppAccentOrangeBrush" Color="#af3a03"/>
            <!-- 强调红 -->
            <SolidColorBrush x:Key="AppAccentRedBrush" Color="#9d0006"/>
            <!-- 卡片表面（145° 渐变，与默认画板同构） -->
            <LinearGradientBrush x:Key="AppCardBackgroundBrush" StartPoint="10.058%,-7.043%" EndPoint="89.942%,107.043%">
                <GradientStop Color="#fefaf0" Offset="0"/>
                <GradientStop Color="#faf3dd" Offset="1"/>
            </LinearGradientBrush>
            <!-- 卡片描边 -->
            <SolidColorBrush x:Key="AppCardLineBrush" Color="#ddd1b4"/>
            <!-- 链接 -->
            <SolidColorBrush x:Key="AppLinkBrush" Color="#076678"/>
            <!-- chip 底 -->
            <SolidColorBrush x:Key="AppChipBackgroundBrush" Color="#dbe4d7"/>
            <!-- chip 文字 -->
            <SolidColorBrush x:Key="AppChipTextBrush" Color="#076678"/>
            <!-- mini 进度条轨道 -->
            <SolidColorBrush x:Key="AppMiniTrackBrush" Color="#e6dabc"/>
            <!-- KPI 顶标签 -->
            <SolidColorBrush x:Key="AppKpiTitleBrush" Color="#57504a"/>
            <SolidColorBrush x:Key="AppIconChipBlueBackgroundBrush" Color="#dae8eb"/>
            <SolidColorBrush x:Key="AppIconChipBlueForegroundBrush" Color="#076678"/>
            <SolidColorBrush x:Key="AppIconChipAmberBackgroundBrush" Color="#f3e1d9"/>
            <SolidColorBrush x:Key="AppIconChipAmberForegroundBrush" Color="#af3a03"/>
            <SolidColorBrush x:Key="AppIconChipPurpleBackgroundBrush" Color="#eee2ea"/>
            <SolidColorBrush x:Key="AppIconChipPurpleForegroundBrush" Color="#8f3f71"/>
            <SolidColorBrush x:Key="AppIconChipGreenBackgroundBrush" Color="#ebeadb"/>
            <SolidColorBrush x:Key="AppIconChipGreenForegroundBrush" Color="#706b0d"/>
            <SolidColorBrush x:Key="AppIconChipNeutralBackgroundBrush" Color="#d9d6d4"/>
            <SolidColorBrush x:Key="AppIconChipNeutralForegroundBrush" Color="#49433f"/>
            <!-- 侧栏 -->
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#f2e5bc"/>
            <!-- 顶栏 -->
            <SolidColorBrush x:Key="AppTopbarBackgroundBrush" Color="#f6ecd2"/>
            <!-- 导航前景（未选中） -->
            <SolidColorBrush x:Key="AppNavForegroundBrush" Color="#665c54"/>
            <!-- 导航选中底 -->
            <SolidColorBrush x:Key="AppNavActiveBackgroundBrush" Color="#d1d3b2"/>
            <!-- 导航选中字 -->
            <SolidColorBrush x:Key="AppNavActiveForegroundBrush" Color="#065e6e"/>
            <!-- 导航指示条 -->
            <SolidColorBrush x:Key="AppNavActiveIndicatorBrush" Color="#076678"/>
            <!-- 导航悬停底 -->
            <SolidColorBrush x:Key="AppNavHoverBackgroundBrush" Color="#e8dcba"/>
            <!-- 导航静息（同 hover RGB 的 0 alpha，BrushTransition 起点） -->
            <SolidColorBrush x:Key="AppNavRestBackgroundBrush" Color="#00e8dcba"/>
            <!-- 图表网格 -->
            <SolidColorBrush x:Key="AppChartGridLineBrush" Color="#e2d7bc"/>
            <!-- 图表轴线 -->
            <SolidColorBrush x:Key="AppChartAxisLineBrush" Color="#c9bb9c"/>
            <!-- 首启遮罩（页面底 90% 不透明） -->
            <SolidColorBrush x:Key="AppOverlayScrimBrush" Color="#e6fbf1c7"/>
            <!-- banner 活动底 -->
            <SolidColorBrush x:Key="AppBannerActiveBackgroundBrush" Color="#e1edef"/>
            <!-- banner 活动线 -->
            <SolidColorBrush x:Key="AppBannerActiveLineBrush" Color="#a8c9d0"/>
            <!-- banner 告警底 -->
            <SolidColorBrush x:Key="AppBannerWarnBackgroundBrush" Color="#f0e0bd"/>
            <!-- banner 告警线 -->
            <SolidColorBrush x:Key="AppBannerWarnLineBrush" Color="#d3b273"/>
            <!-- 滚动条滑块 -->
            <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#c5b695"/>
            <!-- 滚动条悬停 -->
            <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#a19270"/>
            <!-- 品牌色表面文字（恒白） -->
            <SolidColorBrush x:Key="AppOnBrandForegroundBrush" Color="#ffffff"/>
            <!-- 弹窗毛玻璃面（panel 90% 不透明） -->
            <SolidColorBrush x:Key="AppPopoverCardBackgroundBrush" Color="#e6fdf8e6"/>
            <!-- 弹窗外投影色 -->
            <Color x:Key="AppPopoverShadowColor">#000000</Color>
            <!-- Semi 控件别名键覆盖：Semi.Avalonia v12.1 的控件 ControlTheme 只消费控件别名键（Themes/{Light,Dark}/{Control}.axaml 用 StaticResource 烤死的语义值），覆盖别名键是 Semi 原生控件跟随本画板的唯一通道；对 design-tokens.md §1「Semi* 禁止覆盖」的有意识例外（覆盖既有键、非新增键）。白名单 = 应用实际使用的控件族，逐键核对自 v12.1.0.1 源码；语义值由画板主值派生。 -->
            <SolidColorBrush x:Key="WindowDefaultBackground" Color="#fbf1c7"/>
            <SolidColorBrush x:Key="WindowDefaultForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="DefaultForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="TextBoxTextCaretBrush" Color="#3c3836"/>
            <SolidColorBrush x:Key="TextBoxDefaultBackground" Color="#f3eedd"/>
            <SolidColorBrush x:Key="TextBoxPointeroverBackground" Color="#ece7d6"/>
            <SolidColorBrush x:Key="TextBoxPressedBackground" Color="#e4dfcf"/>
            <SolidColorBrush x:Key="TextBoxFocusBorderBrush" Color="#076678"/>
            <SolidColorBrush x:Key="TextBoxForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="TextBoxPlaceholderForeground" Color="#665c54"/>
            <SolidColorBrush x:Key="TextBoxInnerForeground" Color="#665c54"/>
            <SolidColorBrush x:Key="TextBoxDisabledBackground" Color="#efebda"/>
            <SolidColorBrush x:Key="TextBoxDisabledForeground" Color="#a6a297"/>
            <SolidColorBrush x:Key="TextBoxBorderedDefaultBorderBrush" Color="#f3eedd"/>
            <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush" Color="#043d48"/>
            <SolidColorBrush x:Key="TextBoxSelectionForeground" Color="#ffffff"/>
            <SolidColorBrush x:Key="ComboBoxSelectorBackground" Color="#f3eedd"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPlaceHolderForeground" Color="#665c54"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground" Color="#ece7d6"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground" Color="#ece7d6"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground" Color="#e4dfcf"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBackground" Color="#efebda"/>
            <SolidColorBrush x:Key="ComboBoxSelectorDisabledBorderBrush" Color="#efebda"/>
            <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush" Color="#076678"/>
            <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush" Color="#076678"/>
            <SolidColorBrush x:Key="ComboBoxIconDefaultForeground" Color="#665c54"/>
            <SolidColorBrush x:Key="ComboBoxIconPointeroverForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ComboBoxIconPressedForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ComboBoxIconDisabledForeground" Color="#a6a297"/>
            <SolidColorBrush x:Key="ComboBoxDisabledForeground" Color="#a6a297"/>
            <SolidColorBrush x:Key="ComboBoxPopupBackground" Color="#fefcf4"/>
            <SolidColorBrush x:Key="ComboBoxPopupBorderBrush" Color="#d5c4a1"/>
            <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground" Color="#3c3836"/>
            <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground" Color="#f3eedd"/>
