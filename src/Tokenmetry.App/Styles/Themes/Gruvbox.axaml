            <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush" Color="#076678"/>
            <SolidColorBrush x:Key="ToggleButtonSecondaryIndeterminateBorderBrush" Color="#427b58"/>
            <SolidColorBrush x:Key="ToggleButtonTertiaryIndeterminateBorderBrush" Color="#4d4642"/>
            <SolidColorBrush x:Key="ToolTipBackground" Color="#3c3836"/>
