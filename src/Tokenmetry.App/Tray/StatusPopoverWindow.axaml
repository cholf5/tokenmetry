<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Tokenmetry.App.Views"
        x:Class="Tokenmetry.App.Tray.StatusPopoverWindow"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ShowInTaskbar="False"
        CanResize="False"
        Topmost="True"
        Width="498"
        SizeToContent="Height"
        Title="Tokenmetry">
    <!-- [D-016] 状态栏快捷信息窗 · 壳层：无边框透明窗承载 D-015 内容层（内容 100% 复用，
         本壳零业务逻辑零数据查询）。不进任务栏、不算主窗——主窗生命周期与 S-005 关窗分派
         不受影响（Hide 不 Close，OnLastWindowClose 不会误判退出）。
         宽 498 = 内容卡 438 + 两侧投影边距 30×2（协商失败回落态的投影留白；毛玻璃形态由
         code-behind 收缩到 438 贴合卡片，B6）；四周 Margin 是 BoxShadow 的渲染留白（不裁影），
         由 code-behind 按 ShadowMargins 常量设置（控制器锚定换算的单一来源）；投影色取令牌
         AppPopoverShadowColor（随明暗翻转，代码 Behind 按 ActualThemeVariant 取）。
         毛玻璃（B5/B6）：两平台同一套 AcrylicBlur 提示（macOS Avalonia.Native vibrancy / Windows
         WinRT backdrop，Win10 1803+ 与 Win11），协商成功 → 窗口贴合卡片 + 平台原生圆角
         （mac interop 裁 blur 视图 / Win11 DWM）；协商失败（系统透明效果关闭/RDP/旧 Win10）由
         code-behind 按 ActualTransparencyLevel 回落——卡片保持不透明默认，窗体仍透明承载投影。 -->
    <Border x:Name="ShadowHost" HorizontalAlignment="Stretch">
        <views:StatusPopoverView/>
    </Border>
</Window>
