<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- 自建发布形态（A4/A15）：单文件 + Dockerfile 多阶段构建（见 Dockerfile）。 -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tokenmetry.Relay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 自建网页（*PageEndpoints 读取）：随单文件发布嵌进程序集。 -->
    <None Remove="LeaderboardPage.html" />
    <EmbeddedResource Include="LeaderboardPage.html" />
    <None Remove="AdminPage.html" />
    <EmbeddedResource Include="AdminPage.html" />
    <!-- 页面脚本（RelayAssetEndpoints 读取）：CSP 只有 script-src 'self'，不允许内联脚本。 -->
    <None Remove="Assets/relay-common.js" />
    <EmbeddedResource Include="Assets/relay-common.js" />
    <None Remove="Assets/admin.js" />
    <EmbeddedResource Include="Assets/admin.js" />
    <None Remove="Assets/leaderboard.js" />
    <EmbeddedResource Include="Assets/leaderboard.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tokenmetry.Core\Tokenmetry.Core.csproj" />
  </ItemGroup>

</Project>
