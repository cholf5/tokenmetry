<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="CCUsage.App.App"
             RequestedThemeVariant="Default">
             <!-- 启动时 ThemeService 按设置里的 Theme（light / dark / system）改写 RequestedThemeVariant；
                  Default 表示跟随系统。 -->

    <Application.Styles>
        <!-- I-026：根主题 FluentTheme → SemiTheme（Locale 用中文，与界面文案一致）。
             DataGrid 样式由独立包提供，须与根主题一起引入。 -->
        <semi:SemiTheme Locale="zh-CN" />
        <semi:DataGridSemiTheme />
        <!-- I-027：共享样式（card/panel/kpi、page-title、link-btn、chip、mini 进度条）。
             须挂在 SemiTheme 之后，类选择器才能覆盖 Semi 的 ControlTheme。 -->
        <StyleInclude Source="avares://CCUsage.App/Styles/SharedStyles.axaml" />
    </Application.Styles>

    <!-- 明暗两套画刷，视图统一用 DynamicResource 引用，切换主题时自动换色。
         I-027：设计令牌层在 Styles/Tokens.axaml（App* 前缀，命名规范见 docs/design/design-tokens.md）。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CCUsage.App/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- I-026 的 10 组旧画刷（I-025 批次引入，6 个旧视图在用）按 I-027 命名规范属"遗留层"：
                 本卡不改名不删除（保证旧视图零改动可运行），语义映射如下，收敛合并留待 Q-002：
                 SecondaryTextBrush / MutedTextBrush → AppMutedTextBrush（原型 muted 变量）
                 CardBackgroundBrush                  → AppCardBackgroundBrush / AppPanelBrush
                 CardAccentBackgroundBrush            → AppPanelAltBrush（原型 panel2 变量）
                 SeparatorBorderBrush                 → AppLineBrush（原型 line 变量）
                 DangerTextBrush                      → AppAccentRedBrush
                 AccentLinkTextBrush                  → AppLinkBrush
                 WarningBanner*×3                     → 无原型对应，保留至 Q-002 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#888888"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#f8f9fa"/>
                    <SolidColorBrush x:Key="CardAccentBackgroundBrush" Color="#eef6ff"/>
                    <SolidColorBrush x:Key="SeparatorBorderBrush" Color="#dddddd"/>
                    <SolidColorBrush x:Key="WarningBannerBackgroundBrush" Color="#fff7e6"/>
                    <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="#ffd591"/>
                    <SolidColorBrush x:Key="WarningBannerTextBrush" Color="#8a5a00"/>
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#bb0000"/>
                    <SolidColorBrush x:Key="AccentLinkTextBrush" Color="#336699"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#a9afbb"/>
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8c929c"/>
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2a2e36"/>
                    <SolidColorBrush x:Key="CardAccentBackgroundBrush" Color="#223047"/>
                    <SolidColorBrush x:Key="SeparatorBorderBrush" Color="#3a404c"/>
                    <SolidColorBrush x:Key="WarningBannerBackgroundBrush" Color="#3b3320"/>
                    <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="#7a6530"/>
                    <SolidColorBrush x:Key="WarningBannerTextBrush" Color="#e5c878"/>
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#ff8080"/>
                    <SolidColorBrush x:Key="AccentLinkTextBrush" Color="#82b4e8"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
