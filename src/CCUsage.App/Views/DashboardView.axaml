<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CCUsage.App.ViewModels"
             xmlns:views="using:CCUsage.App.Views"
             x:Class="CCUsage.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Grid>
        <!-- 有数据时显示 Dashboard -->
        <Grid IsVisible="{Binding HasData}" RowDefinitions="Auto, Auto, Auto, Auto, *" Margin="20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0 0 0 20">
                <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="当前周期与历史累计" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1"
                    IsVisible="{Binding ShouldShowHistoricalOnlyHint}"
                    Background="{DynamicResource WarningBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource WarningBannerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0 0 0 20">
                <TextBlock Text="{Binding HistoricalOnlyHint}" Foreground="{DynamicResource WarningBannerTextBrush}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Grid.Row="2" Spacing="8" Margin="0 0 0 20">
                <TextBlock Text="当前周期" FontSize="16" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*, *, *, *">
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="今日成本" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TodayCostUsd, StringFormat=${0:F2}}" FontSize="24" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="本周成本" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding WeekCostUsd, StringFormat=${0:F2}}" FontSize="24" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="本月成本" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding MonthCostUsd, StringFormat=${0:F2}}" FontSize="24" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="今日 Tokens" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TodayTokens, StringFormat={}{0:N0}}" FontSize="24" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="8" Margin="0 0 0 20">
                <TextBlock Text="历史与最近数据" FontSize="16" FontWeight="Bold"/>
                <Grid ColumnDefinitions="*, *, *, *">
                    <Border Grid.Column="0" Background="{DynamicResource CardAccentBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="最近有数据日期" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding LatestDataDate}" FontSize="20" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardAccentBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="最近一天" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding LatestDayCostUsd, StringFormat=${0:F2}}" FontSize="20" FontWeight="Bold" Margin="0 5 0 0"/>
                            <TextBlock Text="{Binding LatestDayTokens, StringFormat={}{0:N0} tokens}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardAccentBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="历史累计成本" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding AllTimeCostUsd, StringFormat=${0:F2}}" FontSize="20" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource CardAccentBackgroundBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="历史累计 Tokens" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding AllTimeTokens, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Margin="0 5 0 0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding RefreshCommand}" Content="刷新数据" IsEnabled="{Binding !IsLoading}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding DebugInfo}" IsVisible="{Binding IsDebugInfoVisible}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- 无数据时显示空状态 -->
        <Grid IsVisible="{Binding !HasData}" Margin="20" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0">
                <Button Command="{Binding RefreshCommand}" Content="刷新数据" IsEnabled="{Binding !IsLoading}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock Text="{Binding DebugInfo}" IsVisible="{Binding IsDebugInfoVisible}" VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <views:EmptyStateView Grid.Row="1" DataContext="{Binding}"/>
        </Grid>
    </Grid>
</UserControl>
