<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CCUsage.App.ViewModels"
             x:Class="CCUsage.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!--
        S-002 数据源与设置页（原型 #page-settings）：页头 + 已识别的数据源表（真实扫描快照，
        全局重扫——采集管道不支持 per-source，按钮语义如实）+ 统计口径说明区（逐项定案，
        全部说明样式，不做假开关）+ 既有设置项迁入（主题三态 / 刷新间隔 / 通知 / 调试 /
        ccusage 命令 / 本地路径）。保存与重扫操作经 IToastService 反馈（I-027）。
    -->
    <ScrollViewer>
        <StackPanel Spacing="13" Margin="0,0,0,4">

            <!-- 页头（原型 .pagehead） -->
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
            </StackPanel>

            <!-- ═══ 已识别的数据源（widepanel）：行 = 采集扫描注册表快照，无手写清单 ═══ -->
            <Border Classes="panel">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <!-- panelhead：标题 + meta + 全局重扫（per-source 重扫不支持，语义见按钮文案） -->
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Classes="Secondary"
                                Content="{Binding ScanButtonText}"
                                Command="{Binding RescanCommand}"
                                IsEnabled="{Binding !IsScanning}"
                                VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Classes="page-subtitle"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding SourceMetaText}"/>
                        <TextBlock Classes="panel-title" Text="已识别的数据源" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 表头（原型 .table：数据源 / 状态 / 最近扫描 / 记录数；per-source 重扫列不设——
                         采集管道为单信号量串行全源扫描，逐行重扫按钮会是假能力） -->
                    <Grid Grid.Row="1" ColumnDefinitions="1.6*,1*,0.9*,0.9*" ColumnSpacing="8" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Classes="table-th" Text="数据源"/>
                        <TextBlock Grid.Column="1" Classes="table-th" Text="状态"/>
                        <TextBlock Grid.Column="2" Classes="table-th" Text="最近扫描"/>
                        <TextBlock Grid.Column="3" Classes="table-th" Text="记录数" TextAlignment="Right"/>
                    </Grid>

                    <!-- 数据源行（整表随快照重建；状态着色经 status-* 类条件绑定） -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding SourceRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DataSourceRowViewModel">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="1.6*,1*,0.9*,0.9*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Classes="table-td" FontWeight="SemiBold"
                                                   Text="{Binding Agent}" VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1" Classes="table-td"
                                                   Classes.status-ok="{Binding IsOk}"
                                                   Classes.status-partial="{Binding IsPartial}"
                                                   Classes.status-nodata="{Binding IsNoData}"
                                                   Classes.status-pending="{Binding IsPending}"
                                                   Text="{Binding StatusText}"/>
                                        <TextBlock Grid.Column="2" Classes="table-td"
                                                   Text="{Binding LastScanText}"/>
                                        <TextBlock Grid.Column="3" Classes="table-num"
                                                   Text="{Binding RecordCountText}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ═══ 统计口径：逐项定案为说明样式（S-002 Dev Log），不做假开关 ═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panel-title" Text="统计口径"/>
                    <ItemsControl ItemsSource="{Binding CaliberRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CaliberItem">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="1.6*,1.8*" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                            <Border Classes="chip" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Badge}"/>
                                            </Border>
                                            <TextBlock Classes="table-td" FontWeight="SemiBold"
                                                       Text="{Binding Text}" TextWrapping="Wrap"
                                                       VerticalAlignment="Top"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Classes="page-subtitle"
                                                   Text="{Binding Note}" TextWrapping="Wrap"
                                                   VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ 外观与通用（既有设置项迁入新信息架构；主题三态即时预览 + 保存持久化）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Classes="panel-title" Text="外观与通用"/>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="主题"/>
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                  Width="220" HorizontalAlignment="Left"
                                  HorizontalContentAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeOption">
                                    <TextBlock Text="{Binding Label}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="切换后立即预览；选择「保存设置」持久化（重启后保持）。"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="刷新间隔（分钟）"/>
                        <TextBox Text="{Binding RefreshMinutesText}" PlaceholderText="15" Width="220"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="保存后于下次启动后台刷新服务时生效。"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="page-subtitle" Text="ccusage CLI（对账 / 手动导入）"/>
                        <TextBox Text="{Binding CcusageCommand}" PlaceholderText="ccusage" Width="320"
                                 HorizontalAlignment="Left"/>
                        <TextBlock Classes="page-subtitle" TextWrapping="Wrap"
                                   Text="应用默认直读本地会话日志，无需安装 ccusage；此命令仅对账 / 手动导入时使用，保存后下次启动生效。"/>
                    </StackPanel>

                    <CheckBox Content="启用异常通知" IsChecked="{Binding AnomalyNotificationsEnabled}"/>
                    <CheckBox Content="显示调试信息" IsChecked="{Binding ShowDebugInfo}"/>
                </StackPanel>
            </Border>

            <!-- ═══ 本地路径（只读说明）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock Classes="panel-title" Text="本地路径"/>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="page-subtitle" Text="缓存数据库"/>
                        <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding CacheDbPath}" TextWrapping="Wrap"/>
                    </Grid>
                    <Grid ColumnDefinitions="90,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Classes="page-subtitle" Text="设置文件"/>
                        <TextBlock Grid.Column="1" Classes="table-td" Text="{Binding SettingsFilePath}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 保存（成功 / 失败经 toast 反馈；Status 保留既有测试对账语义） -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="Primary" Content="保存设置"
                        Command="{Binding SaveCommand}" IsEnabled="{Binding !IsSaving}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Classes="page-subtitle"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
