<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CCUsage.App.ViewModels"
             xmlns:c="using:CCUsage.App.Controls"
             xmlns:loc="using:CCUsage.App.Localization"
             mc:Ignorable="d"
             x:Class="CCUsage.App.Views.AgentsView"
             x:DataType="vm:AgentsViewModel">

    <!--
        D-009 Agent 统计页（原型 #page-agents）：页头 + Top4 Agent KPI 卡（icon-chip + Agent 名 +
        紧凑 token 主值 + "N 会话 · 成本"脚注，未知成本四态）+ Agent 排行面板（七列：Agent / 会话数 /
        输入 / 输出 / 总 Token / 估算成本 / 占比；系列圆点对齐原型 .modeldot）。
        行点击 → 会话页带该 Agent 全局筛选（AgentsViewModel 定案：写顶部栏单选 Agent）。
        排行表 = ListBox 虚拟化（共享 data-table 行配方，Q-002 收编）+ 行顶分隔线（table-th/td/num 令牌）。
        Q-002：页面根补 ScrollViewer（同时间/成本/设置页模式）——最小窗口高度下排行面板不再被裁剪。
    -->
    <ScrollViewer>
        <StackPanel Spacing="13" Margin="0,0,0,4">

        <!-- 页头（原型 .pagehead：比较不同工具的使用强度、成本与会话规模） -->
        <StackPanel Spacing="4">
            <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
            <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
        </StackPanel>

        <!-- 加载失败（诚实错误态；筛选再变化自动重试） -->
        <Border Classes="panel" Padding="13" IsVisible="{Binding HasLoadError}">
            <TextBlock Classes="page-subtitle" Text="{Binding LoadError}"/>
        </Border>

        <!-- ═══ Top4 Agent KPI 卡（原型 #agentKpis：.kpis 四列网格；不足 4 个 Agent 的槽位隐藏）═══ -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

            <Border Grid.Column="0" Classes="kpi"
                    IsVisible="{Binding Kpi1, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel x:DataType="vm:AgentKpiCardViewModel" DataContext="{Binding Kpi1}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip" c:AgentChip.Variant="{Binding ChipVariant}">
                            <TextBlock Text="{Binding Glyph}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding TokensText}"/>
                    <TextBlock Classes="kpi-foot" Text="{Binding FootText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="kpi"
                    IsVisible="{Binding Kpi2, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel x:DataType="vm:AgentKpiCardViewModel" DataContext="{Binding Kpi2}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip" c:AgentChip.Variant="{Binding ChipVariant}">
                            <TextBlock Text="{Binding Glyph}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding TokensText}"/>
                    <TextBlock Classes="kpi-foot" Text="{Binding FootText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Classes="kpi"
                    IsVisible="{Binding Kpi3, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel x:DataType="vm:AgentKpiCardViewModel" DataContext="{Binding Kpi3}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip" c:AgentChip.Variant="{Binding ChipVariant}">
                            <TextBlock Text="{Binding Glyph}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding TokensText}"/>
                    <TextBlock Classes="kpi-foot" Text="{Binding FootText}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Classes="kpi"
                    IsVisible="{Binding Kpi4, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel x:DataType="vm:AgentKpiCardViewModel" DataContext="{Binding Kpi4}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border Classes="icon-chip" c:AgentChip.Variant="{Binding ChipVariant}">
                            <TextBlock Text="{Binding Glyph}"/>
                        </Border>
                        <TextBlock Classes="kpi-top" Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Classes="kpi-value" Text="{Binding TokensText}"/>
                    <TextBlock Classes="kpi-foot" Text="{Binding FootText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Agent 排行面板（原型 .panel + .panelhead meta「可点击查看对应会话」）═══ -->
        <Border Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Right" Classes="kpi-foot" Text="{Binding MetaClickableForSessions, Source={x:Static loc:Translations.Instance}}"
                               VerticalAlignment="Center"/>
                    <TextBlock Classes="panel-title" Text="{Binding PanelAgentRanking, Source={x:Static loc:Translations.Instance}}" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- 表头（列宽与行模板一致；数字列定宽右对齐，Agent 列星宽截断） -->
                <Grid Grid.Row="1" ColumnDefinitions="1.5*,52,56,56,56,64,44" ColumnSpacing="6" Margin="0,0,0,2">
                    <TextBlock Grid.Column="0" Classes="table-th" Text="{Binding TopbarAgent, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="1" Classes="table-th" TextAlignment="Right" Text="{Binding ThSessionCount, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="2" Classes="table-th" TextAlignment="Right" Text="{Binding ThInputTokens, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="3" Classes="table-th" TextAlignment="Right" Text="{Binding ThOutputTokens, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="4" Classes="table-th" TextAlignment="Right" Text="{Binding ThTotalTokens, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="5" Classes="table-th" TextAlignment="Right" Text="{Binding KpiEstimatedCost, Source={x:Static loc:Translations.Instance}}"/>
                    <TextBlock Grid.Column="6" Classes="table-th" TextAlignment="Right" Text="{Binding ThShare, Source={x:Static loc:Translations.Instance}}"/>
                </Grid>

                <!-- 排行行（ListBox 虚拟化；SelectedAgent = 行点击跳会话页带该 Agent 筛选） -->
                <ListBox Grid.Row="2"
                         Classes="data-table"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedAgent, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AgentRankRowViewModel">
                            <Border BorderBrush="{DynamicResource AppLineBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,8,0,2">
                                <Grid ColumnDefinitions="1.5*,52,56,56,56,64,44" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7"
                                                VerticalAlignment="Center">
                                        <Border Classes="series-dot" Background="{Binding DotBrush}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Classes="table-td" Text="{Binding Name}"
                                                   ToolTip.Tip="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Classes="table-num" Text="{Binding SessionCountText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Classes="table-num" Text="{Binding InputTokensText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Classes="table-num" Text="{Binding OutputTokensText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Classes="table-num" Text="{Binding TotalTokensText}"
                                               VerticalAlignment="Center"/>
                                    <!-- 估算成本四态：未知成本呈「未知」，绝不折 0 -->
                                    <TextBlock Grid.Column="5" Classes="table-num" Text="{Binding CostText}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Classes="table-num" Text="{Binding ShareText}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态（无行且无错误；错误态下隐藏避免矛盾三重态） -->
                <TextBlock Grid.Row="2" Classes="table-empty" Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}"
                           IsVisible="{Binding ShowEmptyState}"
                           VerticalAlignment="Top"/>
            </Grid>
        </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
