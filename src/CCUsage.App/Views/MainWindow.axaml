<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CCUsage.App.ViewModels"
        xmlns:views="using:CCUsage.App.Views"
        xmlns:svc="using:CCUsage.App.Services"
        mc:Ignorable="d"
        x:Class="CCUsage.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">

    <!--
        D-003 三栏应用外壳（原型 .app/.topbar/.shell/.sidebar/.sessions-panel）：
        顶部栏 = 全局筛选（时间范围 + Agent）+ 数据状态 + 设置入口；
        左侧栏 = 品牌 + 8 项导航；中间 = 页面路由（ContentControl + DataTemplates）；
        右侧栏 = 最近会话 + 快速筛选骨架（真实数据接线在 D-008）。
        窗口 chrome 沿用系统边框（2026-10-12 卡内决策，不复刻原型 mac 红绿灯）。
        最小尺寸 960×640：184 + ≥420 主内容 + 276 三栏不破（原型 .shell 最小列宽同源）。
    -->

    <Window.Styles>
        <!-- 侧栏导航列表（原型 .nav）：透明底、条目 8px 圆角、悬停/选中走 D-003 外壳令牌 -->
        <Style Selector="ListBox.nav-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppNavHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppNavActiveBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppNavActiveForegroundBrush}"/>
        </Style>
        <!-- 选中指示条（原型 .nav button.active 的 inset 2px）：条目模板内常驻 2px 占位，
             仅选中态着色（颜色走 AppNavActiveIndicatorBrush），图标不因选中而位移 -->
        <Style Selector="ListBox.nav-list ListBoxItem Border.nav-indicator">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav-list ListBoxItem:selected Border.nav-indicator">
            <Setter Property="Background" Value="{DynamicResource AppNavActiveIndicatorBrush}"/>
        </Style>

        <!-- 顶部栏图标按钮（原型 .iconbtn） -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- 顶部栏筛选标签（.select 语义的静态说明文字） -->
        <Style Selector="TextBlock.topbar-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <!-- D-003 页面路由：CurrentPage（页面 VM）→ 视图。未落地页面共用 PagePlaceholderView；
         [I-027] StylePreviewView 临时页自本卡起没有导航入口（明暗截图留档与 headless 用例仍直接
         实例化该视图，重生成命令见 I-027/D-003 卡 Verification），Q-002 清理时随旧视图一并处置。 -->
    <Window.DataTemplates>
        <DataTemplate DataType="vm:PagePlaceholderViewModel">
            <views:PagePlaceholderView/>
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid RowDefinitions="52,*">
        <!-- ═══ 顶部栏（.topbar：52px，底边 1px 描边）═══ -->
        <Border Grid.Row="0"
                x:Name="TopBar"
                Background="{DynamicResource AppTopbarBackgroundBrush}"
                BorderBrush="{DynamicResource AppLineBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="18,0" VerticalAlignment="Center">
                <!-- 全局时间范围（7/30/90/全部，默认 7 天，写入 FilterStateService） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="topbar-label" Text="时间范围"/>
                    <ComboBox MinWidth="124"
                              ItemsSource="{Binding Filters.TimeRangeOptions}"
                              SelectedItem="{Binding Filters.TimeRange, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:TimeRangeOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- 全局 Agent 筛选（占位清单，D-008 接真数据） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0">
                    <TextBlock Classes="topbar-label" Text="Agent"/>
                    <ComboBox MinWidth="140"
                              ItemsSource="{Binding Filters.AgentOptions}"
                              SelectedItem="{Binding Filters.Agent, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:AgentOption">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <!-- 数据状态（轻量实现：就绪 + 最近刷新时间；真实状态接线 TODO 见 MainWindowViewModel） -->
                <Border Grid.Column="3"
                        Background="{DynamicResource AppPanelAltBrush}"
                        BorderBrush="{DynamicResource AppLineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="11,7"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="7" Height="7"
                                 Fill="{DynamicResource AppAccentGreenBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DataStatusText}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
                <!-- 设置入口（导航到数据源与设置页） -->
                <Button Grid.Column="4"
                        Classes="icon-btn"
                        Content="⚙"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip.Tip="数据源与设置"/>
            </Grid>
        </Border>

        <!-- ═══ 三栏（.shell：184 / * / 276）═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="184,*,276">

            <!-- 左侧导航（.sidebar） -->
            <Border Grid.Column="0"
                    x:Name="Sidebar"
                    Width="184"
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource AppLineBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="10,0">
                    <!-- 品牌（logo/标题；原型 .brandmark + .brand） -->
                    <StackPanel DockPanel.Dock="Top" Margin="8,18,8,16" Orientation="Horizontal" Spacing="9">
                        <Border Width="24" Height="24" CornerRadius="12"
                                BorderBrush="{DynamicResource AppLinkBrush}"
                                BorderThickness="2">
                            <TextBlock Text="◌"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppLinkBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="ccusage"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="ANALYTICS"
                                       FontSize="9"
                                       Foreground="{DynamicResource AppMutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 8 项导航（ListBox：条目可聚焦、方向键可移动选中，满足键盘可达） -->
                    <ListBox x:Name="NavList"
                             Classes="nav-list"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Classes="nav-indicator"
                                            Width="2" Height="16"
                                            CornerRadius="1"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Page.Icon}"
                                               FontSize="15"
                                               Width="17"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Page.Label}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 主内容区（页面路由；未落地页面为 PagePlaceholderView 占位） -->
            <ContentControl Grid.Column="1"
                            x:Name="PageHost"
                            Margin="22,22,22,30"
                            Content="{Binding CurrentPage}"/>

            <!-- 右侧最近会话栏（.sessions-panel，骨架） -->
            <Border Grid.Column="2"
                    x:Name="SessionsPanelBorder"
                    Width="276"
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource AppLineBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto" Margin="13,18">
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right"
                                Classes="link-btn"
                                Content="查看全部 ↗"
                                Command="{Binding GoToPageCommand}"
                                CommandParameter="{x:Static vm:PageId.Sessions}"/>
                        <TextBlock Classes="panel-title" FontSize="14" Text="最近会话"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1"
                                x:DataType="vm:SessionsPanelViewModel"
                                DataContext="{Binding SessionsPanel}"
                                Margin="0,10,0,0">
                        <!-- 列表骨架 + 诚实空态（真实数据接线在 D-008） -->
                        <StackPanel Margin="0,18,0,0" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="暂无最近会话"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="会话列表将在会话明细页（D-008）接入真实数据"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                x:DataType="vm:SessionsPanelViewModel"
                                DataContext="{Binding SessionsPanel}"
                                Margin="0,16,0,0">
                        <!-- 快速筛选骨架（原型 .filterbox） -->
                        <Border Background="{DynamicResource AppPanelBrush}"
                                BorderBrush="{DynamicResource AppLineBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="13">
                            <StackPanel Spacing="10">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Classes="link-btn"
                                            Content="清除"
                                            Command="{Binding ClearQuickFiltersCommand}"/>
                                    <TextBlock Classes="panel-title" Text="快速筛选"/>
                                </DockPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Agent" FontSize="11"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <ItemsControl ItemsSource="{Binding AgentFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AgentQuickFilterViewModel">
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="模型" FontSize="11"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <ComboBox Width="210"
                                              HorizontalAlignment="Left"
                                              HorizontalContentAlignment="Stretch"
                                              ItemsSource="{Binding ModelFilterOptions}"
                                              SelectedItem="{Binding ModelFilter, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="项目 / 目录" FontSize="11"
                                               Foreground="{DynamicResource AppMutedTextBrush}"/>
                                    <ComboBox Width="210"
                                              HorizontalAlignment="Left"
                                              HorizontalContentAlignment="Stretch"
                                              ItemsSource="{Binding ProjectFilterOptions}"
                                              SelectedItem="{Binding ProjectFilter, Mode=TwoWay}"/>
                                </StackPanel>
                                <Button Classes="Primary"
                                        Content="应用筛选"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding ApplyQuickFiltersCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
