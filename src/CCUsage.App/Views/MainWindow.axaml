<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CCUsage.App.ViewModels"
        xmlns:views="using:CCUsage.App.Views"
        mc:Ignorable="d"
        x:Class="CCUsage.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="800" Height="600">
    <Grid RowDefinitions="Auto, *">
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Dashboard">
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </TabItem>
            <TabItem Header="Settings">
                <TextBlock Text="Settings page coming soon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
