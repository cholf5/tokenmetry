<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CCUsage.App.ViewModels"
        xmlns:views="using:CCUsage.App.Views"
        mc:Ignorable="d"
        x:Class="CCUsage.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="800" Height="600">
    <Grid RowDefinitions="Auto, *">
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Dashboard">
                <views:DashboardView DataContext="{Binding Dashboard}"/>
            </TabItem>
            <TabItem Header="Reports">
                <views:ReportsView DataContext="{Binding Reports}"/>
            </TabItem>
            <TabItem Header="Model Breakdown">
                <views:ModelBreakdownView DataContext="{Binding ModelBreakdown}"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
            <!-- [SPIKE D-002] ScottPlot.Avalonia 集成 spike 临时页，v0.4 正式集成时移除 -->
            <TabItem Header="Trend Spike (D-002)">
                <views:TrendSpikeView/>
            </TabItem>
            <!-- [I-027] 设计令牌与共享样式预览临时页，v0.4 页面卡（D-006~D-013）落地时移除 -->
            <TabItem Header="Style Preview (I-027)">
                <views:StylePreviewView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
