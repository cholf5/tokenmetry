<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CCUsage.App.ViewModels"
             x:Class="CCUsage.App.Views.PagePlaceholderView"
             x:DataType="vm:PagePlaceholderViewModel">
    <!--
        D-003 占位页：页面卡（D-006~D-013 / S-002）落地前的统一占位。
        只用 I-027 共享样式类与令牌（page-title / panel / chip / series-dot），
        展示页面规划内容与落地卡号 + 当前全局筛选值，不含示例数据。
    -->
    <StackPanel Spacing="18">
        <StackPanel Spacing="4">
            <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
            <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
        </StackPanel>

        <Border Classes="panel" MaxWidth="760" HorizontalAlignment="Left" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip"><TextBlock Text="占位视图"/></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding Page.CardRef, StringFormat='由 {0} 落地'}"/></Border>
                    <Border Classes="chip"><TextBlock Text="{Binding CurrentFilterDisplay, StringFormat='当前筛选：{0}'}"/></Border>
                </StackPanel>

                <TextBlock Classes="panel-title" Text="该页将包含"/>
                <ItemsControl ItemsSource="{Binding Page.PlannedSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,3">
                                <Border Classes="series-dot"
                                        Background="{DynamicResource AppSeries0Brush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="page-subtitle"
                           Text="页面内容由对应任务卡实现；此处不放置示例数据。"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
