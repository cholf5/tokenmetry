<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CCUsage.App.ViewModels"
             mc:Ignorable="d"
             x:Class="CCUsage.App.Views.CostAnalysisView"
             x:DataType="vm:CostViewModel">

    <!--
        D-013 成本分析页（原型 #page-cost）：页头 + KPI 四卡（估算总成本四态 / 输入占比 / 输出占比 /
        待确认价格）+ 「成本计算口径」静态三行说明表（实际计费优先 · 价格表估算 · 未知不折零）。
        输入/输出占比为 Token 构成口径（决策点方案 b），KPI 脚注显式标注——不做无标签的隐式近似；
        待确认价格为定价引擎全局口径，脚注说明不随筛选变化。
    -->
    <ScrollViewer>
        <StackPanel Spacing="13" Margin="0,0,0,4">

            <!-- 页头（原型 .pagehead：区分真实计费、模型价格估算与无法估价的数据） -->
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{Binding Page.Title}"/>
                <TextBlock Classes="page-subtitle" Text="{Binding Page.Subtitle}"/>
            </StackPanel>

            <!-- 加载失败（诚实错误态；已加载 KPI 保留，筛选再变化自动重试） -->
            <Border Classes="panel" Padding="13" IsVisible="{Binding HasLoadError}">
                <TextBlock Classes="page-subtitle" Text="{Binding LoadError}"/>
            </Border>

            <!-- ═══ .kpis：四张 KPI 卡（icon-chip 色序对齐原型 .kpi-icon nth-child）═══ -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">

                <!-- 1. 估算总成本（AggregatedCost 四态：未知 / $x.xx+ / $x.xx / —，未知绝不折 0） -->
                <Border Grid.Column="0" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipAmberBackgroundBrush}">
                                <TextBlock Text="$"
                                           Foreground="{DynamicResource AppIconChipAmberForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="估算总成本" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding TotalCostText}"/>
                        <TextBlock Classes="kpi-foot" Text="已知成本合计 · 未知不计入总额" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. 输入成本占比（Token 构成口径显式标注——决策点方案 b，不做隐式近似） -->
                <Border Grid.Column="1" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipBlueBackgroundBrush}">
                                <TextBlock Text="↓"
                                           Foreground="{DynamicResource AppIconChipBlueForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="输入成本占比" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding InputShareText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="按 Token 构成展示 · 成本按方向拆价口径待扩展（缓存单列）"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. 输出成本占比（同上口径；原型 meta「输出单价通常更高」为定价常识，非本页数据） -->
                <Border Grid.Column="2" Classes="kpi">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipPurpleBackgroundBrush}">
                                <TextBlock Text="↑"
                                           Foreground="{DynamicResource AppIconChipPurpleForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="输出成本占比" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding OutputShareText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="按 Token 构成展示 · 成本按方向拆价口径待扩展（缓存单列）"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4. 待确认价格（PricingEngine.GetUnpricedModels 全局口径——不随时间范围/Agent 筛选变化） -->
                <Border Grid.Column="3" Classes="kpi"
                        ToolTip.Tip="{Binding UnpricedModelsTooltip}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Border Classes="icon-chip"
                                    Background="{DynamicResource AppIconChipGreenBackgroundBrush}">
                                <TextBlock Text="?"
                                           Foreground="{DynamicResource AppIconChipGreenForegroundBrush}"/>
                            </Border>
                            <TextBlock Classes="kpi-top" Text="待确认价格" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Classes="kpi-value" Text="{Binding UnpricedCountText}"/>
                        <TextBlock Classes="kpi-foot"
                                   Text="缺价模型数 · 成本不应默认为零 · 全局口径（自启动累计），不随筛选变化"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 未知成本说明行（估算总成本含未知贡献时可见；D-010 口径的页面级说明） -->
            <TextBlock Classes="page-subtitle" Text="{Binding UnknownCostNoteText}"
                       IsVisible="{Binding HasUnknownCostNote}"
                       TextWrapping="Wrap"/>

            <!-- ═══ 成本计算口径（静态三行说明表，原型同款；内容与 docs/reconciliation 口径对齐）═══ -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panel-title" Text="成本计算口径"/>
                    <Grid ColumnDefinitions="1.1*,1.3*,2.2*" ColumnSpacing="10" Margin="0,0,0,2">
                        <TextBlock Grid.Column="0" Classes="table-th" Text="项目"/>
                        <TextBlock Grid.Column="1" Classes="table-th" Text="建议展示"/>
                        <TextBlock Grid.Column="2" Classes="table-th" Text="注意事项"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CostBasisRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CostBasisRowViewModel">
                                <Border BorderBrush="{DynamicResource AppLineBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,9,0,7">
                                    <Grid ColumnDefinitions="1.1*,1.3*,2.2*" ColumnSpacing="10">
                                        <TextBlock Grid.Column="0" Classes="table-td" FontWeight="SemiBold"
                                                   Text="{Binding Item}" VerticalAlignment="Top"/>
                                        <Border Grid.Column="1" Classes="chip" HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Stance}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Classes="table-td"
                                                   Text="{Binding Note}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
