<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CCUsage.App.ViewModels"
             xmlns:sp="using:ScottPlot.Avalonia"
             mc:Ignorable="d"
             x:Class="CCUsage.App.Views.TrendSpikeView"
             x:DataType="vm:TrendSpikeViewModel">
    <!-- [SPIKE D-002] 临时验证页：ScottPlot.Avalonia 5.1.59 集成 spike，正式集成时删除或替换。
         I-026：本页追加 Semi DataGrid 最小演示（复用同一份 30 天数据），同样随本页一起删除。 -->
    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="[SPIKE] 30 天成本趋势（ScottPlot 原型）" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="D-002 临时页，非正式功能" Foreground="{DynamicResource DangerTextBrush}" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="{Binding DataRangeText}" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <sp:AvaPlot Grid.Row="1" x:Name="TrendPlot"
                    PointerMoved="OnPlotPointerMoved"
                    PointerExited="OnPlotPointerExited"/>

        <!-- [SPIKE I-026] Semi 下 DataGrid 样式验证：绑定本页已有 Points（TrendSpikePoint），最小列配置。 -->
        <StackPanel Grid.Row="2" Spacing="4" Margin="0 8 0 0">
            <TextBlock Text="[SPIKE] Semi DataGrid 演示（I-026）" FontWeight="Bold"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <DataGrid ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      MaxHeight="160">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                    <DataGridTextColumn Header="成本 USD" Binding="{Binding CostUsd, StringFormat='{}{0:F2}'}"/>
                    <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat='{}{0:N0}'}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0 8 0 0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock x:Name="HoverText" Text="悬停查看数值" Foreground="{DynamicResource AccentLinkTextBrush}" FontWeight="Bold"/>
            <TextBlock Text="左键拖动平移 · 右键拖动/滚轮缩放 · 双击复位" Foreground="{DynamicResource MutedTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
