<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CCUsage.App.ViewModels"
             xmlns:sp="using:ScottPlot.Avalonia"
             mc:Ignorable="d"
             x:Class="CCUsage.App.Views.TrendSpikeView"
             x:DataType="vm:TrendSpikeViewModel">
    <!-- [SPIKE D-002] 临时验证页：ScottPlot.Avalonia 5.1.59 集成 spike，正式集成时删除或替换 -->
    <Grid RowDefinitions="Auto, *, Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0 0 0 8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="[SPIKE] 30 天成本趋势（ScottPlot 原型）" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="D-002 临时页，非正式功能" Foreground="#b00" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <TextBlock Text="{Binding DataRangeText}" Foreground="#666"/>
        </StackPanel>

        <sp:AvaPlot Grid.Row="1" x:Name="TrendPlot"
                    PointerMoved="OnPlotPointerMoved"
                    PointerExited="OnPlotPointerExited"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0 8 0 0">
            <TextBlock Text="{Binding Status}" Foreground="#888"/>
            <TextBlock x:Name="HoverText" Text="悬停查看数值" Foreground="#369" FontWeight="Bold"/>
            <TextBlock Text="左键拖动平移 · 右键拖动/滚轮缩放 · 双击复位" Foreground="#999"/>
        </StackPanel>
    </Grid>
</UserControl>
