<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:loc="using:TokenPulse.App.Localization"
             mc:Ignorable="d"
             x:Class="TokenPulse.App.Controls.Heatmap">
    <!-- D-005 活跃日历热力图：格子 UniformGrid 排布（列数可配），强度着色与悬停 tooltip 在
         code-behind 构建；空数据呈占位文案 + 无数据格底色（令牌），悬停 ToolTip 显示当日数值。 -->
    <Panel>
        <UniformGrid x:Name="CellsGrid" Columns="7"/>
        <TextBlock x:Name="EmptyText"
                   Text="{Binding NoData, Source={x:Static loc:Translations.Instance}}"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   IsVisible="False"/>
    </Panel>
</UserControl>
